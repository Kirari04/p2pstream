# Release CI supplies the exact server platform digest. The
# management image remains free of the Docker CLI and daemon socket.
ARG P2PSTREAM_IMAGE
FROM docker:29.9.2-cli@sha256:5e6baf67325a79f64ed3bed6863954d5e05d0f3d4e57cbdb14809346814bbfdb AS tools
FROM ${P2PSTREAM_IMAGE}
LABEL p2pstream.image.role="server-updater"
USER root
COPY --from=tools /usr/local/bin/docker /usr/local/bin/docker
COPY --from=tools /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
ENTRYPOINT []
CMD ["/app/p2pstream", "server-updater", "serve"]
