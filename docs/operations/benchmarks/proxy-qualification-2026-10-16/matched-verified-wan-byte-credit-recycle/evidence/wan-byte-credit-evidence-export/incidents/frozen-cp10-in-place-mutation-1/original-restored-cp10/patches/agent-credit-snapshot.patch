+func TestExternalQualificationWANSenderWaitTerminalFailureSticky(t *testing.T) {
+	bearer := strings.Repeat("a1", 32)
+	owner, err := newExternalQualificationWANSenderWaitOwner("1", bearer, externalQualificationWANSenderWaitSequences)
+	if err != nil || owner == nil {
+		t.Fatalf("create owner: owner=%v err=%v", owner, err)
+	}
+	for _, sequence := range externalQualificationWANSenderWaitSequenceOrder {
+		externalQualificationWANSenderWaitTestTransition(t, owner, sequence, "pre", true)
+		externalQualificationWANSenderWaitTestTransition(t, owner, sequence, "post", true)
+	}
+	failed := externalQualificationWANSenderWaitTestRequest(owner, bearer, "15")
+	if failed.Code != http.StatusServiceUnavailable {
+		t.Fatalf("failed terminal status=%d, want %d", failed.Code, http.StatusServiceUnavailable)
+	}
+	var payload externalQualificationWANSenderWaitFailureResponse
+	if err := json.NewDecoder(failed.Body).Decode(&payload); err != nil {
+		t.Fatalf("decode failed terminal response: %v", err)
+	}
+	if payload.Accepted || !payload.Invalid || payload.Error == "" {
+		t.Fatalf("failed terminal payload=%+v", payload)
+	}
+	if owner.state["15"] != "invalid" || owner.terminalConsumed {
+		t.Fatalf("failed terminal state=%q consumed=%v", owner.state["15"], owner.terminalConsumed)
+	}
+	if got := externalQualificationWANSenderWaitTestRequest(owner, bearer, "15"); got.Code != http.StatusConflict {
+		t.Fatalf("failed terminal retry status=%d, want %d", got.Code, http.StatusConflict)
+	}
