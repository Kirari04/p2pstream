+func TestExternalQualificationWANSenderWaitControl(t *testing.T) {
+	bearer := strings.Repeat("a1", 32)
+	owner, err := newExternalQualificationWANSenderWaitOwner("1", bearer, externalQualificationWANSenderWaitSequences)
+	if err != nil || owner == nil {
+		t.Fatalf("create owner: owner=%v err=%v", owner, err)
+	}
+	for name, authorization := range map[string]string{
+		"missing": "", "raw": bearer, "wrong": "Bearer " + strings.Repeat("b2", 32),
+	} {
+		t.Run(name, func(t *testing.T) {
+			request := httptest.NewRequest(http.MethodGet, "/?wan_sender_wait_snapshot=drain&sequence=9", nil)
+			request.Header.Set("Authorization", authorization)
+			recorder := httptest.NewRecorder()
+			owner.serveDrainHTTP(recorder, request, newExternalQualificationSessionRegistry(5))
+			if recorder.Code != http.StatusUnauthorized {
+				t.Fatalf("status=%d, want %d", recorder.Code, http.StatusUnauthorized)
+			}
+		})
+	}
+	request := httptest.NewRequest(http.MethodGet, "/?wan_sender_wait_snapshot=drain&sequence=9", nil)
+	request.Header.Set("Authorization", "Bearer "+bearer)
+	recorder := httptest.NewRecorder()
+	extra := httptest.NewRequest(http.MethodGet, "/?wan_sender_wait_snapshot=drain&sequence=9&extra=1", nil)
+	extra.Header.Set("Authorization", "Bearer "+bearer)
+	extraRecorder := httptest.NewRecorder()
+	owner.serveDrainHTTP(extraRecorder, extra, newExternalQualificationSessionRegistry(5))
+	if extraRecorder.Code != http.StatusBadRequest {
+		t.Fatalf("extra query status=%d, want %d", extraRecorder.Code, http.StatusBadRequest)
+	}
+	outOfOrder := httptest.NewRequest(http.MethodGet, "/?wan_sender_wait_snapshot=drain&sequence=11", nil)
+	outOfOrder.Header.Set("Authorization", "Bearer "+bearer)
+	outOfOrderRecorder := httptest.NewRecorder()
+	owner.serveDrainHTTP(outOfOrderRecorder, outOfOrder, newExternalQualificationSessionRegistry(5))
+	if outOfOrderRecorder.Code != http.StatusConflict {
+		t.Fatalf("out-of-order status=%d, want %d", outOfOrderRecorder.Code, http.StatusConflict)
+	}
+	owner.serveDrainHTTP(recorder, request, newExternalQualificationSessionRegistry(5))
+	if recorder.Code != http.StatusServiceUnavailable {
+		t.Fatalf("empty session set status=%d, want %d", recorder.Code, http.StatusServiceUnavailable)
+	}
+	var failure externalQualificationWANSenderWaitFailureResponse
+	if err := json.NewDecoder(recorder.Body).Decode(&failure); err != nil {
+		t.Fatalf("decode bounded failure response: %v", err)
+	}
+	if failure.SchemaVersion != 1 || failure.Accepted || !failure.Invalid || failure.Error == "" || failure.Snapshot != nil {
+		t.Fatalf("failure response = %+v", failure)
+	}
+	retryRecorder := httptest.NewRecorder()
+	owner.serveDrainHTTP(retryRecorder, request, newExternalQualificationSessionRegistry(5))
+	if retryRecorder.Code != http.StatusConflict {
+		t.Fatalf("retry status=%d, want %d", retryRecorder.Code, http.StatusConflict)
+	}
+	for _, invalid := range [][3]string{
+		{"", bearer, externalQualificationWANSenderWaitSequences},
+		{"1", strings.Repeat("A1", 32), externalQualificationWANSenderWaitSequences},
+		{"1", bearer, "9,11,13"},
+	} {
+		if got, err := newExternalQualificationWANSenderWaitOwner(invalid[0], invalid[1], invalid[2]); err == nil || got != nil {
+			t.Fatalf("invalid configuration accepted: %#v", invalid)
+		}
+	}
+}
