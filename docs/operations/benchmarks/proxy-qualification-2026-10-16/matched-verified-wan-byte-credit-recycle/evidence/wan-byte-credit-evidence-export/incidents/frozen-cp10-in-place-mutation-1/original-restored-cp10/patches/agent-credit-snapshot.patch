+func (owner *externalQualificationWANSenderWaitOwner) serveDrainHTTP(w http.ResponseWriter, r *http.Request, sessions *externalQualificationSessionRegistry) {
+	if !owner.authorized(r) {
+		http.Error(w, "WAN sender-wait authorization failed", http.StatusUnauthorized)
+		return
+	}
+	query := r.URL.Query()
+	if r.Method != http.MethodGet || len(query) != 2 || len(query["wan_sender_wait_snapshot"]) != 1 ||
+		len(query["sequence"]) != 1 || query["wan_sender_wait_snapshot"][0] != "drain" {
+		http.Error(w, "invalid WAN sender-wait action", http.StatusBadRequest)
+		return
+	}
+	sequence := query["sequence"][0]
+	if _, configured := owner.sequences[sequence]; !configured {
+		http.Error(w, "WAN sender-wait sequence is unavailable", http.StatusConflict)
+		return
+	}
+	encoded, err := owner.drain(sequence, sessions)
+	if err != nil {
+		status := http.StatusServiceUnavailable
+		if errors.Is(err, errExternalQualificationWANSenderWaitState) {
+			status = http.StatusConflict
+		}
+		if len(encoded) != 0 {
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(status)
+			_, _ = w.Write(encoded)
+			_, _ = w.Write([]byte{'\n'})
+		} else {
+			http.Error(w, err.Error(), status)
+		}
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_, _ = w.Write(encoded)
+	_, _ = w.Write([]byte{'\n'})
+}
+
+var errExternalQualificationWANSenderWaitState = errors.New("WAN sender-wait agent phase is unavailable")
+
+func (owner *externalQualificationWANSenderWaitOwner) drainPhase(sequence string) (string, string, string, bool) {
+	before, configured := owner.state[sequence]
+	expected := ""
+	if owner.nextSequence < len(externalQualificationWANSenderWaitSequenceOrder) {
+		expected = externalQualificationWANSenderWaitSequenceOrder[owner.nextSequence]
+	}
+	phase := "pre"
+	valid := configured && sequence == expected && before == "unstarted" && owner.activeSequence == ""
+	if before == "measuring" {
+		phase = "post"
+		valid = configured && sequence == expected && owner.activeSequence == sequence
+	}
+	if before == "complete" && sequence == externalQualificationWANSenderWaitSequenceOrder[len(externalQualificationWANSenderWaitSequenceOrder)-1] &&
+		owner.activeSequence == "" && owner.nextSequence == len(externalQualificationWANSenderWaitSequenceOrder) && !owner.terminalConsumed {
+		phase = "terminal"
+		valid = configured
+		for _, ordered := range externalQualificationWANSenderWaitSequenceOrder {
+			valid = valid && owner.state[ordered] == "complete"
+		}
+	}
+	return phase, before, expected, valid
+}
+
+func (owner *externalQualificationWANSenderWaitOwner) commitDrain(sequence, phase string) {
+	switch phase {
+	case "pre":
+		owner.state[sequence] = "measuring"
+		owner.activeSequence = sequence
+	case "post":
+		owner.state[sequence] = "complete"
+		owner.activeSequence = ""
+		owner.nextSequence++
+	case "terminal":
+		owner.terminalConsumed = true
+	}
+}
+
+func (owner *externalQualificationWANSenderWaitOwner) drain(sequence string, sessions *externalQualificationSessionRegistry) ([]byte, error) {
+	owner.mu.Lock()
+	defer owner.mu.Unlock()
+	phase, before, expected, valid := owner.drainPhase(sequence)
+	if !valid {
+		return nil, fmt.Errorf("%w: sequence %s from state %s, active %s, next %s", errExternalQualificationWANSenderWaitState, sequence, before, owner.activeSequence, expected)
+	}
+	result, err := externalQualificationGrowthSnapshot(sessions, true)
+	if err != nil {
+		owner.state[sequence] = "invalid"
+		failure, encodeErr := externalQualificationWANSenderWaitFailurePayload(result, err)
+		if encodeErr != nil {
+			return nil, encodeErr
+		}
+		return failure, err
+	}
+	encoded, err := json.Marshal(result)
+	if err != nil || len(encoded)+1 > externalQualificationWANSenderWaitMaxResponse {
+		owner.state[sequence] = "invalid"
+		if err != nil {
+			return nil, fmt.Errorf("encode WAN byte-credit agent response: %w", err)
+		}
+		cause := fmt.Errorf("WAN byte-credit agent response is %d bytes, exceeds fixed %d-byte bound", len(encoded)+1, externalQualificationWANSenderWaitMaxResponse)
+		failure, failureErr := externalQualificationWANSenderWaitFailurePayload(result, cause)
+		if failureErr != nil {
+			return nil, failureErr
+		}
+		return failure, cause
+	}
+	owner.commitDrain(sequence, phase)
+	return encoded, nil
+}
