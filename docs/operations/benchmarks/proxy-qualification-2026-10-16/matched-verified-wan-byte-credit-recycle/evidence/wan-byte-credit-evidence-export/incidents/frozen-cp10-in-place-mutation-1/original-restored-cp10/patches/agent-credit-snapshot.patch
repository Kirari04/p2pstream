+func TestExternalQualificationWANSenderWaitFailurePayloadPreservesOrHashesSnapshot(t *testing.T) {
+	small := externalQualificationGrowthResponse{
+		SchemaVersion:    externalQualificationCreditSnapshotSchemaVersion,
+		Events:           []externalQualificationGrowthEvent{},
+		SendCounters:     []externalQualificationSendCounterSnapshot{},
+		ByteCreditTraces: []externalQualificationByteCreditTrace{},
+	}
+	encoded, err := externalQualificationWANSenderWaitFailurePayload(small, errors.New("trace health failed"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var preserved externalQualificationWANSenderWaitFailureResponse
+	if err := json.Unmarshal(encoded, &preserved); err != nil {
+		t.Fatal(err)
+	}
+	if preserved.Accepted || !preserved.Invalid || preserved.Snapshot == nil || preserved.OmittedSnapshotBytes != 0 || preserved.OmittedSnapshotSHA256 != "" {
+		t.Fatalf("preserved failure = %+v", preserved)
+	}
+	smallRaw, err := json.Marshal(small)
+	if err != nil {
+		t.Fatal(err)
+	}
+	preservedRaw, err := json.Marshal(preserved.Snapshot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(preservedRaw, smallRaw) {
+		t.Fatalf("preserved snapshot differs: got %q want %q", preservedRaw, smallRaw)
+	}
+	large := small
+	large.Events = []externalQualificationGrowthEvent{{Outcome: strings.Repeat("x", externalQualificationWANSenderWaitMaxResponse)}}
+	largeRaw, err := json.Marshal(large)
+	if err != nil {
+		t.Fatal(err)
+	}
+	largeSum := sha256.Sum256(largeRaw)
+	encoded, err = externalQualificationWANSenderWaitFailurePayload(large, errors.New("trace health failed"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var omitted externalQualificationWANSenderWaitFailureResponse
+	if err := json.Unmarshal(encoded, &omitted); err != nil {
+		t.Fatal(err)
+	}
+	if omitted.Snapshot != nil || omitted.OmittedSnapshotBytes != len(largeRaw) || omitted.OmittedSnapshotSHA256 != fmt.Sprintf("%x", largeSum[:]) {
+		t.Fatalf("omitted failure = %+v", omitted)
+	}
+}
