+func externalQualificationWANSenderWaitFailurePayload(result externalQualificationGrowthResponse, cause error) ([]byte, error) {
+	failure := externalQualificationWANSenderWaitFailureResponse{
+		SchemaVersion: 1, Accepted: false, Invalid: true, Error: cause.Error(),
+	}
+	if result.SchemaVersion != 0 {
+		raw, err := json.Marshal(result)
+		if err != nil {
+			return nil, fmt.Errorf("encode rejected WAN byte-credit agent snapshot: %w", err)
+		}
+		failure.Snapshot = &result
+		encoded, err := json.Marshal(failure)
+		if err != nil {
+			return nil, fmt.Errorf("encode WAN byte-credit agent failure: %w", err)
+		}
+		if len(encoded)+1 <= externalQualificationWANSenderWaitMaxResponse {
+			return encoded, nil
+		}
+		sum := sha256.Sum256(raw)
+		failure.Snapshot = nil
+		failure.OmittedSnapshotBytes = len(raw)
+		failure.OmittedSnapshotSHA256 = fmt.Sprintf("%x", sum[:])
+	}
+	encoded, err := json.Marshal(failure)
+	if err != nil {
+		return nil, fmt.Errorf("encode WAN byte-credit agent failure metadata: %w", err)
+	}
+	if len(encoded)+1 > externalQualificationWANSenderWaitMaxResponse {
+		return nil, errors.New("WAN byte-credit agent failure metadata exceeds fixed response bound")
+	}
+	return encoded, nil
+}
