+func validateExternalQualificationByteCreditSessions(observed []externalQualificationCreditObservedSession) error {
+	if len(observed) != 5 {
+		return fmt.Errorf("WAN byte-credit agent session cardinality is %d, want 5", len(observed))
+	}
+	identities := make(map[string]struct{}, len(observed))
+	for index, entry := range observed {
+		if entry.lane != index || !entry.aggregate || entry.session == nil {
+			return fmt.Errorf("WAN byte-credit agent session lane %d ownership is invalid", index)
+		}
+		identity := fmt.Sprintf("%p", entry.session)
+		localAddress, remoteAddress := externalQualificationSessionAddresses(entry.session)
+		if _, duplicate := identities[identity]; duplicate || identity == "" ||
+			!externalQualificationByteCreditAddressValid(localAddress) ||
+			!externalQualificationByteCreditAddressValid(remoteAddress) {
+			return fmt.Errorf("WAN byte-credit agent session lane %d identity is invalid", index)
+		}
+		identities[identity] = struct{}{}
+	}
+	return nil
+}
