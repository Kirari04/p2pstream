+func newExternalQualificationWANSenderWaitHealthySessions(t *testing.T) *externalQualificationSessionRegistry {
+	t.Helper()
+	registry := newExternalQualificationSessionRegistry(5)
+	for lane := 0; lane < 5; lane++ {
+		clientConn, serverConn := net.Pipe()
+		t.Cleanup(func() { _ = clientConn.Close() })
+		t.Cleanup(func() { _ = serverConn.Close() })
+		config, err := tunnel.NewNegotiatedControlYamuxConfig(nil, tunnel.DefaultAdaptiveReceiveWindowBytes, tunnel.NegotiatedControlStreamLimit)
+		if lane > 0 {
+			config, err = tunnel.NewAggregateYamuxConfig(nil, tunnel.DefaultMaxStreamWindowSizeBytes, 4)
+		}
+		if err != nil {
+			t.Fatalf("lane %d config: %v", lane, err)
+		}
+		peer, err := yamux.Server(serverConn, config)
+		if err != nil {
+			t.Fatalf("lane %d server: %v", lane, err)
+		}
+		t.Cleanup(func() { _ = peer.Close() })
+		client, err := yamux.Client(clientConn, config)
+		if err != nil {
+			t.Fatalf("lane %d client: %v", lane, err)
+		}
+		t.Cleanup(func() { _ = client.Close() })
+		registry.observe(tunnelSessionObservation{Lane: lane, Aggregate: true, Connected: true, Session: client})
+	}
+	return registry
+}
