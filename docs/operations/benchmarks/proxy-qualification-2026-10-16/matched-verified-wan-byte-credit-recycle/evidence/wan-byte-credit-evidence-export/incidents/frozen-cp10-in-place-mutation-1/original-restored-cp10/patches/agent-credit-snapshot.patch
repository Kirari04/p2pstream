+func TestExternalQualificationWANSenderWaitTerminalControl(t *testing.T) {
+	bearer := strings.Repeat("a1", 32)
+	owner, err := newExternalQualificationWANSenderWaitOwner("1", bearer, externalQualificationWANSenderWaitSequences)
+	if err != nil || owner == nil {
+		t.Fatalf("create owner: owner=%v err=%v", owner, err)
+	}
+	externalQualificationWANSenderWaitTestTransition(t, owner, "15", "pre", false)
+	for index, sequence := range externalQualificationWANSenderWaitSequenceOrder {
+		externalQualificationWANSenderWaitTestTransition(t, owner, sequence, "pre", true)
+		probe := "15"
+		if sequence == "15" {
+			probe = "9"
+		}
+		externalQualificationWANSenderWaitTestTransition(t, owner, probe, "pre", false)
+		externalQualificationWANSenderWaitTestTransition(t, owner, sequence, "post", true)
+		if owner.nextSequence != index+1 || owner.activeSequence != "" || owner.state[sequence] != "complete" {
+			t.Fatalf("sequence %s did not complete exactly once: next=%d active=%q state=%q", sequence, owner.nextSequence, owner.activeSequence, owner.state[sequence])
+		}
+	}
+	externalQualificationWANSenderWaitTestTransition(t, owner, "15", "terminal", true)
+	if !owner.terminalConsumed {
+		t.Fatal("terminal drain did not mark its one-shot transition consumed")
+	}
+	externalQualificationWANSenderWaitTestTransition(t, owner, "15", "pre", false)
+}
