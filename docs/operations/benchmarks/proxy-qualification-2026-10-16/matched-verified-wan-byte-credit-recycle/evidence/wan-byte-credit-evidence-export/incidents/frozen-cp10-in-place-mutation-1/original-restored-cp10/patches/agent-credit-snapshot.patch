+			externalQualificationWANSenderWaitHealthyRequest(t, owner, sessions, bearer, sequence)
+			responseCount++
+		}
+	}
+	terminal := externalQualificationWANSenderWaitHealthyRequest(t, owner, sessions, bearer, "15")
+	responseCount++
+	if responseCount != 9 || !owner.terminalConsumed || terminal.ByteCreditTraces == nil {
+		t.Fatalf("terminal responses=%d consumed=%v byte-traces-nil=%v", responseCount, owner.terminalConsumed, terminal.ByteCreditTraces == nil)
+	}
+	replay := externalQualificationWANSenderWaitTestRequest(owner, bearer, "15")
+	if replay.Code != http.StatusConflict {
+		t.Fatalf("terminal replay status=%d, want %d", replay.Code, http.StatusConflict)
+	}
+}
