+// proxyRequestEventIDValue preserves sql.NullInt64.Value semantics without
+// boxing the nullable struct before database/sql converts it to nil or int64.
+func proxyRequestEventIDValue(value sql.NullInt64) any {
+	if !value.Valid {
+		return nil
+	}
+	return value.Int64
+}
