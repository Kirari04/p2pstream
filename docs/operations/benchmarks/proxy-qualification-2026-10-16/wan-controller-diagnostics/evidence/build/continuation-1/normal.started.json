{
  "argv": [
    "taskset",
    "-c",
    "8-11",
    "env",
    "GOMAXPROCS=2",
    "GOENV=off",
    "GOWORK=off",
    "GOFLAGS=",
    "GOTOOLCHAIN=local",
    "GOPROXY=off",
    "GOSUMDB=off",
    "timeout",
    "--signal=TERM",
    "--kill-after=5s",
    "240s",
    "/home/user/go/pkg/mod/golang.org/toolchain@v0.0.1-go1.26.6.linux-amd64/bin/go",
    "test",
    "-p=2",
    "-tags=p2pstream_qualification",
    "-count=1",
    "-timeout=60s",
    "-run",
    "^TestQualification(Terminal|RawWrite|TCP|Controller)",
    "-v",
    "./internal/agent"
  ],
  "artifact_rejection_threshold_bytes": 268435456,
  "artifact_tree_check_seconds": 1.0,
  "deadline_seconds": 270.0,
  "per_stream_rejection_threshold_bytes": 8388608,
  "schema_version": 1,
  "state": "running",
  "stream_check_seconds": 0.05,
  "threshold_semantics": "polled rejection; overshoot possible; complete logs retained; any observed overflow rejects"
