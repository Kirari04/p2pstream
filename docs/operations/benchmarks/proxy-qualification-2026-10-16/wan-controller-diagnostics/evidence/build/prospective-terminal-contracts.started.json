{
  "argv": [
    "taskset",
    "-c",
    "8-11",
    "env",
    "PYTHONDONTWRITEBYTECODE=1",
    "timeout",
    "--signal=TERM",
    "--kill-after=5s",
    "20s",
    "python3",
    "-I",
    "-B",
    "contracts/test-terminal-attribution.py",
    "-v"
  ],
  "artifact_rejection_threshold_bytes": 268435456,
  "artifact_tree_check_seconds": 1.0,
  "deadline_seconds": 50.0,
  "per_stream_rejection_threshold_bytes": 1048576,
  "schema_version": 1,
  "state": "running",
  "stream_check_seconds": 0.05,
  "threshold_semantics": "polled rejection; overshoot possible; complete logs retained; any observed overflow rejects"
}
