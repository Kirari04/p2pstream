@@ -0,0 +1,152 @@
+package server
+
+import (
+	"context"
+	"crypto/tls"
+	"fmt"
+	"net"
+	"net/http"
+	"os"
+	"reflect"
+	"testing"
+	"time"
+
+	"p2pstream/internal/tcpsocket"
+)
+
+// These controls are dormant in the ordinary subprocess roles. This file is
+// part of an isolated diagnostic overlay, not a production listener option.
+func qualificationNativeAttributionEnabled() bool {
+	return os.Getenv("P2PSTREAM_QUALIFICATION_NATIVE_GO_ATTRIBUTION") == "1"
+}
+
+func qualificationNativeAttributionScheme(t *testing.T) string {
+	t.Helper()
+	if !qualificationNativeAttributionEnabled() {
+		return "https"
+	}
+	mode := os.Getenv("P2PSTREAM_QUALIFICATION_NATIVE_GO_PUBLIC_MODE")
+	if mode != "http" && mode != "https" {
+		t.Fatalf("invalid native Go attribution public mode %q", mode)
+	}
+	return mode
+}
+
+func qualificationNativeAttributionTransport() *http.Transport {
+	transport := http.DefaultTransport.(*http.Transport).Clone()
+	transport.DisableKeepAlives = false
+	transport.MaxIdleConns = 1024
+	transport.MaxIdleConnsPerHost = 128
+	transport.MaxConnsPerHost = 0
+	transport.IdleConnTimeout = 90 * time.Second
+	transport.ResponseHeaderTimeout = 10 * time.Second
+	baseDial := transport.DialContext
+	transport.DialContext = func(ctx context.Context, network, address string) (net.Conn, error) {
+		conn, err := baseDial(ctx, network, address)
+		if err != nil {
+			return nil, err
+		}
+		if err := qualificationNativeAttributionConfigureTCP(conn); err != nil {
+			_ = conn.Close()
+			return nil, err
+		}
+		return conn, nil
+	}
+	return transport
+}
+
+func qualificationNativeAttributionConfigureTCP(conn net.Conn) error {
+	tcp, ok := conn.(*net.TCPConn)
+	if !ok {
+		return fmt.Errorf("native attribution requires TCP, got %T", conn)
+	}
+	_, err := tcpsocket.Configure(tcp, 0)
+	return err
+}
+
+type qualificationNativeAttributionListener struct {
+	net.Listener
+}
+
+func (l qualificationNativeAttributionListener) Accept() (net.Conn, error) {
+	conn, err := l.Listener.Accept()
+	if err != nil {
+		return nil, err
+	}
+	if err := qualificationNativeAttributionConfigureTCP(conn); err != nil {
+		_ = conn.Close()
+		return nil, err
+	}
+	return conn, nil
+}
+
+func qualificationNativeAttributionTLSConfig() *tls.Config {
+	return &tls.Config{
+		MinVersion: tls.VersionTLS12,
+		NextProtos: []string{"acme-tls/1", "h2", "http/1.1"},
+	}
+}
+
+func qualificationNativeAttributionClientTLSConfig(protocol string) *tls.Config {
+	config := &tls.Config{InsecureSkipVerify: true} // fixture certificate
+	if qualificationNativeAttributionEnabled() && protocol == "h1" {
+		config.ServerName = "public.test"
+	}
+	return config
+}
+
+func TestQualificationNativeAttributionDefaultRemainsHTTPS(t *testing.T) {
+	t.Setenv("P2PSTREAM_QUALIFICATION_NATIVE_GO_ATTRIBUTION", "")
+	t.Setenv("P2PSTREAM_QUALIFICATION_NATIVE_GO_PUBLIC_MODE", "http")
+	if got := qualificationNativeAttributionScheme(t); got != "https" {
+		t.Fatalf("default scheme = %q, want https", got)
+	}
+}
+
+func TestQualificationNativeAttributionSchemes(t *testing.T) {
+	t.Setenv("P2PSTREAM_QUALIFICATION_NATIVE_GO_ATTRIBUTION", "1")
+	for _, scheme := range []string{"http", "https"} {
+		t.Run(scheme, func(t *testing.T) {
+			t.Setenv("P2PSTREAM_QUALIFICATION_NATIVE_GO_PUBLIC_MODE", scheme)
+			if got := qualificationNativeAttributionScheme(t); got != scheme {
+				t.Fatalf("scheme = %q, want %q", got, scheme)
+			}
+		})
+	}
+}
+
+func TestQualificationNativeAttributionTransportMatchesProductionSettings(t *testing.T) {
+	transport := qualificationNativeAttributionTransport()
+	t.Cleanup(transport.CloseIdleConnections)
+	if transport.MaxIdleConns != 1024 || transport.MaxIdleConnsPerHost != 128 || transport.MaxConnsPerHost != 0 {
+		t.Fatalf("connection limits = %d/%d/%d", transport.MaxIdleConns, transport.MaxIdleConnsPerHost, transport.MaxConnsPerHost)
+	}
+	if transport.DisableKeepAlives || transport.IdleConnTimeout != 90*time.Second || transport.ResponseHeaderTimeout != 10*time.Second {
+		t.Fatalf("transport timeouts/keepalive = disable:%t idle:%s response:%s", transport.DisableKeepAlives, transport.IdleConnTimeout, transport.ResponseHeaderTimeout)
+	}
+	if !transport.ForceAttemptHTTP2 || transport.DialContext == nil {
+		t.Fatalf("transport HTTP/2/dial settings = force:%t dial_nil:%t", transport.ForceAttemptHTTP2, transport.DialContext == nil)
+	}
+}
+
+func TestQualificationNativeAttributionTLSConfigMatchesPublicDefaults(t *testing.T) {
+	config := qualificationNativeAttributionTLSConfig()
+	wantProtocols := []string{"acme-tls/1", "h2", "http/1.1"}
+	if config.MinVersion != tls.VersionTLS12 || !reflect.DeepEqual(config.NextProtos, wantProtocols) {
+		t.Fatalf("TLS config = min:%x protocols:%v", config.MinVersion, config.NextProtos)
+	}
+}
+
+func TestQualificationNativeAttributionClientServerNameIsOptInH1Only(t *testing.T) {
+	t.Setenv("P2PSTREAM_QUALIFICATION_NATIVE_GO_ATTRIBUTION", "")
+	if config := qualificationNativeAttributionClientTLSConfig("h1"); config.ServerName != "" || !config.InsecureSkipVerify {
+		t.Fatalf("default H1 client TLS config = server_name:%q insecure_skip_verify:%t", config.ServerName, config.InsecureSkipVerify)
+	}
+	t.Setenv("P2PSTREAM_QUALIFICATION_NATIVE_GO_ATTRIBUTION", "1")
+	if config := qualificationNativeAttributionClientTLSConfig("h1"); config.ServerName != "public.test" || !config.InsecureSkipVerify {
+		t.Fatalf("attribution H1 client TLS config = server_name:%q insecure_skip_verify:%t", config.ServerName, config.InsecureSkipVerify)
+	}
+	if config := qualificationNativeAttributionClientTLSConfig("h2"); config.ServerName != "" || !config.InsecureSkipVerify {
+		t.Fatalf("attribution H2 client TLS config = server_name:%q insecure_skip_verify:%t", config.ServerName, config.InsecureSkipVerify)
+	}
+}
