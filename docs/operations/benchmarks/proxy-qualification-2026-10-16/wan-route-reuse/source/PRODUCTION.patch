+	}
+	_ = resp.Body.Close()
+	_ = resp.Body.Close()
+	if entry.inFlight != 0 {
+		t.Fatal("canceled body retained claim")
+	}
+	unblock()
+	consume()
+	fake.waitOpenRequestCount(t, 3)
