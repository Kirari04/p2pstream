+func TestPreparedProxyRequestEventHierarchicalBatchFitsActualSQLiteVariableCeiling(t *testing.T) {
+	database := newServerTestDB(t)
+	rows, err := database.QueryContext(t.Context(), `PRAGMA compile_options`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer rows.Close()
+	maximum := 0
+	for rows.Next() {
+		var option string
+		if err := rows.Scan(&option); err != nil {
+			t.Fatal(err)
+		}
+		value, ok := strings.CutPrefix(option, "MAX_VARIABLE_NUMBER=")
+		if !ok {
+			continue
+		}
+		maximum, err = strconv.Atoi(value)
+		if err != nil {
+			t.Fatalf("SQLite variable ceiling %q: %v", value, err)
+		}
+	}
+	if err := rows.Err(); err != nil {
+		t.Fatal(err)
+	}
+	const required = 64 * 23
+	if maximum < required {
+		t.Fatalf("SQLite MAX_VARIABLE_NUMBER = %d, need at least %d for 64 rows", maximum, required)
+	}
+	t.Logf("SQLite MAX_VARIABLE_NUMBER=%d supports %d bound parameters", maximum, required)
+}
