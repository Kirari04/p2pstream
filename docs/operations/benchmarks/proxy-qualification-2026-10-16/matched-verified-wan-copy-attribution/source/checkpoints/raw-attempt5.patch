--- /dev/null
+++ b/modified/internal/server/proxy_copy_attribution.go
@@ -0,0 +1,198 @@
+package server
+
+import (
+	"context"
+	"io"
+	"sync/atomic"
+	"time"
+)
+
+// proxyCopyAttribution is installed only by the opt-in qualification overlay.
+// Its callbacks aggregate fixed-size counters; they never retain body buffers.
+type proxyCopyAttribution struct {
+	bodyWraps     uint64
+	read          proxyCopyAttributionMetric
+	write         proxyCopyAttributionMetric
+	interReadGap  proxyCopyAttributionMetric
+	readEOF       uint64
+	readErrors    uint64
+	writeErrors   uint64
+	shortWrites   uint64
+	readFromCalls uint64
+
+	previousReadEnd time.Time
+	haveReadEnd     bool
+	complete        atomic.Bool
+}
+
+type proxyCopyAttributionMetric struct {
+	calls       uint64
+	bytes       uint64
+	totalNanos  uint64
+	maxNanos    uint64
+	firstUnixNS int64
+	lastUnixNS  int64
+	buckets     [8]uint64
+	longest     [8]proxyCopyAttributionStall
+}
+
+type proxyCopyAttributionStall struct {
+	Call        uint64 `json:"call"`
+	Bytes       uint64 `json:"bytes"`
+	DurationNS  uint64 `json:"duration_ns"`
+	StartedUnix int64  `json:"started_unix_ns"`
+}
+
+type proxyCopyAttributionMetricSnapshot struct {
+	Calls      uint64                       `json:"calls"`
+	Bytes      uint64                       `json:"bytes"`
+	TotalNanos uint64                       `json:"total_ns"`
+	MaxNanos   uint64                       `json:"max_ns"`
+	FirstUnix  int64                        `json:"first_unix_ns,omitempty"`
+	LastUnix   int64                        `json:"last_unix_ns,omitempty"`
+	Buckets    [8]uint64                    `json:"duration_bucket_counts"`
+	Longest    [8]proxyCopyAttributionStall `json:"longest_stalls"`
+}
+
+type proxyCopyAttributionSnapshot struct {
+	Complete                    bool                               `json:"complete"`
+	BodyWraps                   uint64                             `json:"body_wraps"`
+	Read                        proxyCopyAttributionMetricSnapshot `json:"upstream_read"`
+	Write                       proxyCopyAttributionMetricSnapshot `json:"downstream_write"`
+	InterReadGap                proxyCopyAttributionMetricSnapshot `json:"inter_read_gap"`
+	DurationBucketUpperBoundsNS [8]int64                           `json:"duration_bucket_upper_bounds_ns"`
+	ReadEOF                     uint64                             `json:"read_eof"`
+	ReadErrors                  uint64                             `json:"read_errors"`
+	WriteErrors                 uint64                             `json:"write_errors"`
+	ShortWrites                 uint64                             `json:"short_writes"`
+	ReadFromCalls               uint64                             `json:"downstream_read_from_calls"`
+}
+
+type proxyCopyAttributionContextKey struct{}
+
+func withProxyCopyAttribution(ctx context.Context, attribution *proxyCopyAttribution) context.Context {
+	if attribution == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, proxyCopyAttributionContextKey{}, attribution)
+}
+
+func proxyCopyAttributionFromContext(ctx context.Context) *proxyCopyAttribution {
+	attribution, _ := ctx.Value(proxyCopyAttributionContextKey{}).(*proxyCopyAttribution)
+	return attribution
+}
+
+func proxyCopyAttributionBucket(duration time.Duration) int {
+	nanos := duration.Nanoseconds()
+	for index, upper := range [...]int64{1_000, 10_000, 100_000, 1_000_000, 10_000_000, 100_000_000, 1_000_000_000} {
+		if nanos < upper {
+			return index
+		}
+	}
+	return 7
+}
+
+func (metric *proxyCopyAttributionMetric) observe(started, ended time.Time, bytes int64) {
+	if metric == nil {
+		return
+	}
+	duration := ended.Sub(started)
+	if duration < 0 {
+		duration = 0
+	}
+	nanos := uint64(duration.Nanoseconds())
+	metric.calls++
+	if bytes > 0 {
+		metric.bytes += uint64(bytes)
+	}
+	metric.totalNanos += nanos
+	if nanos > metric.maxNanos {
+		metric.maxNanos = nanos
+	}
+	if metric.firstUnixNS == 0 {
+		metric.firstUnixNS = started.UnixNano()
+	}
+	metric.lastUnixNS = ended.UnixNano()
+	metric.buckets[proxyCopyAttributionBucket(duration)]++
+	stall := proxyCopyAttributionStall{Call: metric.calls, Bytes: uint64(max(bytes, int64(0))), DurationNS: nanos, StartedUnix: started.UnixNano()}
+	for index := range metric.longest {
+		if stall.DurationNS > metric.longest[index].DurationNS {
+			copy(metric.longest[index+1:], metric.longest[index:len(metric.longest)-1])
+			metric.longest[index] = stall
+			break
+		}
+	}
+}
+
+func (metric proxyCopyAttributionMetric) snapshot() proxyCopyAttributionMetricSnapshot {
+	return proxyCopyAttributionMetricSnapshot{
+		Calls: metric.calls, Bytes: metric.bytes, TotalNanos: metric.totalNanos, MaxNanos: metric.maxNanos,
+		FirstUnix: metric.firstUnixNS, LastUnix: metric.lastUnixNS, Buckets: metric.buckets, Longest: metric.longest,
+	}
+}
+
+func (attribution *proxyCopyAttribution) wrapResponseBody(body io.ReadCloser) io.ReadCloser {
+	if attribution == nil || body == nil {
+		return body
+	}
+	attribution.bodyWraps++
+	return &proxyCopyAttributionReadCloser{ReadCloser: body, attribution: attribution}
+}
+
+func (attribution *proxyCopyAttribution) observeWrite(started, ended time.Time, written int64, err error, short, readFrom bool) {
+	if attribution == nil {
+		return
+	}
+	attribution.write.observe(started, ended, written)
+	if err != nil {
+		attribution.writeErrors++
+	}
+	if short {
+		attribution.shortWrites++
+	}
+	if readFrom {
+		attribution.readFromCalls++
+	}
+}
+
+func (attribution *proxyCopyAttribution) markComplete() {
+	if attribution != nil {
+		attribution.complete.Store(true)
+	}
+}
+
+func (attribution *proxyCopyAttribution) snapshot() proxyCopyAttributionSnapshot {
+	bounds := [8]int64{1_000, 10_000, 100_000, 1_000_000, 10_000_000, 100_000_000, 1_000_000_000, -1}
+	if attribution == nil || !attribution.complete.Load() {
+		return proxyCopyAttributionSnapshot{DurationBucketUpperBoundsNS: bounds}
+	}
+	return proxyCopyAttributionSnapshot{
+		Complete: true, BodyWraps: attribution.bodyWraps,
+		Read: attribution.read.snapshot(), Write: attribution.write.snapshot(), InterReadGap: attribution.interReadGap.snapshot(),
+		DurationBucketUpperBoundsNS: bounds, ReadEOF: attribution.readEOF, ReadErrors: attribution.readErrors,
+		WriteErrors: attribution.writeErrors, ShortWrites: attribution.shortWrites, ReadFromCalls: attribution.readFromCalls,
+	}
+}
+
+type proxyCopyAttributionReadCloser struct {
+	io.ReadCloser
+	attribution *proxyCopyAttribution
+}
+
+func (reader *proxyCopyAttributionReadCloser) Read(buffer []byte) (int, error) {
+	started := time.Now()
+	if reader.attribution.haveReadEnd {
+		reader.attribution.interReadGap.observe(reader.attribution.previousReadEnd, started, 0)
+	}
+	n, err := reader.ReadCloser.Read(buffer)
+	ended := time.Now()
+	reader.attribution.read.observe(started, ended, int64(n))
+	reader.attribution.previousReadEnd = ended
+	reader.attribution.haveReadEnd = true
+	if err == io.EOF {
+		reader.attribution.readEOF++
+	} else if err != nil {
+		reader.attribution.readErrors++
+	}
+	return n, err
+}
diff --git a/modified/internal/server/proxy_copy_attribution_test.go b/modified/internal/server/proxy_copy_attribution_test.go
