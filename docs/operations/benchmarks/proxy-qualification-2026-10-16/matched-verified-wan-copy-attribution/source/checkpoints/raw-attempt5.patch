+++ b/modified/internal/server/proxy_qualification_wan_copy_attribution_test.go
@@ -0,0 +1,97 @@
+//go:build linux
+
+package server
+
+import (
+	"encoding/json"
+	"net/http"
+	"sync"
+	"time"
+)
+
+const qualificationWANCopyAttributionEnv = "P2PSTREAM_QUALIFICATION_WAN_COPY_ATTRIBUTION"
+
+type qualificationWANCopyAttributionEntry struct {
+	Sequence          string
+	Method            string
+	Path              string
+	StartedUnixNano   int64
+	HandlerReturnNano int64
+	Attribution       *proxyCopyAttribution
+}
+
+type qualificationWANCopyAttributionRecord struct {
+	Sequence          string                       `json:"sequence"`
+	Method            string                       `json:"method"`
+	Path              string                       `json:"path"`
+	Scope             string                       `json:"scope"`
+	StartedUnixNano   int64                        `json:"started_unix_ns"`
+	HandlerReturnNano int64                        `json:"handler_return_unix_ns,omitempty"`
+	Attribution       proxyCopyAttributionSnapshot `json:"copy"`
+}
+
+func (entry *qualificationWANCopyAttributionEntry) snapshot() qualificationWANCopyAttributionRecord {
+	attribution := entry.Attribution.snapshot()
+	record := qualificationWANCopyAttributionRecord{
+		Sequence: entry.Sequence, Method: entry.Method, Path: entry.Path, Scope: "response-body-copy", Attribution: attribution,
+	}
+	if attribution.Complete {
+		record.StartedUnixNano = entry.StartedUnixNano
+		record.HandlerReturnNano = entry.HandlerReturnNano
+	}
+	return record
+}
+
+type qualificationWANCopyAttributionStore struct {
+	mu       sync.Mutex
+	entries  map[string][]*qualificationWANCopyAttributionEntry
+	count    int
+	overflow bool
+}
+
+func newQualificationWANCopyAttributionStore() *qualificationWANCopyAttributionStore {
+	return &qualificationWANCopyAttributionStore{entries: make(map[string][]*qualificationWANCopyAttributionEntry)}
+}
+
+func (store *qualificationWANCopyAttributionStore) wrap(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		sequence := r.Header.Get("X-Qualification-Diagnostic-Sequence")
+		if !qualificationWANSequenceValid(sequence) {
+			next.ServeHTTP(w, r)
+			return
+		}
+		entry := &qualificationWANCopyAttributionEntry{
+			Sequence: sequence, Method: r.Method, Path: r.URL.EscapedPath(),
+			StartedUnixNano: time.Now().UnixNano(), Attribution: &proxyCopyAttribution{},
+		}
+		store.mu.Lock()
+		if store.count >= 32 {
+			store.overflow = true
+			store.mu.Unlock()
+			next.ServeHTTP(w, r)
+			return
+		}
+		store.entries[sequence] = append(store.entries[sequence], entry)
+		store.count++
+		store.mu.Unlock()
+
+		next.ServeHTTP(w, r.WithContext(withProxyCopyAttribution(r.Context(), entry.Attribution)))
+		entry.HandlerReturnNano = time.Now().UnixNano()
+		entry.Attribution.markComplete()
+	})
+}
+
+func (store *qualificationWANCopyAttributionStore) serveHTTP(w http.ResponseWriter, sequence string) {
+	w.Header().Set("Content-Type", "application/json")
+	store.mu.Lock()
+	entries := append([]*qualificationWANCopyAttributionEntry(nil), store.entries[sequence]...)
+	count, overflow := store.count, store.overflow
+	store.mu.Unlock()
+	snapshots := make([]qualificationWANCopyAttributionRecord, 0, len(entries))
+	for _, entry := range entries {
+		snapshots = append(snapshots, entry.snapshot())
+	}
+	_ = json.NewEncoder(w).Encode(map[string]any{
+		"sequence": sequence, "matches": snapshots, "store_count": count, "overflow": overflow,
+	})
+}
