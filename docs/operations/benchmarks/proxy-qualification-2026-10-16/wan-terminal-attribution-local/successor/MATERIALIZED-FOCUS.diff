+func TestQualificationTerminalRealTLSProtocolProvenance(t *testing.T) {
+	for _, handshake := range []bool{true, false} {
+		name := "close_notify"
+		if handshake {
+			name = "handshake"
+		}
+		t.Run(name, func(t *testing.T) {
+			f := terminalTLSFixture(t)
+			if !handshake {
+				f.handshake(t)
+			}
+			// Deliberately present a simultaneous unrelated above-TLS token. Real TLS
+			// protocol writes must not inherit its Yamux label in retained finalization.
+			f.owner.mu.Lock()
+			headers, _ := terminalParseControls(terminalGoAwayHeader())
+			s := &f.owner.terminal
+			s.ActivePlain = true
+			s.plain = terminalPlain{Begin: s.next(), Attempt: 12, Control: true, Headers: headers}
+			f.owner.mu.Unlock()
+			f.localIntent()
+			if handshake {
+				f.handshake(t)
+			} else {
+				peerResult := make(chan error, 1)
+				done := f.launch(func() { var p [1]byte; _, err := f.peer.Read(p[:]); peerResult <- err })
+				if err := f.client.CloseWrite(); err != nil {
+					t.Fatal(err)
+				}
+				terminalWait(t, done, "peer close_notify")
+				if err := <-peerResult; !errors.Is(err, io.EOF) {
+					t.Fatalf("peer did not receive close_notify: %v", err)
+				}
+			}
+			s2 := f.snapshot()
+			if len(s2.Records) == 0 {
+				t.Fatal("actual TLS protocol raw calls not retained")
+			}
+			for _, v := range s2.Records {
+				if v.Error || v.Short || v.Written != v.Attempt || !v.Stack.Complete || terminalApplicationStack(v.Stack) || v.Plain.Begin != 0 || v.Plain.Control || len(v.Plain.Headers) != 0 {
+					t.Fatalf("protocol write retained an application identity: %+v", v)
+				}
+				expected := "crypto/tls.(*Conn).closeNotify"
+				if handshake {
+					expected = "crypto/tls.(*Conn).handshakeContext"
+				}
+				found := false
+				for _, name := range v.Stack.Functions {
+					if name == expected {
+						found = true
+					}
+				}
+				if !found || v.Stack.GoVersion != terminalPinnedGo {
+					t.Fatalf("actual expected protocol ancestry absent: %+v", v.Stack)
+				}
+				encoded, _ := json.Marshal(v)
+				t.Logf("protocol=%s", encoded)
+			}
+			f.owner.mu.Lock()
+			s.ActivePlain = false
+			s.plain = terminalPlain{}
+			f.owner.mu.Unlock()
+			_ = f.raw.Close()
+			for _, done := range f.workers {
+				terminalWait(t, done, "protocol fixture worker")
+			}
+		})
+	}
+}
