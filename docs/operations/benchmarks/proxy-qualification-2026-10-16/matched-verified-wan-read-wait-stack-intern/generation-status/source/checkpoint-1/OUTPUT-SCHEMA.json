{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p2pstream:wan-read-wait:interned-parsed-trace-reduction:v2",
  "title": "Pinned Go lossless interned parsed-trace handler reduction",
  "type": "object",
  "required": [
    "schema_version",
    "accepted",
    "errors",
    "task_type",
    "region_type",
    "input",
    "input_representation",
    "input_bytes",
    "parsed_tool_status_file",
    "canonicalizer_status_file",
    "canonical_ledger_file",
    "fixed_bounds"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "accepted": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_type": {
      "const": "wan-read-wait-request"
    },
    "region_type": {
      "const": "public-proxy-handler"
    },
    "input": {
      "type": "string"
    },
    "input_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parsed_tool_status_file": {
      "type": "string"
    },
    "parsed_tool_status_sha256": {
      "const": "9a271f2a916b0b6ee6cecb2426f0b3206ef074578be55d9bc94f6f3fe3ab86aa"
    },
    "fixed_bounds": {
      "type": "object",
      "required": [
        "max_canonical_input_bytes",
        "max_expanded_input_bytes",
        "max_line_bytes",
        "max_events",
        "max_event_continuations",
        "max_event_bytes",
        "max_wait_stack_groups",
        "max_stack_definitions",
        "max_definition_bytes",
        "max_output_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "max_line_bytes": {
          "const": 1048576
        },
        "max_events": {
          "const": 5000000
        },
        "max_event_continuations": {
          "const": 4096
        },
        "max_event_bytes": {
          "const": 4194304
        },
        "max_wait_stack_groups": {
          "const": 4096
        },
        "max_output_bytes": {
          "const": 8388608
        },
        "max_canonical_input_bytes": {
          "const": 536870912
        },
        "max_expanded_input_bytes": {
          "const": 4294967296
        },
        "max_stack_definitions": {
          "const": 4096
        },
        "max_definition_bytes": {
          "const": 67108864
        }
      }
    },
    "markers": {
      "type": "object",
      "required": [
        "task_id",
        "handler_gid",
        "task_begin",
        "task_end",
        "region_begin",
        "region_end",
        "event_count"
      ],
      "properties": {
        "task_id": {
          "type": "integer",
          "minimum": 1
        },
        "handler_gid": {
          "type": "integer",
          "minimum": 1
        },
        "task_begin": {
          "$ref": "#/$defs/position"
        },
        "task_end": {
          "$ref": "#/$defs/position"
        },
        "region_begin": {
          "$ref": "#/$defs/position"
        },
        "region_end": {
          "$ref": "#/$defs/position"
        },
        "event_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "reduction": {
      "type": "object",
      "required": [
        "region_duration_ns",
        "partition_sum_ns",
        "partition_delta_ns",
        "state_ns",
        "waiting_category_ns",
        "waiting_reason_ns",
        "waiting_stack_groups",
        "top_wait_intervals",
        "handler_transition_count",
        "waiting_status_snapshot_count",
        "waiting_status_snapshot_carried_ns",
        "zero_duration_state_interval_counts",
        "unblock_header_gid_diff_count",
        "missing_stack_ns",
        "unknown_stack_ns",
        "attribution_complete"
      ],
      "properties": {
        "region_duration_ns": {
          "type": "integer",
          "minimum": 1
        },
        "partition_sum_ns": {
          "type": "integer",
          "minimum": 1
        },
        "partition_delta_ns": {
          "const": 0
        },
        "state_ns": {
          "$ref": "#/$defs/stateDurations"
        },
        "waiting_category_ns": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "waiting_reason_ns": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "waiting_stack_groups": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/waitGroup"
          }
        },
        "top_wait_intervals": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object"
          }
        },
        "handler_transition_count": {
          "type": "integer",
          "minimum": 0
        },
        "waiting_status_snapshot_count": {
          "type": "integer",
          "minimum": 0
        },
        "waiting_status_snapshot_carried_ns": {
          "type": "integer",
          "minimum": 0
        },
        "zero_duration_state_interval_counts": {
          "$ref": "#/$defs/stateDurations"
        },
        "unblock_header_gid_diff_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_stack_ns": {
          "const": 0
        },
        "unknown_stack_ns": {
          "type": "integer",
          "minimum": 0
        },
        "attribution_complete": {
          "type": "boolean"
        }
      }
    },
    "input_representation": {
      "const": "p2pstream-parsed-stack-intern-v1"
    },
    "canonicalizer_status_file": {
      "type": "string"
    },
    "canonicalizer_status_sha256": {
      "const": "9a271f2a916b0b6ee6cecb2426f0b3206ef074578be55d9bc94f6f3fe3ab86aa"
    },
    "canonical_ledger_file": {
      "type": "string"
    },
    "canonical_ledger_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expanded_input_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967296
    },
    "expanded_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonical_dictionary": {
      "type": "object",
      "required": [
        "definition_count",
        "definition_bytes",
        "record_count",
        "prefooter_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "definition_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "definition_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "prefooter_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "accepted": {
            "const": true
          }
        },
        "required": [
          "accepted"
        ]
      },
      "then": {
        "required": [
          "input_sha256",
          "parsed_tool_status_sha256",
          "canonicalizer_status_sha256",
          "canonical_ledger_sha256",
          "expanded_input_bytes",
          "expanded_input_sha256",
          "canonical_dictionary",
          "markers",
          "reduction"
        ],
        "properties": {
          "errors": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false
    },
    "stateDurations": {
      "type": "object",
      "required": [
        "Running",
        "Runnable",
        "Syscall",
        "Waiting"
      ],
      "additionalProperties": false,
      "properties": {
        "Running": {
          "type": "integer",
          "minimum": 0
        },
        "Runnable": {
          "type": "integer",
          "minimum": 0
        },
        "Syscall": {
          "type": "integer",
          "minimum": 0
        },
        "Waiting": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "waitGroup": {
      "type": "object",
      "required": [
        "reason",
        "stack_sha256",
        "stack",
        "frames",
        "category",
        "count",
        "duration_ns"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "stack_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "function",
                  "file",
                  "line"
                ],
                "properties": {
                  "function": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "not": {
                  "required": [
                    "zero_pc_sentinel"
                  ]
                }
              },
              {
                "type": "object",
                "required": [
                  "function",
                  "file",
                  "line",
                  "pc",
                  "zero_pc_sentinel"
                ],
                "properties": {
                  "function": {
                    "const": ""
                  },
                  "file": {
                    "const": ""
                  },
                  "line": {
                    "const": 0
                  },
                  "pc": {
                    "const": 0
                  },
                  "zero_pc_sentinel": {
                    "const": true
                  }
                }
              }
            ]
          }
        },
        "category": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "duration_ns": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "x-p2pstream-cohort-join-required": [
    "sequence",
    "server_binary_sha256",
    "server_source",
    "runner_sha256",
    "public_protocol",
    "certificate_sha256",
    "origin_identity"
  ],
  "x-p2pstream-copy-duration-relation": "descriptive-only; do not require exact equality with trace timestamps",
  "x-p2pstream-representation-budget": "512 MiB physical canonical input; NEW 4 GiB logical expanded parsed text; original 512 MiB full-text path remains rejected"
}
