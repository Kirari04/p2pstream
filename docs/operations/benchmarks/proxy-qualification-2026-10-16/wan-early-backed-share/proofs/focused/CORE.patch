+func (c *earlyShareScriptedReadConn) Read(p []byte) (int, error) {
+	if len(c.reads) == 0 {
+		return 0, io.EOF
+	}
+	next := c.reads[0]
+	c.reads = c.reads[1:]
+	if next.n > len(p) {
+		panic("test Read buffer too small")
+	}
+	return next.n, next.err
+}
