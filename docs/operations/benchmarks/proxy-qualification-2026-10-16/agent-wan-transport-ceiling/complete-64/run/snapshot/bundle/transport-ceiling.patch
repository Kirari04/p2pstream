+func (f *transportCeilingServerFixture) initializeLane(lane *transportCeilingServerLane) error {
+	if err := f.reserveWorking("session_metadata", tunnel.AggregateSessionMetadataBytes); err != nil {
+		return err
+	}
+	lane.releaseSession = f.workingReleases[len(f.workingReleases)-1]
+	if f.variant == tunnel.TransportCeilingVariantRaw {
+		if lane.lane == 0 {
+			return nil
+		}
+		if err := f.reserveWorking("relay_buffers", 2*tunnel.TransportCeilingRelayBufferBytes); err != nil {
+			return err
+		}
+		relaySide, appSide, err := tunnel.NewTransportCeilingLoopbackPair()
+		if err != nil {
+			return err
+		}
+		lane.rawApp = appSide
+		lane.rawRelay = tunnel.NewTransportCeilingRelay(lane.tlsConn, relaySide)
+		return nil
+	}
+	var config *yamux.Config
+	var err error
+	if lane.lane == 0 {
+		config, err = tunnel.NewNegotiatedControlYamuxConfig(nil, tunnel.DefaultAdaptiveReceiveWindowBytes, -1)
+	} else {
+		wire := tunnel.DefaultAggregateFlowControlConfig()
+		initialBytes := int64(yamux.AggregateReceiveWindowMemory(wire.InitialSessionWindow))
+		lane.releaseInitial, _ = f.pool.Reserve("initial_pool", initialBytes)
+		if lane.releaseInitial == nil {
+			return fmt.Errorf("reserve initial receive pool for server lane %d", lane.lane)
+		}
+		config, err = tunnel.NewAggregateYamuxConfig(nil, tunnel.DefaultMaxStreamWindowSizeBytes, -1)
+	}
+	if err != nil {
+		return err
+	}
+	lane.session, err = yamux.Server(lane.tlsConn, config)
+	if err != nil {
+		return err
+	}
+	if lane.lane > 0 {
+		lane.growth = tunnel.NewAggregateReceiveWindowGrowth(lane.session, func(bytes int64) (func(), bool) {
+			return f.pool.Reserve("growth_pool", bytes)
+		})
+	}
+	return nil
+}
+
+func (f *transportCeilingServerFixture) transfer(ctx context.Context, index int) (tunnel.TransportCeilingPhaseResult, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if index != f.nextPhase {
+		return tunnel.TransportCeilingPhaseResult{}, fmt.Errorf("phase %d requested while waiting for %d", index, f.nextPhase)
+	}
+	phase, err := tunnel.TransportCeilingPhaseAt(index)
+	if err != nil {
+		return tunnel.TransportCeilingPhaseResult{}, err
+	}
+	lane := f.lanes[phase.Lane]
+	wallStart := time.Now()
+	logical, temporary, err := f.logicalForPhase(phase)
+	if err != nil {
+		return tunnel.TransportCeilingPhaseResult{}, err
+	}
+	result, err := tunnel.RunTransportCeilingCoordinatorPhase(ctx, logical.app, phase, wallStart, transportCeilingPhaseTimeout, func() tunnel.TransportCeilingTCPInfo {
+		return tunnel.CaptureTransportCeilingTCPInfo(lane.tcpConn)
+	})
+	if err != nil {
+		return result, err
+	}
+	f.nextPhase++
+	if err := f.endpoint.RecordResult(result); err != nil {
+		return result, err
+	}
+	if temporary {
+		if err := tunnel.CloseTransportCeilingLogical(ctx, logical.app, phase, transportCeilingPhaseTimeout); err != nil {
+			return result, err
+		}
+		if err := f.closeLogical(logical); err != nil {
+			return result, err
+		}
+	}
+	if index == tunnel.TransportCeilingExpectedPhases-1 {
+		if err := f.closePersistentLogicals(ctx); err != nil {
+			return result, err
+		}
+		if f.active != 0 {
+			return result, fmt.Errorf("transport ceiling server retained logical count = %d after joined cleanup", f.active)
+		}
+		f.endpoint.SetLogicalState(0, true)
+		liveSockets, err := f.liveSocketRows()
+		if err != nil {
+			return result, err
+		}
+		if err := f.endpoint.MarkLive(liveSockets); err != nil {
+			return result, err
+		}
+	}
+	return result, nil
+}
+
+func (f *transportCeilingServerFixture) closePersistentLogicals(ctx context.Context) error {
+	lastPhaseByLane := [...]int{0, 12, 13, 14, 15}
+	for laneID := 1; laneID < tunnel.TransportCeilingPhysicalLanes; laneID++ {
+		lane := f.lanes[laneID]
+		phase, err := tunnel.TransportCeilingPhaseAt(lastPhaseByLane[laneID])
+		if err != nil {
+			return err
+		}
+		logical := lane.persistent
+		if f.variant == tunnel.TransportCeilingVariantRaw {
+			logical = &transportCeilingServerLogical{app: lane.rawApp}
+		}
+		if logical == nil || logical.app == nil {
+			return fmt.Errorf("transport ceiling retained logical lane %d is absent", laneID)
+		}
+		if err := tunnel.CloseTransportCeilingLogical(ctx, logical.app, phase, transportCeilingPhaseTimeout); err != nil {
+			return err
+		}
+		if f.variant == tunnel.TransportCeilingVariantYamux {
+			if err := f.closeLogical(logical); err != nil {
+				return err
+			}
+			lane.persistent = nil
+		} else {
+			f.active--
+			f.endpoint.SetLogicalState(f.active, false)
+		}
+	}
+	return nil
+}
+
+func (f *transportCeilingServerFixture) logicalForPhase(phase tunnel.TransportCeilingPhase) (*transportCeilingServerLogical, bool, error) {
+	lane := f.lanes[phase.Lane]
+	if f.variant == tunnel.TransportCeilingVariantRaw {
+		if f.active == 0 {
+			f.active = tunnel.TransportCeilingDataLanes
+			f.endpoint.SetLogicalState(f.active, false)
+		}
+		return &transportCeilingServerLogical{app: lane.rawApp}, false, nil
+	}
+	if phase.ReuseKind == "direction-transition" || phase.ReuseKind == "same-direction-reuse" {
+		if lane.persistent == nil {
+			return nil, false, fmt.Errorf("persistent lane %d stream is absent", phase.Lane)
+		}
+		return lane.persistent, false, nil
+	}
+	releaseMetadata, ok := f.working.Reserve("stream_metadata", tunnel.AdaptiveServerStreamOverheadBytes)
+	if !ok {
+		return nil, false, errors.New("transport ceiling server stream metadata reservation denied")
+	}
+	releaseRelay, ok := f.working.Reserve("relay_buffers", 2*tunnel.TransportCeilingRelayBufferBytes)
+	if !ok {
+		releaseMetadata()
+		return nil, false, errors.New("transport ceiling server relay buffer reservation denied")
+	}
+	releaseOwned := func() {
+		releaseRelay()
+		releaseMetadata()
+	}
+	stream, err := lane.session.Open()
+	if err != nil {
+		releaseOwned()
+		return nil, false, err
+	}
+	clearSetupDeadline, err := tunnel.SetTransportCeilingDeadline(f.ctx, stream, transportCeilingPhaseTimeout)
+	if err != nil {
+		f.retainWorkingRelease(releaseOwned)
+		_ = stream.Close()
+		return nil, false, err
+	}
+	growing := tunnel.NewAggregateGrowingConn(stream, tunnel.DefaultMaxStreamWindowSizeBytes, lane.growth)
+	request := tunnel.NewOpenRequest(fmt.Sprintf("transport-ceiling-%02d", phase.Index), "tcp", "127.0.0.1:1")
+	if err := tunnel.WriteOpenRequest(growing, request); err != nil {
+		clearSetupDeadline()
+		f.retainWorkingRelease(releaseOwned)
+		_ = growing.Close()
+		return nil, false, err
+	}
+	response, err := tunnel.ReadOpenResponse(growing)
+	if err != nil || !response.OK {
+		clearSetupDeadline()
+		f.retainWorkingRelease(releaseOwned)
+		_ = growing.Close()
+		return nil, false, fmt.Errorf("transport ceiling open response: %+v err=%v", response, err)
+	}
+	relaySide, appSide, err := tunnel.NewTransportCeilingLoopbackPair()
+	if err != nil {
+		clearSetupDeadline()
+		f.retainWorkingRelease(releaseOwned)
+		_ = growing.Close()
+		return nil, false, err
+	}
+	clearSetupDeadline()
+	relay := tunnel.NewTransportCeilingRelay(growing, relaySide)
+	logical := &transportCeilingServerLogical{app: appSide, relay: relay, releaseMetadata: releaseOwned}
+	f.active++
+	f.endpoint.SetLogicalState(f.active, false)
+	if phase.Stage != "conditioning" {
+		lane.persistent = logical
+	}
+	return logical, phase.Stage == "conditioning", nil
+}
+
+func (f *transportCeilingServerFixture) closeLogical(logical *transportCeilingServerLogical) error {
+	_ = logical.app.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 35*time.Second)
+	defer cancel()
+	if err := logical.relay.Wait(ctx); err != nil {
+		return err
+	}
+	logical.releaseMetadata()
+	f.active--
+	f.endpoint.SetLogicalState(f.active, false)
+	return nil
+}
+
+func (f *transportCeilingServerFixture) closePhysical() error {
+	var first error
+	for _, lane := range f.lanes {
+		if lane == nil {
+			continue
+		}
+		if lane.session != nil {
+			if err := lane.session.Close(); err != nil && first == nil {
+				first = err
+			}
+		}
+		if lane.rawApp != nil {
+			_ = lane.rawApp.Close()
+		}
+		if lane.tlsConn != nil {
+			_ = lane.tlsConn.Close()
+		}
+		if lane.rawRelay != nil {
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			if err := lane.rawRelay.Wait(ctx); err != nil && first == nil {
+				first = err
+			}
+			cancel()
+		}
+	}
+	if first != nil {
+		return first
+	}
+	for _, lane := range f.lanes {
+		if lane == nil {
+			continue
+		}
+		if lane.growth != nil {
+			lane.growth.Release()
+		}
+		if lane.releaseInitial != nil {
+			lane.releaseInitial()
+		}
+		if lane.releaseSession != nil {
+			lane.releaseSession()
+		}
+	}
+	return nil
+}
+
+func (f *transportCeilingServerFixture) socketRows(connected bool) []tunnel.TransportCeilingSocket {
+	rows := make([]tunnel.TransportCeilingSocket, 0, tunnel.TransportCeilingPhysicalLanes)
+	for laneID, lane := range f.lanes {
+		if lane == nil || lane.tlsConn == nil {
+			continue
+		}
+		state := lane.tlsConn.ConnectionState()
+		tcpInfo := tunnel.CaptureTransportCeilingTCPInfo(lane.tcpConn)
+		identityBytes := sha256.Sum256([]byte(fmt.Sprintf("server|%d|%s|%s|%d|%d", laneID, lane.tlsConn.LocalAddr(), lane.tlsConn.RemoteAddr(), state.Version, state.CipherSuite)))
+		role := "data"
+		if laneID == 0 {
+			role = "control"
+		}
+		rows = append(rows, tunnel.TransportCeilingSocket{Lane: laneID, LaneRole: role, LocalAddress: lane.tlsConn.LocalAddr().String(), RemoteAddress: lane.tlsConn.RemoteAddr().String(), ConnectionIdentity: fmt.Sprintf("%x", identityBytes[:16]), TLSVersion: state.Version, TLSCipherSuite: state.CipherSuite, TCPInfoCaptured: tcpInfo.Captured, TCPInfoError: tcpInfo.Error, TCPState: tcpInfo.State, Connected: connected && tcpInfo.Captured && tcpInfo.Error == "" && tcpInfo.State == tunnel.TransportCeilingTCPEstablished})
+	}
+	sort.Slice(rows, func(i, j int) bool { return rows[i].Lane < rows[j].Lane })
+	return rows
+}
+
+func (f *transportCeilingServerFixture) liveSocketRows() ([]tunnel.TransportCeilingSocket, error) {
+	rows := f.socketRows(true)
+	if len(rows) != tunnel.TransportCeilingPhysicalLanes {
+		return nil, fmt.Errorf("transport ceiling server live socket count = %d", len(rows))
+	}
+	for _, row := range rows {
+		if !row.Connected {
+			return nil, fmt.Errorf("transport ceiling server lane %d is not established: captured=%t state=%d error=%q", row.Lane, row.TCPInfoCaptured, row.TCPState, row.TCPInfoError)
+		}
+	}
+	return rows, nil
+}
+
+func TestTransportCeilingServerRoleRejectsEphemeralAddresses(t *testing.T) {
+	oldVariant, oldListen, oldAdmin, oldOutput := *transportCeilingServerVariant, *transportCeilingServerListen, *transportCeilingServerAdmin, *transportCeilingServerOutput
+	t.Cleanup(func() {
+		*transportCeilingServerVariant, *transportCeilingServerListen, *transportCeilingServerAdmin, *transportCeilingServerOutput = oldVariant, oldListen, oldAdmin, oldOutput
+	})
+	*transportCeilingServerVariant = tunnel.TransportCeilingVariantRaw
+	*transportCeilingServerListen, *transportCeilingServerAdmin, *transportCeilingServerOutput = "127.0.0.1:0", "127.0.0.1:18080", "report.json"
+	if _, err := newTransportCeilingServerFixture(); err == nil {
+		t.Fatal("ephemeral external listen address accepted")
+	}
+}
