+func newTransportCeilingAgentFixture() (*transportCeilingAgentFixture, error) {
+	if err := tunnel.ValidateTransportCeilingVariant(*transportCeilingAgentVariant); err != nil {
+		return nil, err
+	}
+	if *transportCeilingAgentServer == "" || *transportCeilingAgentAdmin == "" || *transportCeilingAgentOutput == "" {
+		return nil, errors.New("transport ceiling agent addresses and output are required")
+	}
+	for _, address := range []string{*transportCeilingAgentServer, *transportCeilingAgentAdmin} {
+		_, port, err := net.SplitHostPort(address)
+		if err != nil || port == "0" {
+			return nil, fmt.Errorf("transport ceiling address %q must have a concrete nonzero port", address)
+		}
+	}
+	if *transportCeilingAgentServerName != tunnel.TransportCeilingTLSName {
+		return nil, fmt.Errorf("transport ceiling TLS server name must be %q", tunnel.TransportCeilingTLSName)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	pool := tunnel.NewTransportCeilingLedger(tunnel.TransportCeilingPoolLimitBytes)
+	working := tunnel.NewTransportCeilingLedger(tunnel.TransportCeilingWorkingLimitBytes)
+	endpoint, err := tunnel.NewTransportCeilingEndpoint("agent", *transportCeilingAgentVariant, os.Getenv("P2PSTREAM_TRANSPORT_CEILING_SOURCE_REF"), pool, working)
+	if err != nil {
+		cancel()
+		return nil, err
+	}
+	fixture := &transportCeilingAgentFixture{ctx: ctx, cancel: cancel, variant: *transportCeilingAgentVariant, endpoint: endpoint, pool: pool, working: working}
+	return fixture, nil
+}
+
+func (f *transportCeilingAgentFixture) reserveWorking(category string, bytes int64) (func(), error) {
+	release, ok := f.working.Reserve(category, bytes)
+	if !ok {
+		return nil, fmt.Errorf("reserve transport ceiling agent %s bytes=%d", category, bytes)
+	}
+	f.mu.Lock()
+	f.workingReleases = append(f.workingReleases, release)
+	f.mu.Unlock()
+	return release, nil
+}
+
+func (f *transportCeilingAgentFixture) retainWorkingRelease(release func()) {
+	if release == nil {
+		return
+	}
+	f.mu.Lock()
+	f.workingReleases = append(f.workingReleases, release)
+	f.mu.Unlock()
+}
+
+func (f *transportCeilingAgentFixture) run() error {
+	for _, category := range []string{"session_metadata", "stream_metadata", "relay_buffers", "frame_buffers", "tls_app_buffers"} {
+		if _, err := f.reserveWorking(category, 0); err != nil {
+			return err
+		}
+	}
+	if _, err := f.reserveWorking("frame_buffers", tunnel.TransportCeilingDownloadWriteBytes+2*tunnel.TransportCeilingFrameHeaderBytes); err != nil {
+		return err
+	}
+	caPEM, err := os.ReadFile(*transportCeilingAgentCA)
+	if err != nil {
+		return err
+	}
+	roots := x509.NewCertPool()
+	if !roots.AppendCertsFromPEM(caPEM) {
+		return errors.New("transport ceiling CA file contains no certificate")
+	}
+	authKey, err := tunnel.ReadTransportCeilingAuthKey(*transportCeilingAgentAuth)
+	if err != nil {
+		return err
+	}
+	tlsConfig := &tls.Config{RootCAs: roots, ServerName: *transportCeilingAgentServerName, MinVersion: tls.VersionTLS12, NextProtos: []string{"http/1.1"}}
+	for laneID := 0; laneID < tunnel.TransportCeilingPhysicalLanes; laneID++ {
+		raw, dialErr := (&net.Dialer{Timeout: 10 * time.Second, KeepAlive: 30 * time.Second}).DialContext(f.ctx, "tcp", *transportCeilingAgentServer)
+		if dialErr != nil {
+			return dialErr
+		}
+		tlsConn := tls.Client(raw, tlsConfig.Clone())
+		handshakeCtx, cancel := context.WithTimeout(f.ctx, 10*time.Second)
+		handshakeErr := tlsConn.HandshakeContext(handshakeCtx)
+		cancel()
+		if handshakeErr != nil {
+			_ = raw.Close()
+			return handshakeErr
+		}
+		if err := tunnel.AuthenticateTransportCeilingClient(tlsConn, authKey, f.variant, laneID, 10*time.Second); err != nil {
+			_ = tlsConn.Close()
+			return err
+		}
+		tcpConn, ok := tlsConn.NetConn().(*net.TCPConn)
+		if !ok {
+			_ = tlsConn.Close()
+			return fmt.Errorf("transport ceiling TLS underlying connection is %T", tlsConn.NetConn())
+		}
+		lane := &transportCeilingAgentLane{lane: laneID, tlsConn: tlsConn, tcpConn: tcpConn}
+		f.lanes[laneID] = lane
+		if err := f.initializeLane(lane); err != nil {
+			return err
+		}
+	}
+	readySockets, err := f.liveSocketRows()
+	if err != nil {
+		return err
+	}
+	f.endpoint.SetReady(readySockets)
+	adminListener, err := net.Listen("tcp", *transportCeilingAgentAdmin)
+	if err != nil {
+		return err
+	}
+	f.admin = &http.Server{Handler: f.endpoint, ReadHeaderTimeout: 2 * time.Second}
+	adminDone := make(chan error, 1)
+	go func() { adminDone <- f.admin.Serve(adminListener) }()
+	physicalDone := make(chan struct{})
+	go func() { f.physicalWG.Wait(); close(physicalDone) }()
+	select {
+	case <-physicalDone:
+	case <-f.ctx.Done():
+		for _, lane := range f.lanes {
+			if lane == nil {
+				continue
+			}
+			if lane.session != nil {
+				_ = lane.session.Close()
+			}
+			if lane.tlsConn != nil {
+				_ = lane.tlsConn.Close()
+			}
+		}
+		select {
+		case <-physicalDone:
+		case <-time.After(35 * time.Second):
+			return errors.New("transport ceiling agent physical relays did not join after cancellation")
+		}
+	}
+	f.cancel()
+	shutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	_ = f.admin.Shutdown(shutdownCtx)
+	cancel()
+	handlersDone := make(chan struct{})
+	go func() { f.handlerWG.Wait(); close(handlersDone) }()
+	select {
+	case <-handlersDone:
+	case <-time.After(35 * time.Second):
+		return errors.New("transport ceiling agent logical handlers did not join")
+	}
+	relaysDone := make(chan struct{})
+	go func() { f.relayWG.Wait(); close(relaysDone) }()
+	select {
+	case <-relaysDone:
+	case <-time.After(35 * time.Second):
+		return errors.New("transport ceiling agent stream relays did not join")
+	}
+	if err := f.closePhysical(); err != nil {
+		return err
+	}
+	f.mu.Lock()
+	releases := append([]func(){}, f.workingReleases...)
+	f.mu.Unlock()
+	for index := len(releases) - 1; index >= 0; index-- {
+		releases[index]()
+	}
+	report := f.endpoint.Terminal(f.socketRows(false), true)
+	if err := tunnel.WriteTransportCeilingReport(*transportCeilingAgentOutput, report); err != nil {
+		return err
+	}
+	select {
+	case serveErr := <-adminDone:
+		if serveErr != nil && serveErr != http.ErrServerClosed {
+			return serveErr
+		}
+	case <-time.After(5 * time.Second):
+		return errors.New("transport ceiling agent admin did not stop")
+	}
+	if report.InvalidReason != "" || report.PoolLedger.FinalBytes != 0 || report.WorkingLedger.FinalBytes != 0 {
+		return fmt.Errorf("invalid transport ceiling agent terminal report: %s", report.InvalidReason)
+	}
+	return nil
+}
+
+func (f *transportCeilingAgentFixture) initializeLane(lane *transportCeilingAgentLane) error {
+	releaseSession, err := f.reserveWorking("session_metadata", tunnel.AggregateSessionMetadataBytes)
+	if err != nil {
+		return err
+	}
+	lane.releaseSession = releaseSession
+	if f.variant == tunnel.TransportCeilingVariantRaw {
+		if lane.lane == 0 {
+			f.physicalWG.Add(1)
+			go func() {
+				defer f.physicalWG.Done()
+				_, _ = io.Copy(io.Discard, lane.tlsConn)
+			}()
+			return nil
+		}
+		if _, err := f.reserveWorking("relay_buffers", 2*tunnel.TransportCeilingRelayBufferBytes); err != nil {
+			return err
+		}
+		relaySide, appSide, err := tunnel.NewTransportCeilingLoopbackPair()
+		if err != nil {
+			return err
+		}
+		lane.rawApp = appSide
+		lane.relayDone = make(chan error, 1)
+		f.physicalWG.Add(1)
+		go func() {
+			defer f.physicalWG.Done()
+			_, _, relayErr := relayTunnelStream(f.ctx, lane.tlsConn, relaySide)
+			lane.relayDone <- relayErr
+		}()
+		f.startRawPeer(lane)
+		return nil
+	}
+	var config *yamux.Config
+	if lane.lane == 0 {
+		config, err = tunnel.NewNegotiatedControlYamuxConfig(nil, tunnel.DefaultAdaptiveReceiveWindowBytes, tunnel.NegotiatedControlStreamLimit)
+	} else {
+		wire := tunnel.DefaultAggregateFlowControlConfig()
+		initialBytes := int64(yamux.AggregateReceiveWindowMemory(wire.InitialSessionWindow))
+		lane.releaseInitial, _ = f.pool.Reserve("initial_pool", initialBytes)
+		if lane.releaseInitial == nil {
+			return fmt.Errorf("reserve initial receive pool for agent lane %d", lane.lane)
+		}
+		config, err = tunnel.NewAggregateYamuxConfig(nil, tunnel.DefaultMaxStreamWindowSizeBytes, 16)
+	}
+	if err != nil {
+		return err
+	}
+	lane.session, err = yamux.Client(lane.tlsConn, config)
+	if err != nil {
+		return err
+	}
+	if lane.lane > 0 {
+		lane.growth = tunnel.NewAggregateReceiveWindowGrowth(lane.session, func(bytes int64) (func(), bool) {
+			return f.pool.Reserve("growth_pool", bytes)
+		})
+		f.handlerWG.Add(1)
+		go f.acceptLane(lane)
+	}
+	f.physicalWG.Add(1)
+	go func() {
+		defer f.physicalWG.Done()
+		<-lane.session.CloseChan()
+	}()
+	return nil
+}
+
+func (f *transportCeilingAgentFixture) startRawPeer(lane *transportCeilingAgentLane) {
+	f.mu.Lock()
+	f.activeLogical++
+	f.endpoint.SetLogicalState(f.activeLogical, false)
+	f.mu.Unlock()
+	f.handlerWG.Add(1)
+	go func() {
+		defer f.handlerWG.Done()
+		for {
+			result, err := tunnel.ServeTransportCeilingPeerPhase(f.ctx, lane.rawApp, &f.sequencer, transportCeilingPhaseTimeout, func() tunnel.TransportCeilingTCPInfo {
+				return tunnel.CaptureTransportCeilingTCPInfo(lane.tcpConn)
+			})
+			if errors.Is(err, io.EOF) {
+				break
+			}
+			if err != nil {
+				f.endpoint.MarkInvalid(err)
+				f.cancel()
+				return
+			}
+			if err := f.endpoint.RecordResult(result); err != nil {
+				f.endpoint.MarkInvalid(err)
+				f.cancel()
+				return
+			}
+		}
+		f.logicalFinished()
+	}()
+}
+
+func (f *transportCeilingAgentFixture) acceptLane(lane *transportCeilingAgentLane) {
+	defer f.handlerWG.Done()
+	for {
+		conn, err := lane.session.Accept()
+		if err != nil {
+			f.handleAcceptLaneError(err)
+			return
+		}
+		f.handlerWG.Add(1)
+		go f.handleLogical(lane, conn)
+	}
+}
+
+func (f *transportCeilingAgentFixture) handleAcceptLaneError(err error) {
+	if errors.Is(err, yamux.ErrSessionShutdown) {
+		return
+	}
+	f.mu.Lock()
+	expectedEOF := errors.Is(err, io.EOF) &&
+		f.post16Live &&
+		f.logicalJoined &&
+		f.activeLogical == 0 &&
+		f.sequencer.Completed() == tunnel.TransportCeilingExpectedPhases
+	f.mu.Unlock()
+	if expectedEOF {
+		return
+	}
+	f.endpoint.MarkInvalid(err)
+	f.cancel()
+}
+
+func (f *transportCeilingAgentFixture) handleLogical(lane *transportCeilingAgentLane, conn net.Conn) {
+	defer f.handlerWG.Done()
+	growing := tunnel.NewAggregateGrowingConn(conn, tunnel.DefaultMaxStreamWindowSizeBytes, lane.growth)
+	clearSetupDeadline, deadlineErr := tunnel.SetTransportCeilingDeadline(f.ctx, growing, transportCeilingPhaseTimeout)
+	if deadlineErr != nil {
+		_ = growing.Close()
+		f.endpoint.MarkInvalid(deadlineErr)
+		f.cancel()
+		return
+	}
+	request, err := tunnel.ReadOpenRequest(growing)
+	if err != nil || request.Address != "127.0.0.1:1" {
+		clearSetupDeadline()
+		_ = growing.Close()
+		f.endpoint.MarkInvalid(fmt.Errorf("transport ceiling open request: %+v err=%v", request, err))
+		f.cancel()
+		return
+	}
+	releaseMetadata, ok := f.working.Reserve("stream_metadata", tunnel.AdaptiveServerStreamOverheadBytes)
+	if !ok {
+		clearSetupDeadline()
+		_ = growing.Close()
+		f.endpoint.MarkInvalid(errors.New("transport ceiling agent stream metadata reservation denied"))
+		f.cancel()
+		return
+	}
+	releaseRelay, ok := f.working.Reserve("relay_buffers", 2*tunnel.TransportCeilingRelayBufferBytes)
+	if !ok {
+		clearSetupDeadline()
+		f.retainWorkingRelease(releaseMetadata)
+		_ = growing.Close()
+		f.endpoint.MarkInvalid(errors.New("transport ceiling agent relay buffer reservation denied"))
+		f.cancel()
+		return
+	}
+	relaySide, appSide, err := tunnel.NewTransportCeilingLoopbackPair()
+	if err != nil {
+		clearSetupDeadline()
+		f.retainWorkingRelease(releaseRelay)
+		f.retainWorkingRelease(releaseMetadata)
+		_ = growing.Close()
+		f.endpoint.MarkInvalid(err)
+		f.cancel()
+		return
+	}
+	if err := tunnel.WriteOpenResponse(growing, tunnel.OpenResponse{OK: true}); err != nil {
+		clearSetupDeadline()
+		_ = appSide.Close()
+		_ = relaySide.Close()
+		f.retainWorkingRelease(releaseRelay)
+		f.retainWorkingRelease(releaseMetadata)
+		_ = growing.Close()
+		f.endpoint.MarkInvalid(err)
+		f.cancel()
+		return
+	}
+	clearSetupDeadline()
+	f.mu.Lock()
+	f.activeLogical++
+	f.endpoint.SetLogicalState(f.activeLogical, false)
+	f.mu.Unlock()
+	relayDone := make(chan error, 1)
+	f.relayWG.Add(1)
+	go func() {
+		defer f.relayWG.Done()
+		_, _, relayErr := relayTunnelStream(f.ctx, growing, relaySide)
+		relayDone <- relayErr
+	}()
+	for {
+		result, phaseErr := tunnel.ServeTransportCeilingPeerPhase(f.ctx, appSide, &f.sequencer, transportCeilingPhaseTimeout, func() tunnel.TransportCeilingTCPInfo {
+			return tunnel.CaptureTransportCeilingTCPInfo(lane.tcpConn)
+		})
+		if errors.Is(phaseErr, io.EOF) {
+			break
+		}
+		if phaseErr != nil {
+			f.endpoint.MarkInvalid(phaseErr)
+			f.cancel()
+			break
+		}
+		if err := f.endpoint.RecordResult(result); err != nil {
+			f.endpoint.MarkInvalid(err)
+			f.cancel()
+			break
+		}
+	}
+	_ = appSide.Close()
+	select {
+	case relayErr := <-relayDone:
+		if relayErr != nil {
+			f.endpoint.MarkInvalid(relayErr)
+		}
+	case <-time.After(35 * time.Second):
+		f.endpoint.MarkInvalid(errors.New("transport ceiling agent logical relay did not join"))
+		f.retainWorkingRelease(releaseRelay)
+		f.retainWorkingRelease(releaseMetadata)
+		f.cancel()
+		return
+	}
+	releaseRelay()
+	releaseMetadata()
+	f.logicalFinished()
+}
+
+func (f *transportCeilingAgentFixture) logicalFinished() {
+	f.mu.Lock()
+	f.activeLogical--
+	active := f.activeLogical
+	completed := f.sequencer.Completed()
+	if active == 0 && completed == tunnel.TransportCeilingExpectedPhases && !f.logicalJoined {
+		f.logicalJoined = true
+		f.endpoint.SetLogicalState(0, true)
+		liveSockets, err := f.liveSocketRows()
+		if err == nil {
+			err = f.endpoint.MarkLive(liveSockets)
+		}
+		if err != nil {
+			f.endpoint.MarkInvalid(err)
+			f.cancel()
+		} else {
+			// Session EOF becomes an expected server-driven shutdown only after
+			// the post-phase-16 state and the five live sockets were published.
+			f.post16Live = true
+		}
+	} else {
+		f.endpoint.SetLogicalState(active, false)
+	}
+	f.mu.Unlock()
+}
+
+func (f *transportCeilingAgentFixture) closePhysical() error {
+	var first error
+	for _, lane := range f.lanes {
+		if lane == nil {
+			continue
+		}
+		if lane.session != nil {
+			if err := lane.session.Close(); err != nil && first == nil {
+				first = err
+			}
+		}
+		if lane.rawApp != nil {
+			_ = lane.rawApp.Close()
+		}
+		if lane.tlsConn != nil {
+			_ = lane.tlsConn.Close()
+		}
+	}
+	if first != nil {
+		return first
+	}
+	for _, lane := range f.lanes {
+		if lane == nil {
+			continue
+		}
+		if lane.growth != nil {
+			lane.growth.Release()
+		}
+		if lane.releaseInitial != nil {
+			lane.releaseInitial()
+		}
+		if lane.releaseSession != nil {
+			lane.releaseSession()
+		}
+	}
+	return nil
+}
+
+func (f *transportCeilingAgentFixture) socketRows(connected bool) []tunnel.TransportCeilingSocket {
+	rows := make([]tunnel.TransportCeilingSocket, 0, tunnel.TransportCeilingPhysicalLanes)
+	for laneID, lane := range f.lanes {
+		if lane == nil || lane.tlsConn == nil {
+			continue
+		}
+		state := lane.tlsConn.ConnectionState()
+		tcpInfo := tunnel.CaptureTransportCeilingTCPInfo(lane.tcpConn)
+		identityBytes := sha256.Sum256([]byte(fmt.Sprintf("agent|%d|%s|%s|%d|%d", laneID, lane.tlsConn.LocalAddr(), lane.tlsConn.RemoteAddr(), state.Version, state.CipherSuite)))
+		role := "data"
+		if laneID == 0 {
+			role = "control"
+		}
+		rows = append(rows, tunnel.TransportCeilingSocket{Lane: laneID, LaneRole: role, LocalAddress: lane.tlsConn.LocalAddr().String(), RemoteAddress: lane.tlsConn.RemoteAddr().String(), ConnectionIdentity: fmt.Sprintf("%x", identityBytes[:16]), TLSVersion: state.Version, TLSCipherSuite: state.CipherSuite, TCPInfoCaptured: tcpInfo.Captured, TCPInfoError: tcpInfo.Error, TCPState: tcpInfo.State, Connected: connected && tcpInfo.Captured && tcpInfo.Error == "" && tcpInfo.State == tunnel.TransportCeilingTCPEstablished})
+	}
+	sort.Slice(rows, func(i, j int) bool { return rows[i].Lane < rows[j].Lane })
+	return rows
+}
+
+func (f *transportCeilingAgentFixture) liveSocketRows() ([]tunnel.TransportCeilingSocket, error) {
+	rows := f.socketRows(true)
+	if len(rows) != tunnel.TransportCeilingPhysicalLanes {
+		return nil, fmt.Errorf("transport ceiling agent live socket count = %d", len(rows))
+	}
+	for _, row := range rows {
+		if !row.Connected {
+			return nil, fmt.Errorf("transport ceiling agent lane %d is not established: captured=%t state=%d error=%q", row.Lane, row.TCPInfoCaptured, row.TCPState, row.TCPInfoError)
+		}
+	}
+	return rows, nil
+}
