+
+func (e *TransportCeilingEndpoint) RecordResult(result TransportCeilingPhaseResult) error {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if result.PhaseIndex != len(e.report.Results) {
+		return fmt.Errorf("record phase %d while waiting for %d", result.PhaseIndex, len(e.report.Results))
+	}
+	e.report.Results = append(e.report.Results, result)
+	e.report.CompletedPhases = len(e.report.Results)
+	return nil
+}
+
+func (e *TransportCeilingEndpoint) MarkLive(sockets []TransportCeilingSocket) error {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if len(e.report.Results) != TransportCeilingExpectedPhases || e.report.ActiveLogicalStreams != 0 || !e.report.JoinedLogicalRelays {
+		return errors.New("transport ceiling endpoint cannot become live-post16 before logical cleanup")
+	}
+	for _, socket := range sockets {
+		if !socket.Connected {
+			return fmt.Errorf("transport ceiling lane %d is not connected at live-post16", socket.Lane)
+		}
+	}
+	e.report.PhysicalSockets = slices.Clone(sockets)
+	e.report.PhysicalSocketsTerminal = slices.Clone(sockets)
+	e.report.SameSocketIdentities = transportCeilingSameSocketIdentities(e.report.PhysicalSocketsInitial, sockets)
+	if !e.report.SameSocketIdentities {
+		return errors.New("transport ceiling live-post16 physical socket identities changed")
+	}
+	e.live = true
+	return nil
+}
+
+func (e *TransportCeilingEndpoint) MarkInvalid(err error) {
+	if err == nil {
+		return
+	}
+	e.mu.Lock()
+	e.report.InvalidReason = err.Error()
+	e.report.Errors = append(e.report.Errors, err.Error())
+	e.mu.Unlock()
+}
+
+func (e *TransportCeilingEndpoint) snapshot() TransportCeilingReport {
+	e.mu.Lock()
+	report := e.report
+	report.PhysicalSockets = slices.Clone(e.report.PhysicalSockets)
+	report.PhysicalSocketsInitial = slices.Clone(e.report.PhysicalSocketsInitial)
+	report.PhysicalSocketsTerminal = slices.Clone(e.report.PhysicalSocketsTerminal)
+	report.Results = slices.Clone(e.report.Results)
+	report.Errors = slices.Clone(e.report.Errors)
+	e.mu.Unlock()
+	report.PoolLedger = e.pool.Snapshot(false)
+	report.WorkingLedger = e.working.Snapshot(false)
+	_ = CaptureTransportCeilingProcessResources(&report.WorkingLedger)
+	return report
+}
+
+func (e *TransportCeilingEndpoint) Terminal(sockets []TransportCeilingSocket, joined bool) TransportCeilingReport {
+	e.mu.Lock()
+	e.report.Ready = false
+	e.report.GracefulShutdown = true
+	e.report.PhysicalSockets = nil
+	e.report.PhysicalSocketsTerminal = slices.Clone(sockets)
+	e.report.JoinedPhysicalRelays = joined
+	e.report.SameSocketIdentities = transportCeilingSameSocketIdentities(e.report.PhysicalSocketsInitial, sockets)
+	report := e.report
+	report.PhysicalSocketsInitial = slices.Clone(e.report.PhysicalSocketsInitial)
+	report.PhysicalSocketsTerminal = slices.Clone(e.report.PhysicalSocketsTerminal)
+	report.Results = slices.Clone(e.report.Results)
+	report.Errors = slices.Clone(e.report.Errors)
+	e.mu.Unlock()
+	report.PoolLedger = e.pool.Snapshot(true)
+	report.WorkingLedger = e.working.Snapshot(true)
+	_ = CaptureTransportCeilingProcessResources(&report.WorkingLedger)
+	return report
+}
+
+func transportCeilingSameSocketIdentities(initial, final []TransportCeilingSocket) bool {
+	if len(initial) != TransportCeilingPhysicalLanes || len(final) != len(initial) {
+		return false
+	}
+	for index := range initial {
+		a, b := initial[index], final[index]
+		if a.Lane != b.Lane || a.LaneRole != b.LaneRole || a.LocalAddress != b.LocalAddress || a.RemoteAddress != b.RemoteAddress || a.ConnectionIdentity != b.ConnectionIdentity || a.TLSVersion != b.TLSVersion || a.TLSCipherSuite != b.TLSCipherSuite {
+			return false
+		}
+	}
+	return true
+}
+
+func (e *TransportCeilingEndpoint) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Content-Type", "application/json")
+	switch r.URL.Path {
+	case "/transport-ceiling/readiness":
+		if r.Method != http.MethodGet {
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		_ = json.NewEncoder(w).Encode(e.snapshot())
+	case "/transport-ceiling/live-post16":
+		if r.Method != http.MethodGet {
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		e.mu.Lock()
+		live := e.live
+		e.mu.Unlock()
+		if !live {
+			http.Error(w, "logical cleanup incomplete", http.StatusConflict)
+			return
+		}
+		_ = json.NewEncoder(w).Encode(e.snapshot())
+	case "/transport-ceiling/transfer":
+		if r.Method != http.MethodPost {
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		e.mu.Lock()
+		transfer := e.transfer
+		e.mu.Unlock()
+		if transfer == nil {
+			http.NotFound(w, r)
+			return
+		}
+		var request struct {
+			SchemaVersion int `json:"schema_version"`
+			PhaseIndex    int `json:"phase_index"`
+		}
+		decoder := json.NewDecoder(http.MaxBytesReader(w, r.Body, 1024))
+		decoder.DisallowUnknownFields()
+		if err := decoder.Decode(&request); err != nil || request.SchemaVersion != TransportCeilingSchemaVersion {
+			http.Error(w, "invalid transfer request", http.StatusBadRequest)
+			return
+		}
+		result, err := transfer(r.Context(), request.PhaseIndex)
+		if err != nil {
+			e.MarkInvalid(err)
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		_ = json.NewEncoder(w).Encode(result)
+	case "/transport-ceiling/shutdown":
+		if r.Method != http.MethodPost {
+			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+			return
+		}
+		e.mu.Lock()
+		shutdown, live := e.shutdown, e.live
+		e.mu.Unlock()
+		if shutdown == nil {
+			http.NotFound(w, r)
+			return
+		}
+		if !live {
+			http.Error(w, "live-post16 not reached", http.StatusConflict)
+			return
+		}
+		w.WriteHeader(http.StatusAccepted)
+		_, _ = w.Write([]byte("{\"schema_version\":1}\n"))
+		go shutdown()
+	default:
+		http.NotFound(w, r)
+	}
+}
+
+func (r *TransportCeilingReport) CaptureHeap() {
+	var stats runtime.MemStats
+	runtime.ReadMemStats(&stats)
+	r.WorkingLedger.ActualHeapAllocBytes = stats.HeapAlloc
+}
+
+func CaptureTransportCeilingProcessResources(snapshot *TransportCeilingLedgerSnapshot) error {
+	if snapshot == nil {
+		return errors.New("nil transport ceiling working-ledger snapshot")
+	}
+	var stats runtime.MemStats
+	runtime.ReadMemStats(&stats)
+	entries, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		return err
+	}
+	sockets := 0
+	for _, entry := range entries {
+		target, readErr := os.Readlink("/proc/self/fd/" + entry.Name())
+		if readErr == nil && strings.HasPrefix(target, "socket:[") {
+			sockets++
+		}
+	}
+	snapshot.ActualHeapAllocBytes = stats.HeapAlloc
+	snapshot.ActualOpenFDs = len(entries)
+	snapshot.ActualSocketFDs = sockets
+	return nil
+}
+
+func WriteTransportCeilingReport(path string, report TransportCeilingReport) error {
+	if path == "" {
+		return errors.New("transport ceiling output path is empty")
+	}
+	encoded, err := json.MarshalIndent(report, "", "  ")
+	if err != nil {
+		return err
+	}
+	encoded = append(encoded, '\n')
+	temporary := path + ".tmp"
+	if err := os.WriteFile(temporary, encoded, 0o600); err != nil {
+		return err
+	}
+	return os.Rename(temporary, path)
+}
+
+func SetTransportCeilingDeadline(ctx context.Context, conn net.Conn, maximum time.Duration) (func(), error) {
+	if conn == nil {
+		return nil, errors.New("nil transport ceiling connection")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	deadline := time.Now().Add(maximum)
+	if contextDeadline, ok := ctx.Deadline(); ok && contextDeadline.Before(deadline) {
+		deadline = contextDeadline
+	}
+	if err := conn.SetDeadline(deadline); err != nil {
+		return nil, err
+	}
+	callbackDone := make(chan struct{})
+	stop := context.AfterFunc(ctx, func() {
+		_ = conn.SetDeadline(time.Now())
+		close(callbackDone)
+	})
+	var cleanupOnce sync.Once
+	return func() {
+		cleanupOnce.Do(func() {
+			if !stop() {
+				// A started cancellation callback owns the terminal deadline. Join
+				// it and leave that expired deadline intact so cleanup cannot
+				// clobber cancellation or a following phase's deadline.
+				<-callbackDone
+				return
+			}
+			_ = conn.SetDeadline(time.Time{})
+			if ctx.Err() != nil {
+				// Cancellation may race a successful stop. Preserve an expired
+				// deadline whenever cancellation is observable before return.
+				_ = conn.SetDeadline(time.Now())
+			}
+		})
+	}, nil
+}
+
+type TransportCeilingRelay struct {
+	once    sync.Once
+	done    chan struct{}
+	err     atomic.Pointer[error]
+	closing atomic.Bool
+	left    net.Conn
+	right   net.Conn
+}
+
+func NewTransportCeilingRelay(left, right net.Conn) *TransportCeilingRelay {
+	relay := &TransportCeilingRelay{done: make(chan struct{}), left: left, right: right}
+	go func() {
+		defer close(relay.done)
+		type result struct{ err error }
+		results := make(chan result, 2)
+		copyOne := func(destination, source net.Conn) {
+			buffer := make([]byte, TransportCeilingRelayBufferBytes)
+			_, err := io.CopyBuffer(destination, source, buffer)
+			results <- result{err: err}
+		}
+		go copyOne(left, right)
+		go copyOne(right, left)
+		first := <-results
+		_ = left.SetDeadline(time.Now())
+		_ = right.SetDeadline(time.Now())
+		_ = left.Close()
+		_ = right.Close()
+		second := <-results
+		if first.err != nil && !errors.Is(first.err, net.ErrClosed) && !(relay.closing.Load() && isTransportCeilingTimeout(first.err)) {
+			relay.err.Store(&first.err)
+		} else if second.err != nil && !errors.Is(second.err, net.ErrClosed) && !isTransportCeilingTimeout(second.err) {
+			relay.err.Store(&second.err)
+		}
+	}()
+	return relay
+}
+
+func isTransportCeilingTimeout(err error) bool {
+	var netErr net.Error
+	return errors.As(err, &netErr) && netErr.Timeout()
+}
+
+func (r *TransportCeilingRelay) Close() {
+	if r == nil {
+		return
+	}
+	r.once.Do(func() {
+		r.closing.Store(true)
+		_ = r.left.SetDeadline(time.Now())
+		_ = r.right.SetDeadline(time.Now())
+		_ = r.left.Close()
+		_ = r.right.Close()
+	})
+}
+
+func (r *TransportCeilingRelay) Wait(ctx context.Context) error {
+	select {
+	case <-r.done:
+		if err := r.err.Load(); err != nil {
+			return *err
+		}
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
