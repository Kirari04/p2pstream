+type TransportCeilingLedger struct {
+	mu         sync.Mutex
+	limit      int64
+	current    int64
+	highWater  int64
+	initial    int64
+	growth     int64
+	denied     int64
+	releases   int64
+	categories map[string]int64
+}
+
+func NewTransportCeilingLedger(limit int64) *TransportCeilingLedger {
+	return &TransportCeilingLedger{limit: limit, categories: make(map[string]int64)}
+}
+
+func (l *TransportCeilingLedger) Reserve(category string, bytes int64) (func(), bool) {
+	if l == nil || bytes < 0 || category == "" {
+		return nil, false
+	}
+	l.mu.Lock()
+	if bytes == 0 {
+		if _, exists := l.categories[category]; !exists {
+			l.categories[category] = 0
+		}
+		l.mu.Unlock()
+		return func() {}, true
+	}
+	if bytes > l.limit-l.current {
+		l.denied++
+		l.mu.Unlock()
+		return nil, false
+	}
+	l.current += bytes
+	l.highWater = max(l.highWater, l.current)
+	l.categories[category] += bytes
+	if category == "initial_pool" {
+		l.initial += bytes
+	} else if category == "growth_pool" {
+		l.growth += bytes
+	}
+	l.mu.Unlock()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			l.mu.Lock()
+			l.current -= bytes
+			l.categories[category] -= bytes
+			l.releases++
+			l.mu.Unlock()
+		})
+	}, true
+}
+
+func (l *TransportCeilingLedger) Snapshot(final bool) TransportCeilingLedgerSnapshot {
+	if l == nil {
+		return TransportCeilingLedgerSnapshot{}
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	categories := make(map[string]int64, len(l.categories))
+	for key, value := range l.categories {
+		categories[key] = value
+	}
+	snapshot := TransportCeilingLedgerSnapshot{
+		LimitBytes: l.limit, InitialReservedBytes: l.initial, GrowthReservedBytes: l.growth,
+		CurrentBytes: l.current, HighWaterBytes: l.highWater, DeniedReservations: l.denied,
+		ReleaseCount: l.releases, Categories: categories,
+	}
+	if final {
+		snapshot.FinalBytes = l.current
+	}
+	return snapshot
+}
