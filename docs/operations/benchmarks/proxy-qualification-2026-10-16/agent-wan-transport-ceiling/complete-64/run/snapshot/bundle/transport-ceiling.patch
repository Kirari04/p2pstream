+type transportCeilingDeadlineGateConn struct {
+	net.Conn
+	started chan struct{}
+	release chan struct{}
+	once    sync.Once
+	mu      sync.Mutex
+	last    time.Time
+}
+
+func (c *transportCeilingDeadlineGateConn) SetDeadline(deadline time.Time) error {
+	if !deadline.IsZero() && time.Until(deadline) < 100*time.Millisecond {
+		c.once.Do(func() { close(c.started) })
+		<-c.release
+	}
+	c.mu.Lock()
+	c.last = deadline
+	c.mu.Unlock()
+	return c.Conn.SetDeadline(deadline)
+}
+
+func TestTransportCeilingDeadlineCleanupJoinsStartedCancellation(t *testing.T) {
+	left, right := net.Pipe()
+	defer left.Close()
+	defer right.Close()
+	conn := &transportCeilingDeadlineGateConn{Conn: left, started: make(chan struct{}), release: make(chan struct{})}
+	var releaseOnce sync.Once
+	releaseGate := func() { releaseOnce.Do(func() { close(conn.release) }) }
+	defer releaseGate()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	cleanup, err := SetTransportCeilingDeadline(ctx, conn, time.Minute)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	select {
+	case <-conn.started:
+	case <-time.After(time.Second):
+		t.Fatal("cancellation callback did not start")
+	}
+	cleanupDone := make(chan struct{})
+	go func() { cleanup(); close(cleanupDone) }()
+	select {
+	case <-cleanupDone:
+		t.Fatal("cleanup returned before the cancellation callback completed")
+	case <-time.After(20 * time.Millisecond):
+	}
+	releaseGate()
+	select {
+	case <-cleanupDone:
+	case <-time.After(time.Second):
+		t.Fatal("cleanup did not join the cancellation callback")
+	}
+	conn.mu.Lock()
+	last := conn.last
+	conn.mu.Unlock()
+	if last.IsZero() || time.Until(last) > 100*time.Millisecond {
+		t.Fatalf("cleanup cleared cancellation deadline: %v", last)
+	}
+
+	canceled, cancelCanceled := context.WithCancel(context.Background())
+	cancelCanceled()
+	if _, err := SetTransportCeilingDeadline(canceled, conn, time.Minute); !errors.Is(err, context.Canceled) {
+		t.Fatalf("already canceled context error = %v, want context canceled", err)
+	}
+}
+
+func TestTransportCeilingRelayCancellationAndJoinedClose(t *testing.T) {
+	leftClient, leftRelay := net.Pipe()
+	rightRelay, rightClient := net.Pipe()
+	relay := NewTransportCeilingRelay(leftRelay, rightRelay)
+	payload := []byte("relay-payload")
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := leftClient.Write(payload)
+		writeDone <- err
+	}()
+	got := make([]byte, len(payload))
+	if _, err := io.ReadFull(rightClient, got); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, payload) {
+		t.Fatalf("relayed payload = %q, want %q", got, payload)
+	}
+	if err := <-writeDone; err != nil {
+		t.Fatal(err)
+	}
+	relay.Close()
+	_ = leftClient.Close()
+	_ = rightClient.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if err := relay.Wait(ctx); err != nil && !errors.Is(err, io.ErrClosedPipe) {
+		t.Fatalf("relay wait = %v", err)
+	}
+}
+
+func TestTransportCeilingTCPInfoPostTransferSnapshot(t *testing.T) {
+	client, server, err := NewTransportCeilingLoopbackPair()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	defer server.Close()
+	deadline := time.Now().Add(time.Second)
+	if err := client.SetDeadline(deadline); err != nil {
+		t.Fatal(err)
+	}
+	if err := server.SetDeadline(deadline); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := client.Write([]byte("tcp-info")); err != nil {
+		t.Fatal(err)
+	}
+	buffer := make([]byte, len("tcp-info"))
+	if _, err := io.ReadFull(server, buffer); err != nil {
+		t.Fatal(err)
+	}
+	info := CaptureTransportCeilingTCPInfo(client)
+	if !info.Captured || info.Error != "" || info.LocalAddress == "" || info.RemoteAddress == "" || info.SendMSS == 0 {
+		t.Fatalf("TCP_INFO = %+v", info)
+	}
+	if info.AppLimitedAvailable {
+		t.Fatal("TCP_INFO unexpectedly claimed portable app_limited support")
+	}
+}
+
+func TestTransportCeilingEstablishedTCPRejectsClosedIdlePeer(t *testing.T) {
+	client, server, err := NewTransportCeilingLoopbackPair()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer client.Close()
+	if err := ValidateTransportCeilingEstablishedTCP(client); err != nil {
+		t.Fatalf("live connection rejected: %v", err)
+	}
+	if err := server.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := client.SetReadDeadline(time.Now().Add(time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	var one [1]byte
+	if _, err := client.Read(one[:]); err == nil {
+		t.Fatal("closed idle peer did not produce EOF/error")
+	}
+	if err := ValidateTransportCeilingEstablishedTCP(client); err == nil {
+		t.Fatal("closed idle peer reported ESTABLISHED")
+	}
+}
