+func newTransportCeilingServerFixture() (*transportCeilingServerFixture, error) {
+	if err := tunnel.ValidateTransportCeilingVariant(*transportCeilingServerVariant); err != nil {
+		return nil, err
+	}
+	if *transportCeilingServerListen == "" || *transportCeilingServerAdmin == "" || *transportCeilingServerOutput == "" {
+		return nil, fmt.Errorf("transport ceiling server addresses and output are required")
+	}
+	if os.Getenv("P2PSTREAM_TRANSPORT_CEILING_SOURCE_REF") == "" {
+		return nil, fmt.Errorf("P2PSTREAM_TRANSPORT_CEILING_SOURCE_REF is required")
+	}
+	for _, address := range []string{*transportCeilingServerListen, *transportCeilingServerAdmin} {
+		_, port, err := net.SplitHostPort(address)
+		if err != nil || port == "0" {
+			return nil, fmt.Errorf("transport ceiling address %q must have a concrete nonzero port", address)
+		}
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	pool := tunnel.NewTransportCeilingLedger(tunnel.TransportCeilingPoolLimitBytes)
+	working := tunnel.NewTransportCeilingLedger(tunnel.TransportCeilingWorkingLimitBytes)
+	fixture := &transportCeilingServerFixture{ctx: ctx, cancel: cancel, variant: *transportCeilingServerVariant, pool: pool, working: working}
+	endpoint, err := tunnel.NewTransportCeilingEndpoint("server", fixture.variant, os.Getenv("P2PSTREAM_TRANSPORT_CEILING_SOURCE_REF"), pool, working)
+	if err != nil {
+		cancel()
+		return nil, err
+	}
+	fixture.endpoint = endpoint
+	fixture.endpoint.SetCallbacks(fixture.transfer, fixture.cancel)
+	return fixture, nil
