+//go:build linux && p2pstream_transport_ceiling
+
+package tunnel
+
+// This file belongs to a temporary, test-build-only transport ceiling
+// diagnostic. The dedicated build tag deliberately differs from
+// p2pstream_qualification so the existing DATA counters and growth trace stay
+// compiled out. Nothing in this file is part of a production binary.
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/tls"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"runtime"
+	"slices"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const (
+	TransportCeilingSchemaVersion      = 1
+	TransportCeilingPhysicalLanes      = 5
+	TransportCeilingDataLanes          = 4
+	TransportCeilingExpectedPhases     = 16
+	TransportCeilingPayloadBytes       = int64(256 << 20)
+	TransportCeilingPoolLimitBytes     = int64(2 << 30)
+	TransportCeilingWorkingLimitBytes  = int64(64 << 20)
+	TransportCeilingRelayBufferBytes   = 32 << 10
+	TransportCeilingDownloadWriteBytes = 35 * 1024
+	TransportCeilingDownloadReadBytes  = 8 << 10
+	TransportCeilingUploadBufferBytes  = 32 << 10
+	TransportCeilingFrameHeaderBytes   = 64
+	TransportCeilingMaxFrameBodyBytes  = 4096
+	TransportCeilingAuthKeyBytes       = 32
+	TransportCeilingTLSName            = "transport-ceiling.test"
+	// Linux TCP_INFO reports TCP_ESTABLISHED as state 1. x/sys/unix does not
+	// export the internal Linux TCP state enum.
+	TransportCeilingTCPEstablished = uint8(1)
+	// The fixed payload algorithm repeats byte((index*131+17)%251) over a
+	// 1024-byte period. Download and upload use the same exact 256 MiB stream.
+	TransportCeilingPayloadSHA256 = "ad818ce955253fd9030cbefa352527321b308cfc574cb4bbee9cbcd0d4930790"
+)
+
+const (
+	TransportCeilingVariantYamux = "aggregate-yamux"
+	TransportCeilingVariantRaw   = "raw-tls"
+)
+
+const (
+	transportCeilingFrameStart uint8 = iota + 1
+	transportCeilingFrameReady
+	transportCeilingFrameComplete
+	transportCeilingFrameAck
+	transportCeilingFrameLogicalClose
+	transportCeilingFrameLogicalCloseAck
+	transportCeilingFrameTiming
+	transportCeilingFrameTimingAck
+)
+
+var transportCeilingFrameMagic = [8]byte{'P', '2', 'P', 'T', 'C', '0', '0', '1'}
+var transportCeilingAuthMagic = [8]byte{'P', '2', 'P', 'T', 'C', 'A', '0', '1'}
+
+const transportCeilingAuthPacketBytes = 80
+
+type TransportCeilingPhase struct {
+	Index     int    `json:"phase_index"`
+	Name      string `json:"phase_name"`
+	Lane      int    `json:"lane"`
+	Direction string `json:"direction"`
+	Stage     string `json:"stage"`
+	ReuseKind string `json:"reuse_kind"`
+}
+
+var TransportCeilingPhases = [...]TransportCeilingPhase{
+	{0, "conditioning-download-lane-1", 1, "download", "conditioning", "fresh-stream"},
+	{1, "conditioning-download-lane-2", 2, "download", "conditioning", "fresh-stream"},
+	{2, "conditioning-download-lane-3", 3, "download", "conditioning", "fresh-stream"},
+	{3, "conditioning-download-lane-4", 4, "download", "conditioning", "fresh-stream"},
+	{4, "conditioning-upload-lane-1", 1, "upload", "conditioning", "fresh-stream"},
+	{5, "conditioning-upload-lane-2", 2, "upload", "conditioning", "fresh-stream"},
+	{6, "conditioning-upload-lane-3", 3, "upload", "conditioning", "fresh-stream"},
+	{7, "conditioning-upload-lane-4", 4, "upload", "conditioning", "fresh-stream"},
+	{8, "retained-download-lane-1", 1, "download", "retained", "new-persistent"},
+	{9, "retained-upload-lane-2", 2, "upload", "retained", "new-persistent"},
+	{10, "timed-1-download-lane-3", 3, "download", "timed", "new-persistent"},
+	{11, "timed-1-upload-lane-4", 4, "upload", "timed", "new-persistent"},
+	{12, "timed-2-upload-lane-1", 1, "upload", "timed", "direction-transition"},
+	{13, "timed-2-download-lane-2", 2, "download", "timed", "direction-transition"},
+	{14, "timed-3-download-lane-3", 3, "download", "timed", "same-direction-reuse"},
+	{15, "timed-3-upload-lane-4", 4, "upload", "timed", "same-direction-reuse"},
+}
+
+func TransportCeilingPhaseAt(index int) (TransportCeilingPhase, error) {
+	if index < 0 || index >= len(TransportCeilingPhases) {
+		return TransportCeilingPhase{}, fmt.Errorf("transport ceiling phase %d is out of range", index)
+	}
+	return TransportCeilingPhases[index], nil
+}
+
+func ValidateTransportCeilingVariant(variant string) error {
+	switch variant {
+	case TransportCeilingVariantYamux, TransportCeilingVariantRaw:
+		return nil
+	default:
+		return fmt.Errorf("unknown transport ceiling variant %q", variant)
+	}
+}
+
+func ReadTransportCeilingAuthKey(path string) ([]byte, error) {
+	encoded, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	trimmed := strings.TrimSpace(string(encoded))
+	if len(trimmed) != 2*TransportCeilingAuthKeyBytes || strings.IndexFunc(trimmed, func(r rune) bool {
+		return r == ' ' || r == '\t' || r == '\r' || r == '\n'
+	}) >= 0 {
+		return nil, errors.New("transport ceiling auth key must be exactly 64 hexadecimal characters")
+	}
+	key, err := hex.DecodeString(trimmed)
+	if err != nil || len(key) != TransportCeilingAuthKeyBytes {
+		return nil, errors.New("transport ceiling auth key must encode exactly 32 bytes")
+	}
+	return key, nil
+}
+
+func transportCeilingVariantByte(variant string) (byte, error) {
+	switch variant {
+	case TransportCeilingVariantYamux:
+		return 1, nil
+	case TransportCeilingVariantRaw:
+		return 2, nil
+	default:
+		return 0, fmt.Errorf("unknown transport ceiling variant %q", variant)
+	}
+}
+
+func AuthenticateTransportCeilingClient(conn net.Conn, key []byte, variant string, lane int, timeout time.Duration) error {
+	variantByte, err := transportCeilingVariantByte(variant)
+	if err != nil {
+		return err
+	}
+	if len(key) != TransportCeilingAuthKeyBytes || lane < 0 || lane >= TransportCeilingPhysicalLanes {
+		return errors.New("invalid transport ceiling client authentication input")
+	}
+	if err := conn.SetDeadline(time.Now().Add(timeout)); err != nil {
+		return err
+	}
+	defer conn.SetDeadline(time.Time{})
+	var request [transportCeilingAuthPacketBytes]byte
+	copy(request[:8], transportCeilingAuthMagic[:])
+	binary.BigEndian.PutUint16(request[8:10], TransportCeilingSchemaVersion)
+	request[10], request[11] = variantByte, byte(lane)
+	if _, err := rand.Read(request[12:44]); err != nil {
+		return err
+	}
+	mac := hmac.New(sha256.New, key)
+	_, _ = mac.Write(request[:44])
+	copy(request[44:76], mac.Sum(nil))
+	if err := writeTransportCeilingAll(conn, request[:]); err != nil {
+		return err
+	}
+	var response [transportCeilingAuthPacketBytes]byte
+	if _, err := io.ReadFull(conn, response[:]); err != nil {
+		return err
+	}
+	if !slices.Equal(response[:44], request[:44]) {
+		return errors.New("transport ceiling authentication response mismatch")
+	}
+	mac.Reset()
+	_, _ = mac.Write([]byte("server-ack"))
+	_, _ = mac.Write(response[:44])
+	if !hmac.Equal(response[44:76], mac.Sum(nil)) || binary.BigEndian.Uint32(response[76:80]) != 0 {
+		return errors.New("transport ceiling authentication response MAC mismatch")
+	}
+	return nil
+}
+
+func AuthenticateTransportCeilingServer(conn net.Conn, key []byte, expectedVariant string, timeout time.Duration) (int, error) {
+	expectedVariantByte, err := transportCeilingVariantByte(expectedVariant)
+	if err != nil {
+		return 0, err
+	}
+	if len(key) != TransportCeilingAuthKeyBytes {
+		return 0, errors.New("invalid transport ceiling server authentication key")
+	}
+	if err := conn.SetDeadline(time.Now().Add(timeout)); err != nil {
+		return 0, err
+	}
+	defer conn.SetDeadline(time.Time{})
+	var request [transportCeilingAuthPacketBytes]byte
+	if _, err := io.ReadFull(conn, request[:]); err != nil {
+		return 0, err
+	}
+	if !slices.Equal(request[:8], transportCeilingAuthMagic[:]) || binary.BigEndian.Uint16(request[8:10]) != TransportCeilingSchemaVersion || request[10] != expectedVariantByte || request[11] >= TransportCeilingPhysicalLanes || binary.BigEndian.Uint32(request[76:80]) != 0 {
+		return 0, errors.New("invalid transport ceiling authentication request")
+	}
+	mac := hmac.New(sha256.New, key)
+	_, _ = mac.Write(request[:44])
+	if !hmac.Equal(request[44:76], mac.Sum(nil)) {
+		return 0, errors.New("transport ceiling authentication request MAC mismatch")
+	}
+	response := request
+	mac.Reset()
+	_, _ = mac.Write([]byte("server-ack"))
+	_, _ = mac.Write(response[:44])
+	copy(response[44:76], mac.Sum(nil))
+	if err := writeTransportCeilingAll(conn, response[:]); err != nil {
+		return 0, err
+	}
+	return int(request[11]), nil
+}
+
+type transportCeilingFrame struct {
+	Op        uint8
+	Direction uint8
+	Phase     uint16
+	Lane      uint16
+	Sequence  uint32
+	Length    uint64
+	Digest    [sha256.Size]byte
+}
+
+type TransportCeilingPeerPhase struct {
+	PhaseIndex           int    `json:"phase_index"`
+	Lane                 int    `json:"lane"`
+	Direction            string `json:"direction"`
+	ReceivedPayloadBytes int64  `json:"received_payload_bytes"`
+	ExpectedSHA256       string `json:"expected_sha256"`
+	ReceivedSHA256       string `json:"received_sha256"`
+}
+
+type TransportCeilingPhaseSequencer struct {
+	mu   sync.Mutex
+	next int
+}
+
+func (s *TransportCeilingPhaseSequencer) Accept(index int) error {
+	if s == nil {
+		return errors.New("nil transport ceiling phase sequencer")
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if index != s.next {
+		return fmt.Errorf("transport ceiling phase %d arrived while waiting for %d", index, s.next)
+	}
+	s.next++
+	return nil
+}
+
+func (s *TransportCeilingPhaseSequencer) Completed() int {
+	if s == nil {
+		return 0
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.next
+}
+
+func writeTransportCeilingFrame(w io.Writer, frame transportCeilingFrame) error {
+	var header [TransportCeilingFrameHeaderBytes]byte
+	copy(header[:8], transportCeilingFrameMagic[:])
+	binary.BigEndian.PutUint16(header[8:10], TransportCeilingSchemaVersion)
+	header[10] = frame.Op
+	header[11] = frame.Direction
+	binary.BigEndian.PutUint16(header[12:14], frame.Phase)
+	binary.BigEndian.PutUint16(header[14:16], frame.Lane)
+	binary.BigEndian.PutUint32(header[16:20], frame.Sequence)
+	binary.BigEndian.PutUint64(header[20:28], frame.Length)
+	copy(header[28:60], frame.Digest[:])
+	return writeTransportCeilingAll(w, header[:])
+}
+
+func writeTransportCeilingAll(w io.Writer, data []byte) error {
+	for len(data) > 0 {
+		n, err := w.Write(data)
+		if n > 0 {
+			data = data[n:]
+		}
+		if err != nil {
+			return err
+		}
+		if n == 0 {
+			return io.ErrShortWrite
+		}
+	}
+	return nil
+}
+
+func readTransportCeilingFrame(r io.Reader) (transportCeilingFrame, error) {
+	var header [TransportCeilingFrameHeaderBytes]byte
+	if _, err := io.ReadFull(r, header[:]); err != nil {
+		return transportCeilingFrame{}, err
+	}
+	if !slices.Equal(header[:8], transportCeilingFrameMagic[:]) {
+		return transportCeilingFrame{}, errors.New("transport ceiling frame magic mismatch")
+	}
+	if version := binary.BigEndian.Uint16(header[8:10]); version != TransportCeilingSchemaVersion {
+		return transportCeilingFrame{}, fmt.Errorf("transport ceiling frame version %d is unsupported", version)
+	}
+	if binary.BigEndian.Uint32(header[60:64]) != 0 {
+		return transportCeilingFrame{}, errors.New("transport ceiling frame reserved bytes are nonzero")
+	}
+	frame := transportCeilingFrame{
+		Op:        header[10],
+		Direction: header[11],
+		Phase:     binary.BigEndian.Uint16(header[12:14]),
+		Lane:      binary.BigEndian.Uint16(header[14:16]),
+		Sequence:  binary.BigEndian.Uint32(header[16:20]),
+		Length:    binary.BigEndian.Uint64(header[20:28]),
+	}
+	copy(frame.Digest[:], header[28:60])
+	if frame.Lane < 1 || frame.Lane > TransportCeilingDataLanes {
+		return transportCeilingFrame{}, fmt.Errorf("transport ceiling frame lane %d is invalid", frame.Lane)
+	}
+	if frame.Phase >= TransportCeilingExpectedPhases {
+		return transportCeilingFrame{}, fmt.Errorf("transport ceiling frame phase %d is invalid", frame.Phase)
+	}
+	if frame.Length > uint64(TransportCeilingPayloadBytes) {
+		return transportCeilingFrame{}, fmt.Errorf("transport ceiling frame length %d exceeds the fixed payload bound", frame.Length)
+	}
+	return frame, nil
+}
+
+func transportCeilingDirection(direction string) (uint8, error) {
+	switch direction {
+	case "download":
+		return 1, nil
+	case "upload":
+		return 2, nil
+	default:
+		return 0, fmt.Errorf("unknown transport ceiling direction %q", direction)
+	}
+}
+
+func validateTransportCeilingFrame(frame transportCeilingFrame, op uint8, phase TransportCeilingPhase, length uint64, digest [sha256.Size]byte) error {
+	direction, err := transportCeilingDirection(phase.Direction)
+	if err != nil {
+		return err
+	}
+	if frame.Op != op || frame.Direction != direction || int(frame.Phase) != phase.Index || int(frame.Lane) != phase.Lane || frame.Sequence != uint32(phase.Index) || frame.Length != length || frame.Digest != digest {
+		return fmt.Errorf("unexpected transport ceiling frame for phase %d: op=%d direction=%d phase=%d lane=%d sequence=%d length=%d digest=%x", phase.Index, frame.Op, frame.Direction, frame.Phase, frame.Lane, frame.Sequence, frame.Length, frame.Digest)
+	}
+	return nil
+}
+
+func makeTransportCeilingFrame(op uint8, phase TransportCeilingPhase, length uint64, digest [sha256.Size]byte) (transportCeilingFrame, error) {
+	direction, err := transportCeilingDirection(phase.Direction)
+	if err != nil {
+		return transportCeilingFrame{}, err
+	}
+	return transportCeilingFrame{Op: op, Direction: direction, Phase: uint16(phase.Index), Lane: uint16(phase.Lane), Sequence: uint32(phase.Index), Length: length, Digest: digest}, nil
+}
+
+// RunTransportCeilingCoordinatorPhase executes one fixed phase. wallStart must
+// be captured before any per-phase Yamux Open/OpenRequest work. The returned
+// wall duration ends at the exact completion ACK; stream cleanup and TCP_INFO
+// sampling deliberately occur later.
+func RunTransportCeilingCoordinatorPhase(ctx context.Context, conn net.Conn, phase TransportCeilingPhase, wallStart time.Time, timeout time.Duration, postTransfer func() TransportCeilingTCPInfo) (TransportCeilingPhaseResult, error) {
+	result := TransportCeilingPhaseResult{
+		SchemaVersion: TransportCeilingSchemaVersion, PhaseIndex: phase.Index, PhaseName: phase.Name,
+		Lane: phase.Lane, Direction: phase.Direction, Stage: phase.Stage, ReuseKind: phase.ReuseKind,
+		ConfiguredPayloadBytes: TransportCeilingPayloadBytes,
+	}
+	clearDeadline, err := SetTransportCeilingDeadline(ctx, conn, timeout)
+	if err != nil {
+		return result, err
+	}
+	defer clearDeadline()
+	expected := TransportCeilingPayloadDigest(TransportCeilingPayloadBytes)
+	start, err := makeTransportCeilingFrame(transportCeilingFrameStart, phase, uint64(TransportCeilingPayloadBytes), expected)
+	if err != nil {
+		return result, err
+	}
+	if err := writeTransportCeilingFrame(conn, start); err != nil {
+		return result, fmt.Errorf("write phase start: %w", err)
+	}
+	ready, err := readTransportCeilingFrame(conn)
+	if err != nil {
+		return result, fmt.Errorf("read phase ready: %w", err)
+	}
+	if err := validateTransportCeilingFrame(ready, transportCeilingFrameReady, phase, 0, [sha256.Size]byte{}); err != nil {
+		return result, err
+	}
+	payloadStart := time.Now()
+	var received [sha256.Size]byte
+	if phase.Direction == "download" {
+		received, err = readTransportCeilingPayload(conn, TransportCeilingPayloadBytes, TransportCeilingDownloadReadBytes)
+		if err != nil {
+			return result, fmt.Errorf("read download payload: %w", err)
+		}
+		complete, readErr := readTransportCeilingFrame(conn)
+		if readErr != nil {
+			return result, fmt.Errorf("read download completion: %w", readErr)
+		}
+		if err := validateTransportCeilingFrame(complete, transportCeilingFrameComplete, phase, uint64(TransportCeilingPayloadBytes), received); err != nil {
+			return result, err
+		}
+	} else {
+		received, err = writeTransportCeilingPayload(conn, TransportCeilingPayloadBytes, TransportCeilingUploadBufferBytes)
+		if err != nil {
+			return result, fmt.Errorf("write upload payload: %w", err)
+		}
+		complete, makeErr := makeTransportCeilingFrame(transportCeilingFrameComplete, phase, uint64(TransportCeilingPayloadBytes), received)
+		if makeErr != nil {
+			return result, makeErr
+		}
+		if err := writeTransportCeilingFrame(conn, complete); err != nil {
+			return result, fmt.Errorf("write upload completion: %w", err)
+		}
+	}
+	if received != expected {
+		return result, fmt.Errorf("phase %d payload digest = %x, want %x", phase.Index, received, expected)
+	}
+	if phase.Direction == "download" {
+		ack, makeErr := makeTransportCeilingFrame(transportCeilingFrameAck, phase, uint64(TransportCeilingPayloadBytes), received)
+		if makeErr != nil {
+			return result, makeErr
+		}
+		if err := writeTransportCeilingFrame(conn, ack); err != nil {
+			return result, fmt.Errorf("write download ACK: %w", err)
+		}
+	} else {
+		ack, readErr := readTransportCeilingFrame(conn)
+		if readErr != nil {
+			return result, fmt.Errorf("read upload ACK: %w", readErr)
+		}
+		if err := validateTransportCeilingFrame(ack, transportCeilingFrameAck, phase, uint64(TransportCeilingPayloadBytes), received); err != nil {
+			return result, err
+		}
+	}
+	finished := time.Now()
+	result.ReceivedPayloadBytes = TransportCeilingPayloadBytes
+	result.ExpectedSHA256 = hex.EncodeToString(expected[:])
+	result.ReceivedSHA256 = hex.EncodeToString(received[:])
+	result.SetupNanoseconds = payloadStart.Sub(wallStart).Nanoseconds()
+	result.PayloadCompletionNanoseconds = finished.Sub(payloadStart).Nanoseconds()
+	result.PhaseWallNanoseconds = finished.Sub(wallStart).Nanoseconds()
+	if result.PhaseWallNanoseconds > 0 {
+		result.UsefulBytesPerSecond = float64(TransportCeilingPayloadBytes) / (float64(result.PhaseWallNanoseconds) / float64(time.Second))
+	}
+	if postTransfer != nil {
+		result.TCPInfo = postTransfer()
+	}
+	var timingDigest [sha256.Size]byte
+	binary.BigEndian.PutUint64(timingDigest[0:8], uint64(result.PhaseWallNanoseconds))
+	binary.BigEndian.PutUint64(timingDigest[8:16], uint64(result.SetupNanoseconds))
+	binary.BigEndian.PutUint64(timingDigest[16:24], uint64(result.PayloadCompletionNanoseconds))
+	timing, err := makeTransportCeilingFrame(transportCeilingFrameTiming, phase, uint64(TransportCeilingPayloadBytes), timingDigest)
+	if err != nil {
+		return result, err
+	}
+	if err := writeTransportCeilingFrame(conn, timing); err != nil {
+		return result, fmt.Errorf("write phase timing: %w", err)
+	}
+	timingAck, err := readTransportCeilingFrame(conn)
+	if err != nil {
+		return result, fmt.Errorf("read phase timing ACK: %w", err)
+	}
+	if err := validateTransportCeilingFrame(timingAck, transportCeilingFrameTimingAck, phase, 0, [sha256.Size]byte{}); err != nil {
+		return result, err
+	}
+	return result, nil
+}
+
+// ServeTransportCeilingPeerPhase executes the peer half of one frame phase.
+// A single raw peer calls this repeatedly on one persistent connection; a
+// Yamux peer calls it on the stream selected by the fixed plan.
+func ServeTransportCeilingPeerPhase(ctx context.Context, conn net.Conn, sequencer *TransportCeilingPhaseSequencer, timeout time.Duration, postTransfer func() TransportCeilingTCPInfo) (TransportCeilingPhaseResult, error) {
+	clearDeadline, err := SetTransportCeilingDeadline(ctx, conn, timeout)
+	if err != nil {
+		return TransportCeilingPhaseResult{}, err
+	}
+	defer clearDeadline()
+	start, err := readTransportCeilingFrame(conn)
+	if err != nil {
+		return TransportCeilingPhaseResult{}, err
+	}
+	phase, err := TransportCeilingPhaseAt(int(start.Phase))
+	if err != nil {
+		return TransportCeilingPhaseResult{}, err
+	}
+	if start.Op == transportCeilingFrameLogicalClose {
+		if err := validateTransportCeilingFrame(start, transportCeilingFrameLogicalClose, phase, 0, [sha256.Size]byte{}); err != nil {
+			return TransportCeilingPhaseResult{}, err
+		}
+		ack, makeErr := makeTransportCeilingFrame(transportCeilingFrameLogicalCloseAck, phase, 0, [sha256.Size]byte{})
+		if makeErr != nil {
+			return TransportCeilingPhaseResult{}, makeErr
+		}
+		if err := writeTransportCeilingFrame(conn, ack); err != nil {
+			return TransportCeilingPhaseResult{}, err
+		}
+		return TransportCeilingPhaseResult{}, io.EOF
+	}
+	expected := TransportCeilingPayloadDigest(TransportCeilingPayloadBytes)
+	if err := validateTransportCeilingFrame(start, transportCeilingFrameStart, phase, uint64(TransportCeilingPayloadBytes), expected); err != nil {
+		return TransportCeilingPhaseResult{}, err
+	}
+	if err := sequencer.Accept(phase.Index); err != nil {
+		return TransportCeilingPhaseResult{}, err
+	}
+	ready, err := makeTransportCeilingFrame(transportCeilingFrameReady, phase, 0, [sha256.Size]byte{})
+	if err != nil {
+		return TransportCeilingPhaseResult{}, err
+	}
+	if err := writeTransportCeilingFrame(conn, ready); err != nil {
+		return TransportCeilingPhaseResult{}, err
+	}
+	var received [sha256.Size]byte
+	if phase.Direction == "download" {
+		received, err = writeTransportCeilingPayload(conn, TransportCeilingPayloadBytes, TransportCeilingDownloadWriteBytes)
+		if err != nil {
+			return TransportCeilingPhaseResult{}, err
+		}
+		complete, makeErr := makeTransportCeilingFrame(transportCeilingFrameComplete, phase, uint64(TransportCeilingPayloadBytes), received)
+		if makeErr != nil {
+			return TransportCeilingPhaseResult{}, makeErr
+		}
+		if err := writeTransportCeilingFrame(conn, complete); err != nil {
+			return TransportCeilingPhaseResult{}, err
+		}
+		ack, readErr := readTransportCeilingFrame(conn)
+		if readErr != nil {
+			return TransportCeilingPhaseResult{}, readErr
+		}
+		if err := validateTransportCeilingFrame(ack, transportCeilingFrameAck, phase, uint64(TransportCeilingPayloadBytes), received); err != nil {
+			return TransportCeilingPhaseResult{}, err
+		}
+	} else {
+		received, err = readTransportCeilingPayload(conn, TransportCeilingPayloadBytes, TransportCeilingUploadBufferBytes)
+		if err != nil {
+			return TransportCeilingPhaseResult{}, err
+		}
+		complete, readErr := readTransportCeilingFrame(conn)
+		if readErr != nil {
+			return TransportCeilingPhaseResult{}, readErr
+		}
+		if err := validateTransportCeilingFrame(complete, transportCeilingFrameComplete, phase, uint64(TransportCeilingPayloadBytes), received); err != nil {
+			return TransportCeilingPhaseResult{}, err
+		}
+		ack, makeErr := makeTransportCeilingFrame(transportCeilingFrameAck, phase, uint64(TransportCeilingPayloadBytes), received)
+		if makeErr != nil {
+			return TransportCeilingPhaseResult{}, makeErr
+		}
+		if err := writeTransportCeilingFrame(conn, ack); err != nil {
+			return TransportCeilingPhaseResult{}, err
+		}
+	}
+	if received != expected {
+		return TransportCeilingPhaseResult{}, fmt.Errorf("phase %d peer digest = %x, want %x", phase.Index, received, expected)
+	}
+	result := TransportCeilingPhaseResult{
+		SchemaVersion: TransportCeilingSchemaVersion, PhaseIndex: phase.Index, PhaseName: phase.Name,
+		Lane: phase.Lane, Direction: phase.Direction, Stage: phase.Stage, ReuseKind: phase.ReuseKind,
+		ConfiguredPayloadBytes: TransportCeilingPayloadBytes, ReceivedPayloadBytes: TransportCeilingPayloadBytes,
+		ExpectedSHA256: hex.EncodeToString(expected[:]), ReceivedSHA256: hex.EncodeToString(received[:]),
+	}
+	if postTransfer != nil {
+		result.TCPInfo = postTransfer()
+	}
+	timing, err := readTransportCeilingFrame(conn)
+	if err != nil {
+		return TransportCeilingPhaseResult{}, fmt.Errorf("read phase timing: %w", err)
+	}
+	if timing.Op != transportCeilingFrameTiming || timing.Direction != start.Direction || timing.Phase != start.Phase || timing.Lane != start.Lane || timing.Sequence != start.Sequence || timing.Length != uint64(TransportCeilingPayloadBytes) {
+		return TransportCeilingPhaseResult{}, errors.New("invalid transport ceiling timing frame")
+	}
+	result.PhaseWallNanoseconds = int64(binary.BigEndian.Uint64(timing.Digest[0:8]))
+	result.SetupNanoseconds = int64(binary.BigEndian.Uint64(timing.Digest[8:16]))
+	result.PayloadCompletionNanoseconds = int64(binary.BigEndian.Uint64(timing.Digest[16:24]))
+	if result.PhaseWallNanoseconds <= 0 || result.SetupNanoseconds < 0 || result.PayloadCompletionNanoseconds <= 0 || result.SetupNanoseconds+result.PayloadCompletionNanoseconds != result.PhaseWallNanoseconds {
+		return TransportCeilingPhaseResult{}, errors.New("invalid transport ceiling timing values")
+	}
+	result.UsefulBytesPerSecond = float64(TransportCeilingPayloadBytes) / (float64(result.PhaseWallNanoseconds) / float64(time.Second))
+	timingAck, err := makeTransportCeilingFrame(transportCeilingFrameTimingAck, phase, 0, [sha256.Size]byte{})
+	if err != nil {
+		return TransportCeilingPhaseResult{}, err
+	}
+	if err := writeTransportCeilingFrame(conn, timingAck); err != nil {
+		return TransportCeilingPhaseResult{}, err
+	}
+	return result, nil
+}
+
+func CloseTransportCeilingLogical(ctx context.Context, conn net.Conn, phase TransportCeilingPhase, timeout time.Duration) error {
+	clearDeadline, err := SetTransportCeilingDeadline(ctx, conn, timeout)
+	if err != nil {
+		return err
+	}
+	defer clearDeadline()
+	closeFrame, err := makeTransportCeilingFrame(transportCeilingFrameLogicalClose, phase, 0, [sha256.Size]byte{})
+	if err != nil {
+		return err
+	}
+	if err := writeTransportCeilingFrame(conn, closeFrame); err != nil {
+		return err
+	}
+	ack, err := readTransportCeilingFrame(conn)
+	if err != nil {
+		return err
+	}
+	return validateTransportCeilingFrame(ack, transportCeilingFrameLogicalCloseAck, phase, 0, [sha256.Size]byte{})
+}
+
+func AcceptTransportCeilingLogicalClose(conn net.Conn, phase TransportCeilingPhase) error {
+	closeFrame, err := readTransportCeilingFrame(conn)
+	if err != nil {
+		return err
+	}
+	if err := validateTransportCeilingFrame(closeFrame, transportCeilingFrameLogicalClose, phase, 0, [sha256.Size]byte{}); err != nil {
+		return err
+	}
+	ack, err := makeTransportCeilingFrame(transportCeilingFrameLogicalCloseAck, phase, 0, [sha256.Size]byte{})
+	if err != nil {
+		return err
+	}
+	return writeTransportCeilingFrame(conn, ack)
+}
+
+var transportCeilingPayloadBlock = func() []byte {
+	block := make([]byte, TransportCeilingDownloadWriteBytes)
+	for i := range block {
+		// Both production-facing chunk sizes are multiples of 1024. A 1024-byte
+		// period keeps the exact byte stream invariant when either relay splits a
+		// write differently.
+		block[i] = byte((uint64(i%1024)*131 + 17) % 251)
+	}
+	return block
+}()
+
+var transportCeilingFixedPayloadDigest = transportCeilingPayloadDigest(TransportCeilingPayloadBytes)
+
+func TransportCeilingPayloadDigest(size int64) [sha256.Size]byte {
+	if size == TransportCeilingPayloadBytes {
+		return transportCeilingFixedPayloadDigest
+	}
+	return transportCeilingPayloadDigest(size)
+}
+
+func transportCeilingPayloadDigest(size int64) [sha256.Size]byte {
+	h := sha256.New()
+	remaining := size
+	for remaining > 0 {
+		n := min(remaining, int64(len(transportCeilingPayloadBlock)))
+		_, _ = h.Write(transportCeilingPayloadBlock[:n])
+		remaining -= n
+	}
+	var digest [sha256.Size]byte
+	copy(digest[:], h.Sum(nil))
+	return digest
+}
+
+func writeTransportCeilingPayload(w io.Writer, size int64, chunkSize int) ([sha256.Size]byte, error) {
+	if size < 0 || size > TransportCeilingPayloadBytes || chunkSize < 1 || chunkSize > len(transportCeilingPayloadBlock) {
+		return [sha256.Size]byte{}, errors.New("invalid transport ceiling payload write bound")
+	}
+	h := sha256.New()
+	remaining := size
+	for remaining > 0 {
+		n := min(remaining, int64(chunkSize))
+		chunk := transportCeilingPayloadBlock[:n]
+		if err := writeTransportCeilingAll(w, chunk); err != nil {
+			return [sha256.Size]byte{}, err
+		}
+		_, _ = h.Write(chunk)
+		remaining -= n
+	}
+	var digest [sha256.Size]byte
+	copy(digest[:], h.Sum(nil))
+	return digest, nil
+}
+
+func readTransportCeilingPayload(r io.Reader, size int64, chunkSize int) ([sha256.Size]byte, error) {
+	if size < 0 || size > TransportCeilingPayloadBytes || chunkSize < 1 {
+		return [sha256.Size]byte{}, errors.New("invalid transport ceiling payload read bound")
+	}
+	h := sha256.New()
+	buffer := make([]byte, chunkSize)
+	remaining := size
+	for remaining > 0 {
+		n := min(remaining, int64(len(buffer)))
+		if _, err := io.ReadFull(r, buffer[:n]); err != nil {
+			return [sha256.Size]byte{}, err
+		}
+		_, _ = h.Write(buffer[:n])
+		remaining -= n
+	}
+	var digest [sha256.Size]byte
+	copy(digest[:], h.Sum(nil))
+	return digest, nil
+}
