+func (f *transportCeilingServerFixture) run() error {
+	for _, category := range []string{"session_metadata", "stream_metadata", "relay_buffers", "frame_buffers", "tls_app_buffers"} {
+		if err := f.reserveWorking(category, 0); err != nil {
+			return err
+		}
+	}
+	if err := f.reserveWorking("frame_buffers", tunnel.TransportCeilingDownloadWriteBytes+2*tunnel.TransportCeilingFrameHeaderBytes); err != nil {
+		return err
+	}
+	certificate, err := tls.LoadX509KeyPair(*transportCeilingServerCert, *transportCeilingServerKey)
+	if err != nil {
+		return err
+	}
+	authKey, err := tunnel.ReadTransportCeilingAuthKey(*transportCeilingServerAuth)
+	if err != nil {
+		return err
+	}
+	baseListener, err := net.Listen("tcp", *transportCeilingServerListen)
+	if err != nil {
+		return err
+	}
+	f.listener = baseListener
+	defer baseListener.Close()
+	tlsConfig := &tls.Config{Certificates: []tls.Certificate{certificate}, MinVersion: tls.VersionTLS12, NextProtos: []string{"http/1.1"}}
+	for len(f.socketRows(true)) < tunnel.TransportCeilingPhysicalLanes {
+		raw, acceptErr := baseListener.Accept()
+		if acceptErr != nil {
+			return acceptErr
+		}
+		if err := raw.SetDeadline(time.Now().Add(10 * time.Second)); err != nil {
+			_ = raw.Close()
+			return err
+		}
+		tlsConn := tls.Server(raw, tlsConfig)
+		if err := tlsConn.HandshakeContext(f.ctx); err != nil {
+			_ = raw.Close()
+			return err
+		}
+		if err := raw.SetDeadline(time.Time{}); err != nil {
+			_ = tlsConn.Close()
+			return err
+		}
+		lane, err := tunnel.AuthenticateTransportCeilingServer(tlsConn, authKey, f.variant, 10*time.Second)
+		if err != nil {
+			_ = tlsConn.Close()
+			return err
+		}
+		if f.lanes[lane] != nil {
+			_ = tlsConn.Close()
+			return fmt.Errorf("duplicate transport ceiling lane %d", lane)
+		}
+		tcpConn, ok := tlsConn.NetConn().(*net.TCPConn)
+		if !ok {
+			_ = tlsConn.Close()
+			return fmt.Errorf("transport ceiling TLS underlying connection is %T", tlsConn.NetConn())
+		}
+		entry := &transportCeilingServerLane{lane: lane, tlsConn: tlsConn, tcpConn: tcpConn}
+		f.lanes[lane] = entry
+		if err := f.initializeLane(entry); err != nil {
+			return err
+		}
+	}
+	_ = baseListener.Close()
+	readySockets, err := f.liveSocketRows()
+	if err != nil {
+		return err
+	}
+	f.endpoint.SetReady(readySockets)
+	adminListener, err := net.Listen("tcp", *transportCeilingServerAdmin)
+	if err != nil {
+		return err
+	}
+	f.admin = &http.Server{Handler: f.endpoint, ReadHeaderTimeout: 2 * time.Second}
+	adminDone := make(chan error, 1)
+	go func() { adminDone <- f.admin.Serve(adminListener) }()
+	<-f.ctx.Done()
+	shutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	_ = f.admin.Shutdown(shutdownCtx)
+	cancel()
+	if err := f.closePhysical(); err != nil {
+		return err
+	}
+	for i := len(f.workingReleases) - 1; i >= 0; i-- {
+		f.workingReleases[i]()
+	}
+	report := f.endpoint.Terminal(f.socketRows(false), true)
+	if err := tunnel.WriteTransportCeilingReport(*transportCeilingServerOutput, report); err != nil {
+		return err
+	}
+	select {
+	case serveErr := <-adminDone:
+		if serveErr != nil && serveErr != http.ErrServerClosed {
+			return serveErr
+		}
+	case <-time.After(5 * time.Second):
+		return errors.New("transport ceiling server admin did not stop")
+	}
+	if report.InvalidReason != "" || report.PoolLedger.FinalBytes != 0 || report.WorkingLedger.FinalBytes != 0 {
+		return fmt.Errorf("invalid transport ceiling server terminal report: %s", report.InvalidReason)
+	}
+	return nil
+}
