+func CaptureTransportCeilingTCPInfo(conn *net.TCPConn) TransportCeilingTCPInfo {
+	result := TransportCeilingTCPInfo{}
+	if conn == nil {
+		result.Error = "nil TCP connection"
+		return result
+	}
+	result.LocalAddress = conn.LocalAddr().String()
+	result.RemoteAddress = conn.RemoteAddr().String()
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		result.Error = err.Error()
+		return result
+	}
+	var (
+		info  *unix.TCPInfo
+		opErr error
+	)
+	controlErr := raw.Control(func(fd uintptr) {
+		info, opErr = unix.GetsockoptTCPInfo(int(fd), unix.IPPROTO_TCP, unix.TCP_INFO)
+	})
+	if controlErr != nil {
+		result.Error = controlErr.Error()
+		return result
+	}
+	if opErr != nil {
+		result.Error = opErr.Error()
+		return result
+	}
+	result.Captured = true
+	result.State, result.CAState, result.Retransmits = info.State, info.Ca_state, info.Retransmits
+	result.Probes, result.Backoff, result.Options = info.Probes, info.Backoff, info.Options
+	result.RTOUsec, result.ATOUsec = info.Rto, info.Ato
+	result.SendMSS, result.ReceiveMSS = info.Snd_mss, info.Rcv_mss
+	result.Unacked, result.Sacked, result.Lost, result.Retrans, result.Fackets = info.Unacked, info.Sacked, info.Lost, info.Retrans, info.Fackets
+	result.LastDataSentMS, result.LastAckSentMS = info.Last_data_sent, info.Last_ack_sent
+	result.LastDataRecvMS, result.LastAckRecvMS = info.Last_data_recv, info.Last_ack_recv
+	result.PMTU, result.ReceiveSsthresh = info.Pmtu, info.Rcv_ssthresh
+	result.RTTUsec, result.RTTVarUsec = info.Rtt, info.Rttvar
+	result.SendSsthresh, result.SendCwnd, result.AdvMSS = info.Snd_ssthresh, info.Snd_cwnd, info.Advmss
+	result.Reordering, result.ReceiveRTTUsec, result.ReceiveSpace = info.Reordering, info.Rcv_rtt, info.Rcv_space
+	result.TotalRetrans, result.DeliveryRate, result.PacingRate = info.Total_retrans, info.Delivery_rate, info.Pacing_rate
+	result.BytesAcked, result.BytesReceived, result.BytesSent = info.Bytes_acked, info.Bytes_received, info.Bytes_sent
+	result.NotSentBytes, result.SendWindow, result.ReceiveWindow = info.Notsent_bytes, info.Snd_wnd, info.Rcv_wnd
+	// Linux exposes app_limited through inet_diag rather than this portable
+	// TCP_INFO struct. Keep availability explicit instead of inventing a value.
+	return result
+}
+
+func ValidateTransportCeilingEstablishedTCP(conn *net.TCPConn) error {
+	info := CaptureTransportCeilingTCPInfo(conn)
+	if !info.Captured || info.Error != "" {
+		return fmt.Errorf("transport ceiling TCP state unavailable: %s", info.Error)
+	}
+	if info.State != TransportCeilingTCPEstablished {
+		return fmt.Errorf("transport ceiling TCP state = %d, want ESTABLISHED", info.State)
+	}
+	return nil
+}
+
+func NewTransportCeilingLoopbackPair() (*net.TCPConn, *net.TCPConn, error) {
+	listener, err := net.ListenTCP("tcp", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		return nil, nil, err
+	}
+	defer listener.Close()
+	if err := listener.SetDeadline(time.Now().Add(5 * time.Second)); err != nil {
+		return nil, nil, err
+	}
+	type acceptedResult struct {
+		conn *net.TCPConn
+		err  error
+	}
+	accepted := make(chan acceptedResult, 1)
+	go func() {
+		conn, acceptErr := listener.AcceptTCP()
+		accepted <- acceptedResult{conn: conn, err: acceptErr}
+	}()
+	rawClient, err := (&net.Dialer{Timeout: 5 * time.Second}).Dial("tcp", listener.Addr().String())
+	if err != nil {
+		return nil, nil, err
+	}
+	client, ok := rawClient.(*net.TCPConn)
+	if !ok {
+		_ = rawClient.Close()
+		return nil, nil, fmt.Errorf("loopback client connection is %T", rawClient)
+	}
+	var server acceptedResult
+	select {
+	case server = <-accepted:
+	case <-time.After(5 * time.Second):
+		_ = client.Close()
+		return nil, nil, errors.New("timeout accepting transport ceiling loopback connection")
+	}
+	if server.err != nil {
+		_ = client.Close()
+		return nil, nil, server.err
+	}
+	return client, server.conn, nil
+}
