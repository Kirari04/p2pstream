+func (f *transportCeilingServerFixture) reserveWorking(category string, bytes int64) error {
+	release, ok := f.working.Reserve(category, bytes)
+	if !ok {
+		return fmt.Errorf("reserve transport ceiling server %s bytes=%d", category, bytes)
+	}
+	f.workingReleases = append(f.workingReleases, release)
+	return nil
+}
+
+func (f *transportCeilingServerFixture) retainWorkingRelease(release func()) {
+	if release != nil {
+		f.workingReleases = append(f.workingReleases, release)
+	}
+}
