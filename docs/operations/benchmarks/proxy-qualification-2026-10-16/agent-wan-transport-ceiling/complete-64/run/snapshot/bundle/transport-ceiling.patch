+func transportCeilingConfiguration(role, variant string) TransportCeilingConfiguration {
+	configuration := TransportCeilingConfiguration{
+		PhysicalLanes: TransportCeilingPhysicalLanes, DataLanes: TransportCeilingDataLanes,
+		TLSMinimumVersion: tls.VersionTLS12, TLSNextProtocol: "http/1.1",
+		TLSServerName: TransportCeilingTLSName, TLSClientCertificates: false,
+	}
+	if variant != TransportCeilingVariantYamux {
+		return configuration
+	}
+	configuration.YamuxEnabled = true
+	configuration.YamuxAcceptBacklog = 256
+	configuration.ControlIncomingHardBound = NegotiatedControlStreamLimit
+	configuration.DataIncomingHardBound = 16
+	if role == "server" {
+		configuration.ControlIncomingHardBound = -1
+		configuration.DataIncomingHardBound = -1
+	}
+	configuration.InitialByteWindowBytes = uint32(DefaultAdaptiveReceiveWindowBytes)
+	configuration.MaximumByteWindowBytes = uint32(DefaultMaxStreamWindowSizeBytes)
+	configuration.InitialSessionAllocationBytes = AggregateInitialSessionWindowBytes
+	configuration.MaximumSessionAllocationBytes = AggregateMaxSessionWindowBytes
+	configuration.InitialStreamAllocationBytes = AggregateInitialStreamWindowBytes
+	configuration.MaximumStreamAllocationBytes = AggregateMaxStreamWindowBytes
+	configuration.MaximumDATAFrameBytes = AggregateMaxDataFrameBytes
+	configuration.KeepAliveIntervalNanoseconds = int64(20 * time.Second)
+	configuration.ConnectionWriteTimeoutNanoseconds = int64(10 * time.Second)
+	configuration.StreamOpenTimeoutNanoseconds = int64(10 * time.Second)
+	configuration.StreamCloseTimeoutNanoseconds = int64(30 * time.Second)
+	return configuration
+}
