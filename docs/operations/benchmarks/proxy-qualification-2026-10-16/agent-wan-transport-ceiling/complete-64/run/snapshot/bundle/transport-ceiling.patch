+func TestTransportCeilingExternalAgentRole(t *testing.T) {
+	if os.Getenv("P2PSTREAM_TRANSPORT_CEILING_EXTERNAL") != "1" {
+		t.Skip("external transport ceiling role")
+	}
+	fixture, err := newTransportCeilingAgentFixture()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := fixture.run(); err != nil {
+		t.Fatal(err)
+	}
+}
