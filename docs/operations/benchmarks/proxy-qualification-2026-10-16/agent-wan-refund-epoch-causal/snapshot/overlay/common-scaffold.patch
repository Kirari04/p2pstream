+type deferredGlobalFailureConn struct {
+	failCall int
+	short    bool
+	calls    atomic.Int32
+	err      error
+}
+
+func (*deferredGlobalFailureConn) Read([]byte) (int, error) { return 0, io.EOF }
+func (*deferredGlobalFailureConn) Close() error             { return nil }
+func (c *deferredGlobalFailureConn) Write(p []byte) (int, error) {
+	call := int(c.calls.Add(1) - 1)
+	if call == c.failCall {
+		if c.short {
+			return len(p) - 1, nil
+		}
+		return 0, c.err
+	}
+	return len(p), nil
+}
+
+func TestDeferredGlobalEpochWriteFailureNeverRetries(t *testing.T) {
+	requireDeferredGlobalDiagnostic(t)
+	for _, short := range []bool{false, true} {
+		for _, failCall := range []int{0, 1} {
+			t.Run(fmt.Sprintf("short_%t_call_%d", short, failCall), func(t *testing.T) {
+				writeErr := errors.New("injected deferred-global write failure")
+				conn := &deferredGlobalFailureConn{failCall: failCall, short: short, err: writeErr}
+				config := DefaultConfig()
+				config.ConnectionWriteTimeout = time.Second
+				session := &Session{
+					config:     config,
+					logger:     log.New(io.Discard, "", 0),
+					conn:       conn,
+					sendCh:     make(chan *sendReady, 4),
+					controlCh:  make(chan *sendReady, 4),
+					sendDoneCh: make(chan struct{}),
+					shutdownCh: make(chan struct{}),
+					aggregate:  &aggregateWindow{},
+				}
+				stream := newStream(session, 1, streamEstablished)
+				queueAggregateRefundTestStreams(session, []*Stream{stream}, []uint64{uint64(AggregateWindowUnitSize)}, 0)
+				loopDone := make(chan error, 1)
+				go func() { loopDone <- session.sendLoop() }()
+				_, err := session.publishDeferredGlobalRefundEpoch()
+				wantErr := error(writeErr)
+				if short {
+					wantErr = io.ErrShortWrite
+				}
+				if !errors.Is(err, wantErr) {
+					t.Fatalf("epoch error=%v want=%v", err, wantErr)
+				}
+				if loopErr := <-loopDone; !errors.Is(loopErr, wantErr) {
+					t.Fatalf("send error=%v want=%v", loopErr, wantErr)
+				}
+				if got, want := int(conn.calls.Load()), failCall+1; got != want {
+					t.Fatalf("writes=%d want=%d", got, want)
+				}
+			})
+		}
+	}
+}
