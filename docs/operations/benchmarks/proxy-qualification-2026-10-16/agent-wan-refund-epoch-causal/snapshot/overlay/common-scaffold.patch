+func TestDeferredGlobalEpochCloseClearsAmbiguousSelectedOwnership(t *testing.T) {
+	requireDeferredGlobalDiagnostic(t)
+	session := newDeferredGlobalQueueSession(time.Second, 1)
+	stream := newStream(session, 1, streamEstablished)
+	queueAggregateRefundTestStreams(session, []*Stream{stream}, []uint64{uint64(AggregateWindowUnitSize)}, 0)
+	done := make(chan error, 1)
+	go func() {
+		_, err := session.publishDeferredGlobalRefundEpoch()
+		done <- err
+	}()
+	ready := <-session.controlCh // Selected by a sender, but not committed.
+	close(session.shutdownCh)
+	if err := <-done; !errors.Is(err, ErrSessionShutdown) {
+		t.Fatalf("epoch error=%v", err)
+	}
+	if ready.Commit == nil || stream.allocationRefundPublishing != uint64(AggregateWindowUnitSize) || session.aggregate.publishingGlobal != uint64(AggregateWindowUnitSize) || session.aggregate.publishingRefundsCount != 1 {
+		t.Fatalf("pre-cleanup commit=%t stream=%d global=%d selected=%d", ready.Commit != nil, stream.allocationRefundPublishing, session.aggregate.publishingGlobal, session.aggregate.publishingRefundsCount)
+	}
+	session.closeAggregatePool()
+	if stream.allocationRefundPublishing != 0 || session.aggregate.publishingGlobal != 0 || session.aggregate.publishingRefundsCount != 0 {
+		t.Fatalf("post-cleanup stream=%d global=%d selected=%d", stream.allocationRefundPublishing, session.aggregate.publishingGlobal, session.aggregate.publishingRefundsCount)
+	}
+}
