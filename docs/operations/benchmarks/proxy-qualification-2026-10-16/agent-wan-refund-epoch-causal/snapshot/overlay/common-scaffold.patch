+func TestDeferredGlobalEpochCloseClearsHeldGlobalAfterStreamCommit(t *testing.T) {
+	requireDeferredGlobalDiagnostic(t)
+	session := newDeferredGlobalQueueSession(time.Second, 1)
+	stream := newStream(session, 1, streamEstablished)
+	queueAggregateRefundTestStreams(session, []*Stream{stream}, []uint64{uint64(AggregateWindowUnitSize)}, 0)
+	done := make(chan error, 1)
+	go func() {
+		_, err := session.publishDeferredGlobalRefundEpoch()
+		done <- err
+	}()
+	streamReady := <-session.controlCh
+	acknowledgeDeferredGlobalItem(t, streamReady)
+	globalReady := <-session.controlCh // Queued, but the physical sender has not committed it.
+	close(session.shutdownCh)
+	if err := <-done; !errors.Is(err, ErrSessionShutdown) {
+		t.Fatalf("epoch error=%v", err)
+	}
+	if globalReady.Commit == nil || stream.allocationRefundPublishing != 0 || session.aggregate.publishingRefundsCount != 0 || session.aggregate.publishingGlobal != uint64(AggregateWindowUnitSize) {
+		t.Fatalf("pre-cleanup commit=%t stream=%d selected=%d global=%d", globalReady.Commit != nil, stream.allocationRefundPublishing, session.aggregate.publishingRefundsCount, session.aggregate.publishingGlobal)
+	}
+	session.closeAggregatePool()
+	if session.aggregate.publishingGlobal != 0 {
+		t.Fatalf("post-cleanup global=%d", session.aggregate.publishingGlobal)
+	}
+}
