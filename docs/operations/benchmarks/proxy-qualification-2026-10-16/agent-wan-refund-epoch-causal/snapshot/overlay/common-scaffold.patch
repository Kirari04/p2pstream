+func TestDeferredGlobalEpochUsesOneDeadline(t *testing.T) {
+	requireDeferredGlobalDiagnostic(t)
+	const timeout = 400 * time.Millisecond
+	session := newDeferredGlobalQueueSession(timeout, 2)
+	streams := []*Stream{newStream(session, 1, streamEstablished), newStream(session, 3, streamEstablished)}
+	queueAggregateRefundTestStreams(session, streams, []uint64{uint64(AggregateWindowUnitSize), uint64(AggregateWindowUnitSize)}, 0)
+	done := make(chan error, 1)
+	start := time.Now()
+	go func() {
+		_, err := session.publishDeferredGlobalRefundEpoch()
+		done <- err
+	}()
+	first := <-session.controlCh
+	first.Commit()
+	time.Sleep(250 * time.Millisecond)
+	first.Err <- nil
+	<-session.controlCh // Select the second item but never acknowledge it.
+	if err := <-done; !errors.Is(err, ErrConnectionWriteTimeout) {
+		t.Fatalf("epoch error=%v", err)
+	}
+	if elapsed := time.Since(start); elapsed >= 550*time.Millisecond {
+		t.Fatalf("epoch deadline multiplied across items: %v", elapsed)
+	}
+}
