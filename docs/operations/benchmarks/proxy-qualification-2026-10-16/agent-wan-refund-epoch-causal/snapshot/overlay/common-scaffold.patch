+package yamux
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func requireDeferredGlobalDiagnostic(t *testing.T) {
+	t.Helper()
+	if !diagnosticDeferredGlobalEpoch {
+		t.Skip("deferred-global diagnostic arm only")
+	}
+}
+
+func newDeferredGlobalQueueSession(timeout time.Duration, capacity int) *Session {
+	config := DefaultConfig()
+	config.ConnectionWriteTimeout = timeout
+	return &Session{
+		config:     config,
+		logger:     log.New(io.Discard, "", 0),
+		controlCh:  make(chan *sendReady, capacity),
+		shutdownCh: make(chan struct{}),
+		aggregate:  &aggregateWindow{},
+	}
+}
+
+func acknowledgeDeferredGlobalItem(t *testing.T, ready *sendReady) {
+	t.Helper()
+	if ready.Commit != nil {
+		ready.Commit()
+	}
+	ready.Err <- nil
+}
+
+func TestDeferredGlobalEpochPublishesSixteenThenGlobal(t *testing.T) {
+	requireDeferredGlobalDiagnostic(t)
+	session, conn := newAggregateRefundPublishTestSession(t)
+	const streamCount = aggregateRefundBatchStreams + 1
+	streams := make([]*Stream, 0, streamCount)
+	deltas := make([]uint64, 0, streamCount)
+	for i := 0; i < streamCount; i++ {
+		streams = append(streams, newStream(session, uint32(2*i+1), streamEstablished))
+		deltas = append(deltas, uint64(AggregateWindowUnitSize))
+	}
+	queueAggregateRefundTestStreams(session, streams, deltas, 0)
+
+	published, err := session.publishDeferredGlobalRefundEpoch()
+	if err != nil || !published {
+		t.Fatalf("first epoch published=%t error=%v", published, err)
+	}
+	conn.mu.Lock()
+	firstWrites := append([][]byte(nil), conn.writes...)
+	conn.mu.Unlock()
+	if got, want := len(firstWrites), aggregateRefundBatchStreams+1; got != want {
+		t.Fatalf("first epoch writes=%d want=%d", got, want)
+	}
+	for i := 0; i < aggregateRefundBatchStreams; i++ {
+		hdr := header(firstWrites[i])
+		if hdr.MsgType() != typeAllocationWindowUpdate || hdr.StreamID() != streams[i].id || hdr.Length() != AggregateWindowUnitSize {
+			t.Fatalf("first epoch header %d=%v", i, hdr)
+		}
+	}
+	global := header(firstWrites[len(firstWrites)-1])
+	if global.MsgType() != typeWindowUpdate || global.StreamID() != 0 || global.Length() != aggregateRefundBatchStreams*AggregateWindowUnitSize {
+		t.Fatalf("first epoch global=%v", global)
+	}
+	session.aggregate.mu.Lock()
+	if session.aggregate.pendingStreamHead != streams[aggregateRefundBatchStreams] || session.aggregate.pendingGlobal != uint64(AggregateWindowUnitSize) || session.aggregate.publishingGlobal != 0 || session.aggregate.publishingRefundsCount != 0 {
+		t.Fatalf("first epoch ledger head=%p pending_global=%d publishing_global=%d selected=%d", session.aggregate.pendingStreamHead, session.aggregate.pendingGlobal, session.aggregate.publishingGlobal, session.aggregate.publishingRefundsCount)
+	}
+	session.aggregate.mu.Unlock()
+
+	published, err = session.publishDeferredGlobalRefundEpoch()
+	if err != nil || !published {
+		t.Fatalf("second epoch published=%t error=%v", published, err)
+	}
+	conn.mu.Lock()
+	writes := append([][]byte(nil), conn.writes...)
+	conn.mu.Unlock()
+	if got, want := len(writes), aggregateRefundBatchStreams+3; got != want {
+		t.Fatalf("total writes=%d want=%d", got, want)
+	}
+	if hdr := header(writes[len(writes)-2]); hdr.MsgType() != typeAllocationWindowUpdate || hdr.StreamID() != streams[len(streams)-1].id {
+		t.Fatalf("second epoch stream=%v", hdr)
+	}
+	if hdr := header(writes[len(writes)-1]); hdr.MsgType() != typeWindowUpdate || hdr.Length() != AggregateWindowUnitSize {
+		t.Fatalf("second epoch global=%v", hdr)
+	}
+}
+
+func TestDeferredGlobalEpochCountsSameStreamRequeues(t *testing.T) {
+	requireDeferredGlobalDiagnostic(t)
+	session := newDeferredGlobalQueueSession(time.Second, 4)
+	stream := newStream(session, 1, streamEstablished)
+	queueAggregateRefundTestStreams(session, []*Stream{stream}, []uint64{uint64(AggregateWindowUnitSize)}, 0)
+	done := make(chan error, 1)
+	go func() {
+		_, err := session.publishDeferredGlobalRefundEpoch()
+		done <- err
+	}()
+	for i := 0; i < aggregateRefundBatchStreams; i++ {
+		ready := <-session.controlCh
+		hdr := header(ready.Hdr)
+		if hdr.MsgType() != typeAllocationWindowUpdate || hdr.StreamID() != stream.id {
+			t.Fatalf("stream item %d=%v", i, hdr)
+		}
+		if ready.Commit == nil {
+			t.Fatalf("stream item %d omitted commit", i)
+		}
+		ready.Commit()
+		queueAggregateRefundTestStreams(session, []*Stream{stream}, []uint64{uint64(AggregateWindowUnitSize)}, 0)
+		ready.Err <- nil
+	}
+	globalReady := <-session.controlCh
+	global := header(globalReady.Hdr)
+	if global.MsgType() != typeWindowUpdate || global.Length() != aggregateRefundBatchStreams*AggregateWindowUnitSize {
+		t.Fatalf("global=%v", global)
+	}
+	acknowledgeDeferredGlobalItem(t, globalReady)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	session.aggregate.mu.Lock()
+	defer session.aggregate.mu.Unlock()
+	if session.aggregate.pendingStreamHead != stream || stream.allocationRefundPending != uint64(AggregateWindowUnitSize) || session.aggregate.pendingGlobal != uint64(AggregateWindowUnitSize) {
+		t.Fatalf("requeued stream head=%p pending=%d global=%d", session.aggregate.pendingStreamHead, stream.allocationRefundPending, session.aggregate.pendingGlobal)
+	}
+}
+
+func TestDeferredGlobalSelectionPreservesNewStreamMatch(t *testing.T) {
+	requireDeferredGlobalDiagnostic(t)
+	session := newDeferredGlobalQueueSession(time.Second, 1)
+	session.aggregate.pendingGlobal = uint64(AggregateWindowUnitSize)
+	part, delta, hasStream, err := session.takeDeferredGlobalRefundPart(aggregateMaxWindowUpdate)
+	if err != nil || hasStream || part.stream != nil || delta != uint64(AggregateWindowUnitSize) {
+		t.Fatalf("global-only selection part=%+v delta=%d stream=%t error=%v", part, delta, hasStream, err)
+	}
+	stream := newStream(session, 1, streamEstablished)
+	queueAggregateRefundTestStreams(session, []*Stream{stream}, []uint64{uint64(AggregateWindowUnitSize)}, 0)
+	session.aggregate.mu.Lock()
+	defer session.aggregate.mu.Unlock()
+	if session.aggregate.publishingGlobal != uint64(AggregateWindowUnitSize) || session.aggregate.pendingGlobal != uint64(AggregateWindowUnitSize) || session.aggregate.pendingStreamHead != stream {
+		t.Fatalf("publishing=%d pending=%d head=%p", session.aggregate.publishingGlobal, session.aggregate.pendingGlobal, session.aggregate.pendingStreamHead)
+	}
+}
+
+func TestDeferredGlobalSelectionTakesExtraOnlyWithEmptyStreamQueue(t *testing.T) {
+	requireDeferredGlobalDiagnostic(t)
+	session := newDeferredGlobalQueueSession(time.Second, 1)
+	stream := newStream(session, 1, streamEstablished)
+	const extra = 3 * uint64(AggregateWindowUnitSize)
+	queueAggregateRefundTestStreams(session, []*Stream{stream}, []uint64{uint64(AggregateWindowUnitSize)}, extra)
+	part, global, hasStream, err := session.takeDeferredGlobalRefundPart(aggregateMaxWindowUpdate)
+	if err != nil || !hasStream || part.delta != uint64(AggregateWindowUnitSize) || global != uint64(AggregateWindowUnitSize)+extra {
+		t.Fatalf("part=%+v global=%d stream=%t error=%v", part, global, hasStream, err)
+	}
+	session.aggregate.mu.Lock()
+	defer session.aggregate.mu.Unlock()
+	if session.aggregate.pendingStreamHead != nil || session.aggregate.pendingGlobal != 0 || session.aggregate.publishingGlobal != global {
+		t.Fatalf("head=%p pending=%d publishing=%d", session.aggregate.pendingStreamHead, session.aggregate.pendingGlobal, session.aggregate.publishingGlobal)
+	}
+}
+
+func TestDeferredGlobalSelectionFailsClosedOnMissingMatch(t *testing.T) {
+	requireDeferredGlobalDiagnostic(t)
+	session := newDeferredGlobalQueueSession(time.Second, 1)
+	stream := newStream(session, 1, streamEstablished)
+	stream.allocationRefundPending = uint64(AggregateWindowUnitSize)
+	stream.allocationRefundQueued = true
+	session.aggregate.pendingStreamHead = stream
+	session.aggregate.pendingStreamTail = stream
+	if _, delta, _, err := session.takeDeferredGlobalRefundPart(aggregateMaxWindowUpdate); err == nil || delta != 0 {
+		t.Fatalf("delta=%d error=%v", delta, err)
+	}
+	if stream.allocationRefundPending != uint64(AggregateWindowUnitSize) || stream.allocationRefundPublishing != 0 || session.aggregate.publishingRefundsCount != 0 {
+		t.Fatalf("ledger mutated pending=%d publishing=%d selected=%d", stream.allocationRefundPending, stream.allocationRefundPublishing, session.aggregate.publishingRefundsCount)
+	}
+}
+
+func TestDeferredGlobalSelectionCapsAlignedUint32Epoch(t *testing.T) {
+	requireDeferredGlobalDiagnostic(t)
+	session := newDeferredGlobalQueueSession(time.Second, 1)
+	stream := newStream(session, 1, streamEstablished)
+	wantPending := aggregateMaxWindowUpdate + uint64(AggregateWindowUnitSize)
+	queueAggregateRefundTestStreams(session, []*Stream{stream}, []uint64{wantPending}, 0)
+	part, delta, hasStream, err := session.takeDeferredGlobalRefundPart(aggregateMaxWindowUpdate)
+	if err != nil || !hasStream || delta != aggregateMaxWindowUpdate || part.delta != aggregateMaxWindowUpdate {
+		t.Fatalf("part=%+v delta=%d stream=%t error=%v", part, delta, hasStream, err)
+	}
+	if stream.allocationRefundPending != uint64(AggregateWindowUnitSize) || session.aggregate.pendingGlobal != uint64(AggregateWindowUnitSize) || session.aggregate.publishingGlobal != aggregateMaxWindowUpdate {
+		t.Fatalf("pending=%d pending_global=%d publishing_global=%d", stream.allocationRefundPending, session.aggregate.pendingGlobal, session.aggregate.publishingGlobal)
+	}
+	session.closeAggregatePool()
+}
+
+func TestDeferredGlobalTerminalStreamKeepsMatchedGlobal(t *testing.T) {
+	requireDeferredGlobalDiagnostic(t)
+	session := newDeferredGlobalQueueSession(time.Second, 2)
+	stream := newStream(session, 1, streamClosed)
+	queueAggregateRefundTestStreams(session, []*Stream{stream}, []uint64{uint64(AggregateWindowUnitSize)}, 0)
+	done := make(chan error, 1)
+	go func() {
+		_, err := session.publishDeferredGlobalRefundEpoch()
+		done <- err
+	}()
+	ready := <-session.controlCh
+	hdr := header(ready.Hdr)
+	if hdr.MsgType() != typeWindowUpdate || hdr.StreamID() != 0 || hdr.Length() != AggregateWindowUnitSize {
+		t.Fatalf("terminal epoch emitted=%v", hdr)
+	}
+	acknowledgeDeferredGlobalItem(t, ready)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if stream.allocationRefundPublishing != 0 || session.aggregate.publishingRefundsCount != 0 || session.aggregate.publishingGlobal != 0 || session.aggregate.recvWindow != AggregateWindowUnitSize {
+		t.Fatalf("stream publishing=%d selected=%d global=%d recv=%d", stream.allocationRefundPublishing, session.aggregate.publishingRefundsCount, session.aggregate.publishingGlobal, session.aggregate.recvWindow)
+	}
+}
