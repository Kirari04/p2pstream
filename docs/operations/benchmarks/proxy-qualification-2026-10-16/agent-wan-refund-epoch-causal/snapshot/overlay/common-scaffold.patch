+func TestDeferredGlobalEpochLateCommitClearsOnlySelectedStream(t *testing.T) {
+	requireDeferredGlobalDiagnostic(t)
+	session := newDeferredGlobalQueueSession(100*time.Millisecond, 1)
+	stream := newStream(session, 1, streamEstablished)
+	queueAggregateRefundTestStreams(session, []*Stream{stream}, []uint64{uint64(AggregateWindowUnitSize)}, 0)
+	done := make(chan error, 1)
+	go func() {
+		_, err := session.publishDeferredGlobalRefundEpoch()
+		done <- err
+	}()
+	ready := <-session.controlCh
+	if err := <-done; !errors.Is(err, ErrConnectionWriteTimeout) {
+		t.Fatalf("epoch error=%v", err)
+	}
+	if stream.allocationRefundPublishing != uint64(AggregateWindowUnitSize) || session.aggregate.publishingGlobal != uint64(AggregateWindowUnitSize) || session.aggregate.publishingRefundsCount != 1 {
+		t.Fatalf("before late commit stream=%d global=%d selected=%d", stream.allocationRefundPublishing, session.aggregate.publishingGlobal, session.aggregate.publishingRefundsCount)
+	}
+	ready.Commit() // The physical sender may have crossed after the waiter timed out.
+	if stream.allocationRefundPublishing != 0 || stream.allocationRecvWindow != AggregateWindowUnitSize || session.aggregate.publishingGlobal != uint64(AggregateWindowUnitSize) || session.aggregate.publishingRefundsCount != 0 {
+		t.Fatalf("after late commit stream=%d recv=%d global=%d selected=%d", stream.allocationRefundPublishing, stream.allocationRecvWindow, session.aggregate.publishingGlobal, session.aggregate.publishingRefundsCount)
+	}
+	session.closeAggregatePool()
+}
