+func TestDeferredGlobalEpochReaderControlPrecedesNextRefund(t *testing.T) {
+	requireDeferredGlobalDiagnostic(t)
+	session := newDeferredGlobalQueueSession(time.Second, 4)
+	streams := []*Stream{newStream(session, 1, streamEstablished), newStream(session, 3, streamEstablished)}
+	queueAggregateRefundTestStreams(session, streams, []uint64{uint64(AggregateWindowUnitSize), uint64(AggregateWindowUnitSize)}, 0)
+	done := make(chan error, 1)
+	go func() {
+		_, err := session.publishDeferredGlobalRefundEpoch()
+		done <- err
+	}()
+	first := <-session.controlCh
+	ping := header(make([]byte, headerSize))
+	ping.encode(typePing, flagACK, 0, 7)
+	if err := session.sendAggregateControlNoWait(ping); err != nil {
+		t.Fatal(err)
+	}
+	acknowledgeDeferredGlobalItem(t, first)
+	readerControl := <-session.controlCh
+	if !bytes.Equal(readerControl.Hdr, ping) {
+		t.Fatalf("next control=%v want reader PING", header(readerControl.Hdr))
+	}
+	second := <-session.controlCh
+	if hdr := header(second.Hdr); hdr.MsgType() != typeAllocationWindowUpdate || hdr.StreamID() != streams[1].id {
+		t.Fatalf("second refund=%v", hdr)
+	}
+	acknowledgeDeferredGlobalItem(t, second)
+	global := <-session.controlCh
+	acknowledgeDeferredGlobalItem(t, global)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+}
