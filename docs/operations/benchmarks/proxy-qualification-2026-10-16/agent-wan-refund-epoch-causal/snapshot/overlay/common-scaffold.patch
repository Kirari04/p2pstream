+// takeDeferredGlobalRefundPart atomically reserves one stream refund and its
+// matching session refund. If consuming that stream empties the queue, the
+// same locked observation may also reserve global-only credit. The selected
+// stream remains session-owned in publishingRefunds until its item commits or
+// Close joins the publisher and sender.
+func (s *Session) takeDeferredGlobalRefundPart(room uint64) (aggregateRefundPart, uint64, bool, error) {
+	a := s.aggregate
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.publishingRefundsCount != 0 {
+		return aggregateRefundPart{}, 0, false, fmt.Errorf("yamux: deferred aggregate refund selected while another stream refund is publishing")
+	}
+	if room < uint64(AggregateWindowUnitSize) {
+		return aggregateRefundPart{}, 0, false, nil
+	}
+	stream := a.pendingStreamHead
+	if stream == nil {
+		delta := a.pendingGlobal
+		if delta > room {
+			delta = room
+		}
+		delta -= delta % uint64(AggregateWindowUnitSize)
+		if delta == 0 {
+			return aggregateRefundPart{}, 0, false, nil
+		}
+		a.pendingGlobal -= delta
+		a.publishingGlobal += delta
+		return aggregateRefundPart{}, delta, false, nil
+	}
+	delta := stream.allocationRefundPending
+	if delta > a.pendingGlobal {
+		delta = a.pendingGlobal
+	}
+	if delta > room {
+		delta = room
+	}
+	delta -= delta % uint64(AggregateWindowUnitSize)
+	if delta == 0 {
+		return aggregateRefundPart{}, 0, false, fmt.Errorf("yamux: invalid deferred aggregate refund ledger for stream %d", stream.id)
+	}
+	part := aggregateRefundPart{stream: stream, delta: delta, slot: 0}
+	stream.allocationRefundPending -= delta
+	stream.allocationRefundPublishing += delta
+	a.pendingGlobal -= delta
+	a.publishingGlobal += delta
+	a.publishingRefunds[0] = part
+	a.publishingRefundsCount = 1
+	if stream.allocationRefundPending == 0 {
+		a.pendingStreamHead = stream.allocationRefundNext
+		if a.pendingStreamHead == nil {
+			a.pendingStreamTail = nil
+		}
+		stream.allocationRefundNext = nil
+		stream.allocationRefundQueued = false
+	}
+	global := delta
+	// Credit beyond all queued stream matches is known to be global-only. Take
+	// it only while the empty-queue observation is protected by this lock; a
+	// later read may otherwise enqueue a new stream match concurrently.
+	if a.pendingStreamHead == nil && global < room {
+		extra := a.pendingGlobal
+		if extra > room-global {
+			extra = room - global
+		}
+		extra -= extra % uint64(AggregateWindowUnitSize)
+		a.pendingGlobal -= extra
+		a.publishingGlobal += extra
+		global += extra
+	}
+	return part, global, true, nil
+}
+
+func (s *Session) deferredGlobalEpochTermination(timeout <-chan time.Time) error {
+	select {
+	case <-s.shutdownCh:
+		return ErrSessionShutdown
+	default:
+	}
+	select {
+	case <-timeout:
+		return ErrConnectionWriteTimeout
+	default:
+		return nil
+	}
+}
+
+// waitForDeferredGlobalEpochItem uses the caller's single epoch deadline. A
+// successful acknowledgement is the only point at which errCh may be reused.
+func (s *Session) waitForDeferredGlobalEpochItem(hdr header, errCh chan error, commit func(), timeout <-chan time.Time) error {
+	if err := s.deferredGlobalEpochTermination(timeout); err != nil {
+		return err
+	}
+	ready := &sendReady{Hdr: hdr, Err: errCh, Commit: commit}
+	select {
+	case s.controlCh <- ready:
+	case <-s.shutdownCh:
+		return ErrSessionShutdown
+	case <-timeout:
+		return ErrConnectionWriteTimeout
+	}
+	select {
+	case err := <-errCh:
+		if err != nil {
+			return err
+		}
+	case <-s.shutdownCh:
+		return ErrSessionShutdown
+	case <-timeout:
+		return ErrConnectionWriteTimeout
+	}
+	// Do not allow a simultaneously ready acknowledgement to win repeatedly
+	// over an expired epoch or shutdown and enable another publication.
+	return s.deferredGlobalEpochTermination(timeout)
+}
+
+func (s *Session) finishDeferredGlobalStreamPart(part aggregateRefundPart, grant bool) {
+	a := s.aggregate
+	a.mu.Lock()
+	part.stream.allocationRefundPublishing -= part.delta
+	if grant {
+		part.stream.allocationRecvWindow += uint32(part.delta)
+	}
+	a.publishingRefunds[0] = aggregateRefundPart{}
+	a.publishingRefundsCount = 0
+	a.mu.Unlock()
+}
+
+func (s *Session) publishDeferredGlobalStreamPart(part aggregateRefundPart, errCh chan error, timeout <-chan time.Time) error {
+	if err := s.deferredGlobalEpochTermination(timeout); err != nil {
+		return err
+	}
+	stream := part.stream
+	stream.controlHdrLock.Lock()
+	defer stream.controlHdrLock.Unlock()
+	if !stream.acceptsAggregateData() {
+		s.finishDeferredGlobalStreamPart(part, false)
+		return nil
+	}
+	a := s.aggregate
+	a.publishMu.Lock()
+	defer a.publishMu.Unlock()
+	hdr := header(make([]byte, headerSize))
+	hdr.encode(typeAllocationWindowUpdate, 0, stream.id, uint32(part.delta))
+	return s.waitForDeferredGlobalEpochItem(hdr, errCh, func() {
+		s.finishDeferredGlobalStreamPart(part, true)
+	}, timeout)
+}
+
+func (s *Session) publishDeferredGlobalSessionRefund(delta uint64, errCh chan error, timeout <-chan time.Time) error {
+	a := s.aggregate
+	a.publishMu.Lock()
+	defer a.publishMu.Unlock()
+	hdr := header(make([]byte, headerSize))
+	hdr.encode(typeWindowUpdate, 0, 0, uint32(delta))
+	return s.waitForDeferredGlobalEpochItem(hdr, errCh, func() {
+		a.mu.Lock()
+		a.publishingGlobal -= delta
+		a.recvWindow += uint32(delta)
+		a.mu.Unlock()
+	}, timeout)
+}
+
+// publishDeferredGlobalRefundEpoch publishes at most 16 selected stream parts
+// and one accumulated session refund. Same-stream requeues and terminal parts
+// consume the stream budget. The aligned session delta is bounded to one wire
+// update. This bounded epoch is a causal diagnostic rather than a restoration
+// of the historical unbounded drain. Lock acquisition is synchronous and
+// therefore not interruptible; once a lock is acquired, the shared deadline
+// is checked before enqueueing.
+func (s *Session) publishDeferredGlobalRefundEpoch() (bool, error) {
+	t := timerPool.Get()
+	timer := t.(*time.Timer)
+	timer.Reset(s.config.ConnectionWriteTimeout)
+	defer func() {
+		timer.Stop()
+		select {
+		case <-timer.C:
+		default:
+		}
+		timerPool.Put(t)
+	}()
+	errCh := make(chan error, 1)
+	var global uint64
+	selections := 0
+	published := false
+	for selections < aggregateRefundBatchStreams && global < aggregateMaxWindowUpdate {
+		if err := s.deferredGlobalEpochTermination(timer.C); err != nil {
+			return published, err
+		}
+		room := aggregateMaxWindowUpdate - global
+		part, delta, hasStream, err := s.takeDeferredGlobalRefundPart(room)
+		if err != nil {
+			return published, err
+		}
+		if delta == 0 {
+			break
+		}
+		published = true
+		global += delta
+		if !hasStream {
+			break
+		}
+		selections++
+		if err := s.publishDeferredGlobalStreamPart(part, errCh, timer.C); err != nil {
+			return true, err
+		}
+	}
+	if global == 0 {
+		return published, nil
+	}
+	if err := s.publishDeferredGlobalSessionRefund(global, errCh, timer.C); err != nil {
+		return true, err
+	}
+	return true, nil
+}
+
 type aggregateRefundPart struct {
 	stream *Stream
 	delta  uint64
