+func TestDeferredGlobalEpochAllowsGrowthBetweenRefundItems(t *testing.T) {
+	requireDeferredGlobalDiagnostic(t)
+	config := DefaultConfig()
+	config.ConnectionWriteTimeout = time.Second
+	config.InitialSessionWindowSize = 64 << 10
+	config.MaxSessionWindowSize = 128 << 10
+	config.InitialStreamAllocationWindowSize = 16 << 10
+	config.MaxStreamAllocationWindowSize = 32 << 10
+	session := &Session{
+		config:     config,
+		logger:     log.New(io.Discard, "", 0),
+		controlCh:  make(chan *sendReady, 4),
+		shutdownCh: make(chan struct{}),
+	}
+	session.aggregate = newAggregateWindow(config)
+	stream := newStream(session, 1, streamEstablished)
+	queueAggregateRefundTestStreams(session, []*Stream{stream}, []uint64{uint64(AggregateWindowUnitSize)}, 0)
+	epochDone := make(chan error, 1)
+	go func() {
+		_, err := session.publishDeferredGlobalRefundEpoch()
+		epochDone <- err
+	}()
+	streamRefund := <-session.controlCh
+	growDone := make(chan error, 1)
+	go func() { growDone <- session.GrowReceiveWindow(128 << 10) }()
+	select {
+	case err := <-growDone:
+		t.Fatalf("growth crossed held refund publication lock: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	acknowledgeDeferredGlobalItem(t, streamRefund)
+	seenGlobal, seenGrow := false, false
+	for !seenGlobal || !seenGrow {
+		ready := <-session.controlCh
+		switch header(ready.Hdr).MsgType() {
+		case typeWindowUpdate:
+			seenGlobal = true
+		case typeWindowGrow:
+			seenGrow = true
+		default:
+			t.Fatalf("unexpected control=%v", header(ready.Hdr))
+		}
+		acknowledgeDeferredGlobalItem(t, ready)
+	}
+	if err := <-epochDone; err != nil {
+		t.Fatalf("epoch: %v", err)
+	}
+	if err := <-growDone; err != nil {
+		t.Fatalf("growth: %v", err)
+	}
+	if session.aggregate.recvLimit != 128<<10 {
+		t.Fatalf("receive limit=%d want=%d", session.aggregate.recvLimit, 128<<10)
+	}
+}
