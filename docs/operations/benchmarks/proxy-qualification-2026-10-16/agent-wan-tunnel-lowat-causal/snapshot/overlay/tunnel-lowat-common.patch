@@ -0,0 +1,185 @@
+//go:build linux
+
+package server
+
+import (
+	"bufio"
+	"bytes"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"p2pstream/internal/config"
+	"p2pstream/internal/tunnel"
+)
+
+func TestAgentTunnelSocketDiagnosticObservesAuthenticatedPhysicalConnectionBeforeUpgrade(t *testing.T) {
+	database := newAgentRegistryTestDB(t)
+	app := NewApp(&config.Config{ManagementUIDisabled: true}, database)
+	agent := createAgentRegistryTestAgent(t, database, "agent-tunnel-socket-diagnostic", "Socket Diagnostic", "token")
+	observations := make(chan agentTunnelSocketObservation, 1)
+	app.agentTunnelSocketObserver = func(observation agentTunnelSocketObservation) {
+		observations <- observation
+	}
+	mux := http.NewServeMux()
+	app.RegisterManagementRoutes(mux)
+	server := httptest.NewServer(mux)
+	defer server.Close()
+
+	session, conn, err := dialAgentRegistryTestTunnel(server.URL, agent.PublicID, "token")
+	if err != nil {
+		t.Fatalf("dial tunnel: %v", err)
+	}
+	defer session.Close()
+	defer conn.Close()
+	var observation agentTunnelSocketObservation
+	select {
+	case observation = <-observations:
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for physical socket observation")
+	}
+	if observation.Lane != 0 || observation.Aggregate || observation.LaneRole != "" {
+		t.Fatalf("lane observation = %+v, want legacy lane zero", observation)
+	}
+	if !observation.Socket.Conclusive {
+		t.Fatalf("socket observation = %+v, want conclusive", observation.Socket)
+	}
+	if observation.Socket.LocalAddress != conn.RemoteAddr().String() || observation.Socket.RemoteAddress != conn.LocalAddr().String() {
+		t.Fatalf("server tuple = %s -> %s, client tuple = %s -> %s", observation.Socket.LocalAddress, observation.Socket.RemoteAddress, conn.LocalAddr(), conn.RemoteAddr())
+	}
+}
+
+func TestAgentTunnelSocketDiagnosticRunsOnlyAfterAuthAndBufferedInputGate(t *testing.T) {
+	database := newAgentRegistryTestDB(t)
+	app := NewApp(&config.Config{ManagementUIDisabled: true}, database)
+	agent := createAgentRegistryTestAgent(t, database, "agent-tunnel-socket-boundary", "Socket Boundary", "token")
+	var mu sync.Mutex
+	var observations []agentTunnelSocketObservation
+	app.agentTunnelSocketObserver = func(observation agentTunnelSocketObservation) {
+		mu.Lock()
+		observations = append(observations, observation)
+		mu.Unlock()
+	}
+
+	badAuth := newAgentTunnelSocketRequest(agent.PublicID, "wrong-token")
+	badAuthRecorder := httptest.NewRecorder()
+	app.agentTunnelHandler(badAuthRecorder, badAuth)
+	if badAuthRecorder.Code != http.StatusUnauthorized {
+		t.Fatalf("bad auth status = %d, want 401", badAuthRecorder.Code)
+	}
+
+	client, server := newAgentRegistryLocalTCPPair(t)
+	defer client.Close()
+	response := &bytes.Buffer{}
+	buffered := &diagnosticHijackResponseWriter{
+		conn:   server,
+		reader: bufio.NewReader(strings.NewReader("attacker-controlled-extra-byte")),
+		writer: bufio.NewWriter(response),
+	}
+	if _, err := buffered.reader.Peek(1); err != nil {
+		t.Fatalf("prefill buffered tunnel input: %v", err)
+	}
+	app.agentTunnelHandler(buffered, newAgentTunnelSocketRequest(agent.PublicID, "token"))
+	if !strings.Contains(response.String(), "400 Bad Request") {
+		t.Fatalf("buffered response = %q, want 400", response.String())
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	if len(observations) != 0 {
+		t.Fatalf("observations before auth/buffer gate = %+v, want none", observations)
+	}
+}
+
+func TestAgentTunnelSocketDiagnosticInconclusivePreventsSwitchingProtocols(t *testing.T) {
+	database := newAgentRegistryTestDB(t)
+	app := NewApp(&config.Config{ManagementUIDisabled: true}, database)
+	agent := createAgentRegistryTestAgent(t, database, "agent-tunnel-socket-inconclusive", "Socket Inconclusive", "token")
+	observations := make(chan agentTunnelSocketObservation, 1)
+	app.agentTunnelSocketObserver = func(observation agentTunnelSocketObservation) {
+		observations <- observation
+	}
+	conn := &diagnosticMemoryConn{}
+	response := &bytes.Buffer{}
+	writer := &diagnosticHijackResponseWriter{
+		conn:   conn,
+		reader: bufio.NewReader(strings.NewReader("")),
+		writer: bufio.NewWriter(response),
+	}
+	app.agentTunnelHandler(writer, newAgentTunnelSocketRequest(agent.PublicID, "token"))
+	if strings.Contains(response.String(), "101 Switching Protocols") || !strings.Contains(response.String(), "503 Service Unavailable") {
+		t.Fatalf("diagnostic response = %q, want only 503", response.String())
+	}
+	if !conn.closed {
+		t.Fatal("inconclusive physical connection remained open")
+	}
+	select {
+	case observation := <-observations:
+		if observation.Socket.Conclusive || observation.Socket.UnwrapError == "" {
+			t.Fatalf("observation = %+v, want unwrap failure", observation)
+		}
+	default:
+		t.Fatal("inconclusive observation was not published")
+	}
+}
+
+func newAgentTunnelSocketRequest(publicID, token string) *http.Request {
+	req := httptest.NewRequest(http.MethodGet, tunnel.BootstrapPath, nil)
+	req.Header.Set("X-P2PStream-Agent-ID", publicID)
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("Connection", "Upgrade")
+	req.Header.Set("Upgrade", tunnel.UpgradeToken)
+	req.Header.Set(tunnel.TunnelVersionHeader, "1")
+	req.Header.Set(tunnel.TunnelMaxConcurrentStreamsHeader, "64")
+	req.Header.Set(tunnel.TunnelCapacityModeHeader, tunnel.TunnelCapacityModeFixed)
+	return req
+}
+
+type diagnosticHijackResponseWriter struct {
+	header http.Header
+	conn   net.Conn
+	reader *bufio.Reader
+	writer *bufio.Writer
+}
+
+func (writer *diagnosticHijackResponseWriter) Header() http.Header {
+	if writer.header == nil {
+		writer.header = make(http.Header)
+	}
+	return writer.header
+}
+
+func (*diagnosticHijackResponseWriter) WriteHeader(int) {}
+
+func (writer *diagnosticHijackResponseWriter) Write(value []byte) (int, error) {
+	return writer.writer.Write(value)
+}
+
+func (writer *diagnosticHijackResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	return writer.conn, bufio.NewReadWriter(writer.reader, writer.writer), nil
+}
+
+type diagnosticMemoryConn struct {
+	closed bool
+}
+
+func (*diagnosticMemoryConn) Read([]byte) (int, error)         { return 0, io.EOF }
+func (*diagnosticMemoryConn) Write(value []byte) (int, error)  { return len(value), nil }
+func (conn *diagnosticMemoryConn) Close() error                { conn.closed = true; return nil }
+func (*diagnosticMemoryConn) LocalAddr() net.Addr              { return diagnosticMemoryAddr("local") }
+func (*diagnosticMemoryConn) RemoteAddr() net.Addr             { return diagnosticMemoryAddr("remote") }
+func (*diagnosticMemoryConn) SetDeadline(time.Time) error      { return nil }
+func (*diagnosticMemoryConn) SetReadDeadline(time.Time) error  { return nil }
+func (*diagnosticMemoryConn) SetWriteDeadline(time.Time) error { return nil }
+
+type diagnosticMemoryAddr string
+
+func (diagnosticMemoryAddr) Network() string        { return "diagnostic" }
+func (address diagnosticMemoryAddr) String() string { return string(address) }
+
+var _ net.Conn = (*diagnosticMemoryConn)(nil)
+var _ http.Hijacker = (*diagnosticHijackResponseWriter)(nil)
