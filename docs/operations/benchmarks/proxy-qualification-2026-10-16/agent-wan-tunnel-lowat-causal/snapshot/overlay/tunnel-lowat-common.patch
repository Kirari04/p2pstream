+type fakePhysicalTunnelSocketOptions struct {
+	notSentLowat        []uint32
+	notSentLowatErrors  []error
+	sendBuffer          []int
+	sendBufferErrors    []error
+	receiveBuffer       []int
+	receiveBufferErrors []error
+	setCalls            int
+	setValue            uint32
+	setError            error
+}
+
+func (options *fakePhysicalTunnelSocketOptions) readNotSentLowat() (uint32, error) {
+	index := 2 - len(options.notSentLowat)
+	value := options.notSentLowat[0]
+	options.notSentLowat = options.notSentLowat[1:]
+	return value, indexedPhysicalTunnelError(options.notSentLowatErrors, index)
+}
+
+func (options *fakePhysicalTunnelSocketOptions) readSendBuffer() (int, error) {
+	index := 2 - len(options.sendBuffer)
+	value := options.sendBuffer[0]
+	options.sendBuffer = options.sendBuffer[1:]
+	return value, indexedPhysicalTunnelError(options.sendBufferErrors, index)
+}
+
+func (options *fakePhysicalTunnelSocketOptions) readReceiveBuffer() (int, error) {
+	index := 2 - len(options.receiveBuffer)
+	value := options.receiveBuffer[0]
+	options.receiveBuffer = options.receiveBuffer[1:]
+	return value, indexedPhysicalTunnelError(options.receiveBufferErrors, index)
+}
+
+func (options *fakePhysicalTunnelSocketOptions) setNotSentLowat(value uint32) error {
+	options.setCalls++
+	options.setValue = value
+	return options.setError
+}
+
+func indexedPhysicalTunnelError(errors []error, index int) error {
+	if index < 0 || index >= len(errors) {
+		return nil
+	}
+	return errors[index]
+}
+
+func newPhysicalTunnelDiagnosticTCPPair(t *testing.T) (*net.TCPConn, *net.TCPConn) {
+	t.Helper()
+	listener, err := net.ListenTCP("tcp", &net.TCPAddr{IP: net.ParseIP("127.0.0.1")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	accepted := make(chan *net.TCPConn, 1)
+	errors := make(chan error, 1)
+	go func() {
+		conn, acceptErr := listener.AcceptTCP()
+		if acceptErr != nil {
+			errors <- acceptErr
+			return
+		}
+		accepted <- conn
+	}()
+	client, err := net.DialTCP("tcp", nil, listener.Addr().(*net.TCPAddr))
+	if err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case server := <-accepted:
+		return client, server
+	case err := <-errors:
+		client.Close()
+		t.Fatal(err)
+	case <-time.After(2 * time.Second):
+		client.Close()
+		t.Fatal("timed out accepting TCP pair")
+	}
+	return nil, nil
+}
