diff --git a/internal/agent/proxy_qualification_lowat_adapter_test.go b/internal/agent/proxy_qualification_lowat_adapter_test.go
new file mode 100644
index 0000000..5a39f89
--- /dev/null
+++ b/internal/agent/proxy_qualification_lowat_adapter_test.go
@@ -0,0 +1,158 @@
+//go:build linux
+
+package agent
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+
+	"p2pstream/internal/tunnel"
+)
+
+const (
+	externalQualificationTunnelSocketSchemaVersion = 1
+	externalQualificationTunnelSocketCapacity      = 64
+)
+
+type externalQualificationTunnelSocketObservation struct {
+	LocalAddress  string `json:"local_address"`
+	RemoteAddress string `json:"remote_address"`
+
+	PlatformSupported     bool   `json:"platform_supported"`
+	ApplyRequested        bool   `json:"apply_requested"`
+	RequestedNotSentLowat uint32 `json:"requested_notsent_lowat"`
+
+	NamespaceNotSentLowat      uint32 `json:"namespace_notsent_lowat"`
+	NamespaceNotSentLowatError string `json:"namespace_notsent_lowat_error"`
+	NotSentLowatBefore         uint32 `json:"notsent_lowat_before"`
+	NotSentLowatBeforeError    string `json:"notsent_lowat_before_error"`
+	NotSentLowatAfter          uint32 `json:"notsent_lowat_after"`
+	NotSentLowatAfterError     string `json:"notsent_lowat_after_error"`
+
+	SendBufferBefore         int    `json:"send_buffer_before"`
+	SendBufferBeforeError    string `json:"send_buffer_before_error"`
+	SendBufferAfter          int    `json:"send_buffer_after"`
+	SendBufferAfterError     string `json:"send_buffer_after_error"`
+	ReceiveBufferBefore      int    `json:"receive_buffer_before"`
+	ReceiveBufferBeforeError string `json:"receive_buffer_before_error"`
+	ReceiveBufferAfter       int    `json:"receive_buffer_after"`
+	ReceiveBufferAfterError  string `json:"receive_buffer_after_error"`
+
+	SetterAttempted  bool   `json:"setter_attempted"`
+	SetterError      string `json:"setter_error"`
+	UnwrapError      string `json:"unwrap_error"`
+	SyscallConnError string `json:"syscall_conn_error"`
+	ControlError     string `json:"control_error"`
+
+	Conclusive         bool   `json:"conclusive"`
+	InconclusiveReason string `json:"inconclusive_reason"`
+}
+
+type externalQualificationTunnelSocketRow struct {
+	Index  int                                          `json:"index"`
+	Socket externalQualificationTunnelSocketObservation `json:"socket"`
+}
+
+type externalQualificationTunnelSocketResponse struct {
+	SchemaVersion       int                                    `json:"schema_version"`
+	ProcessRole         string                                 `json:"process_role"`
+	CapturedUnixNano    int64                                  `json:"captured_unix_nano"`
+	Capacity            int                                    `json:"capacity"`
+	DroppedObservations uint64                                 `json:"dropped_observations"`
+	Observations        []externalQualificationTunnelSocketRow `json:"observations"`
+}
+
+type externalQualificationTunnelSocketStore struct {
+	mu           sync.Mutex
+	observations []externalQualificationTunnelSocketObservation
+	dropped      uint64
+}
+
+func newExternalQualificationTunnelSocketStore() *externalQualificationTunnelSocketStore {
+	return &externalQualificationTunnelSocketStore{
+		observations: make([]externalQualificationTunnelSocketObservation, 0, externalQualificationTunnelSocketCapacity),
+	}
+}
+
+func (s *externalQualificationTunnelSocketStore) observe(observation tunnel.PhysicalTunnelSocketObservation) {
+	row := externalQualificationTunnelSocketObservationFromTunnel(observation)
+	s.mu.Lock()
+	if len(s.observations) < externalQualificationTunnelSocketCapacity {
+		s.observations = append(s.observations, row)
+	} else {
+		s.dropped++
+	}
+	s.mu.Unlock()
+}
+
+func (s *externalQualificationTunnelSocketStore) snapshot() externalQualificationTunnelSocketResponse {
+	s.mu.Lock()
+	rows := make([]externalQualificationTunnelSocketRow, len(s.observations))
+	for i, observation := range s.observations {
+		rows[i] = externalQualificationTunnelSocketRow{Index: i, Socket: observation}
+	}
+	dropped := s.dropped
+	s.mu.Unlock()
+	return externalQualificationTunnelSocketResponse{
+		SchemaVersion: externalQualificationTunnelSocketSchemaVersion,
+		ProcessRole:   "agent", CapturedUnixNano: time.Now().UnixNano(),
+		Capacity:            externalQualificationTunnelSocketCapacity,
+		DroppedObservations: dropped, Observations: rows,
+	}
+}
+
+func writeExternalQualificationTunnelSocketSnapshot(w http.ResponseWriter, store *externalQualificationTunnelSocketStore) {
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(store.snapshot())
+}
+
+func externalQualificationTunnelSocketObservationFromTunnel(value tunnel.PhysicalTunnelSocketObservation) externalQualificationTunnelSocketObservation {
+	return externalQualificationTunnelSocketObservation{
+		LocalAddress: value.LocalAddress, RemoteAddress: value.RemoteAddress,
+		PlatformSupported: value.PlatformSupported, ApplyRequested: value.ApplyRequested,
+		RequestedNotSentLowat:      value.RequestedNotSentLowat,
+		NamespaceNotSentLowat:      value.NamespaceNotSentLowat,
+		NamespaceNotSentLowatError: value.NamespaceNotSentLowatError,
+		NotSentLowatBefore:         value.NotSentLowatBefore, NotSentLowatBeforeError: value.NotSentLowatBeforeError,
+		NotSentLowatAfter: value.NotSentLowatAfter, NotSentLowatAfterError: value.NotSentLowatAfterError,
+		SendBufferBefore: value.SendBufferBefore, SendBufferBeforeError: value.SendBufferBeforeError,
+		SendBufferAfter: value.SendBufferAfter, SendBufferAfterError: value.SendBufferAfterError,
+		ReceiveBufferBefore: value.ReceiveBufferBefore, ReceiveBufferBeforeError: value.ReceiveBufferBeforeError,
+		ReceiveBufferAfter: value.ReceiveBufferAfter, ReceiveBufferAfterError: value.ReceiveBufferAfterError,
+		SetterAttempted: value.SetterAttempted, SetterError: value.SetterError,
+		UnwrapError: value.UnwrapError, SyscallConnError: value.SyscallConnError, ControlError: value.ControlError,
+		Conclusive: value.Conclusive, InconclusiveReason: value.InconclusiveReason,
+	}
+}
+
+func TestExternalQualificationTunnelSocketStoreHasBoundedVersionedSchema(t *testing.T) {
+	store := newExternalQualificationTunnelSocketStore()
+	for index := 0; index <= externalQualificationTunnelSocketCapacity; index++ {
+		store.observe(tunnel.PhysicalTunnelSocketObservation{
+			LocalAddress: "127.0.0.1:1", RemoteAddress: "127.0.0.1:2",
+			PlatformSupported: true, Conclusive: true,
+		})
+	}
+	recorder := httptest.NewRecorder()
+	writeExternalQualificationTunnelSocketSnapshot(recorder, store)
+	if recorder.Code != http.StatusOK || recorder.Header().Get("Content-Type") != "application/json" {
+		t.Fatalf("response = status %d content-type %q", recorder.Code, recorder.Header().Get("Content-Type"))
+	}
+	var got externalQualificationTunnelSocketResponse
+	if err := json.NewDecoder(recorder.Body).Decode(&got); err != nil {
+		t.Fatal(err)
+	}
+	if got.SchemaVersion != 1 || got.ProcessRole != "agent" || got.Capacity != 64 ||
+		got.DroppedObservations != 1 || len(got.Observations) != 64 || got.CapturedUnixNano <= 0 {
+		t.Fatalf("socket snapshot = %+v", got)
+	}
+	for index, row := range got.Observations {
+		if row.Index != index || !row.Socket.Conclusive || !row.Socket.PlatformSupported {
+			t.Fatalf("socket row %d = %+v", index, row)
+		}
+	}
+}
diff --git a/internal/agent/tunnel_socket_diagnostic_test.go b/internal/agent/tunnel_socket_diagnostic_test.go
new file mode 100644
index 0000000..a62efc4
--- /dev/null
+++ b/internal/agent/tunnel_socket_diagnostic_test.go
@@ -0,0 +1,159 @@
+//go:build linux
+
+package agent
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+	"net"
+	"net/http"
+	"testing"
+	"time"
+
+	"p2pstream/internal/tunnel"
+)
+
+func TestManagementTunnelSocketDiagnosticWrapsDedicatedDialOnly(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	accepted := make(chan net.Conn, 1)
+	go func() {
+		conn, acceptErr := listener.Accept()
+		if acceptErr == nil {
+			accepted <- conn
+		}
+	}()
+
+	baseDialCalls := 0
+	baseTransport := &http.Transport{
+		DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
+			baseDialCalls++
+			return (&net.Dialer{}).DialContext(ctx, network, address)
+		},
+	}
+	baseClient := &http.Client{Transport: baseTransport}
+	observations := make(chan tunnel.PhysicalTunnelSocketObservation, 1)
+	tunnelClient, err := managementTunnelHTTPClientWithSocketDiagnostic(baseClient, func(observation tunnel.PhysicalTunnelSocketObservation) {
+		observations <- observation
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if tunnelClient.Transport == baseTransport {
+		t.Fatal("dedicated tunnel client reused the general management transport")
+	}
+	transport := tunnelClient.Transport.(*http.Transport)
+	conn, err := transport.DialContext(t.Context(), "tcp", listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	serverConn := <-accepted
+	defer serverConn.Close()
+	observation := <-observations
+	if !observation.Conclusive {
+		t.Fatalf("observation = %+v, want conclusive", observation)
+	}
+	if baseDialCalls != 1 {
+		t.Fatalf("base DialContext calls = %d, want 1", baseDialCalls)
+	}
+	if baseTransport.TLSNextProto != nil || baseTransport.Protocols != nil {
+		t.Fatalf("base transport was mutated: %+v", baseTransport)
+	}
+}
+
+func TestManagementTunnelSocketDiagnosticUsesDefaultCompatibleDialer(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	accepted := make(chan net.Conn, 1)
+	go func() {
+		conn, acceptErr := listener.Accept()
+		if acceptErr == nil {
+			accepted <- conn
+		}
+	}()
+
+	client, err := managementTunnelHTTPClientWithSocketDiagnostic(&http.Client{Transport: &http.Transport{}}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn, err := client.Transport.(*http.Transport).DialContext(t.Context(), "tcp", listener.Addr().String())
+	if err != nil {
+		t.Fatalf("fallback DialContext() error = %v", err)
+	}
+	defer conn.Close()
+	serverConn := <-accepted
+	defer serverConn.Close()
+}
+
+func TestManagementTunnelSocketDiagnosticRejectsTLSDialHooks(t *testing.T) {
+	tests := []struct {
+		name      string
+		transport *http.Transport
+	}{
+		{name: "DialTLSContext", transport: &http.Transport{DialTLSContext: func(context.Context, string, string) (net.Conn, error) {
+			return nil, errors.New("unused")
+		}}},
+		{name: "DialTLS", transport: &http.Transport{DialTLS: func(string, string) (net.Conn, error) {
+			return nil, errors.New("unused")
+		}}},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if _, err := managementTunnelHTTPClientWithSocketDiagnostic(&http.Client{Transport: test.transport}, nil); err == nil {
+				t.Fatal("managementTunnelHTTPClientWithSocketDiagnostic() unexpectedly accepted a TLS dial hook")
+			}
+		})
+	}
+}
+
+func TestManagementTunnelSocketDiagnosticClosesInconclusiveConnection(t *testing.T) {
+	clientSide, serverSide := net.Pipe()
+	transport := &http.Transport{DialContext: func(context.Context, string, string) (net.Conn, error) {
+		return clientSide, nil
+	}}
+	observations := make(chan tunnel.PhysicalTunnelSocketObservation, 1)
+	client, err := managementTunnelHTTPClientWithSocketDiagnostic(&http.Client{Transport: transport}, func(observation tunnel.PhysicalTunnelSocketObservation) {
+		observations <- observation
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn, err := client.Transport.(*http.Transport).DialContext(t.Context(), "tcp", "diagnostic.invalid:443")
+	if err == nil || conn != nil {
+		t.Fatalf("DialContext() = %v, %v, want closed inconclusive error", conn, err)
+	}
+	observation := <-observations
+	if observation.Conclusive || observation.UnwrapError == "" {
+		t.Fatalf("observation = %+v, want unwrap failure", observation)
+	}
+	_ = serverSide.SetReadDeadline(time.Now().Add(time.Second))
+	buffer := make([]byte, 1)
+	if _, err := serverSide.Read(buffer); err == nil {
+		t.Fatal("peer remained open after inconclusive diagnostic")
+	}
+	serverSide.Close()
+}
+
+func TestManagementTunnelSocketDiagnosticLeavesTLSConfigOnClone(t *testing.T) {
+	baseTLS := &tls.Config{MinVersion: tls.VersionTLS13}
+	baseTransport := &http.Transport{TLSClientConfig: baseTLS}
+	client, err := managementTunnelHTTPClientWithSocketDiagnostic(&http.Client{Transport: baseTransport}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := client.Transport.(*http.Transport).TLSClientConfig
+	if got == baseTLS || got.MinVersion != tls.VersionTLS13 {
+		t.Fatalf("diagnostic TLS config = %p/%d, base = %p/%d", got, got.MinVersion, baseTLS, baseTLS.MinVersion)
+	}
+	if baseTLS.NextProtos != nil {
+		t.Fatalf("base TLS config was mutated: %+v", baseTLS)
+	}
+}
diff --git a/internal/server/agent_tunnel_socket_diagnostic_test.go b/internal/server/agent_tunnel_socket_diagnostic_test.go
