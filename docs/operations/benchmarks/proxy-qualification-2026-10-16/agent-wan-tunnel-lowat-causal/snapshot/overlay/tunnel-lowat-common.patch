+func managementTunnelHTTPClientWithSocketDiagnostic(
+	base *http.Client,
+	observer func(tunnel.PhysicalTunnelSocketObservation),
+) (*http.Client, error) {
+	client, err := managementTunnelHTTPClient(base)
+	if err != nil {
+		return nil, err
+	}
+	transport, ok := client.Transport.(*http.Transport)
+	if !ok {
+		return nil, fmt.Errorf("diagnostic management tunnel transport is %T, want *http.Transport", client.Transport)
+	}
+	// A custom TLS dial hook bypasses DialContext and could silently leave the
+	// candidate arm observing a socket other than the physical tunnel. Reject it
+	// in these temporary diagnostic builds rather than altering its semantics.
+	if transport.DialTLSContext != nil || transport.DialTLS != nil {
+		return nil, errors.New("diagnostic management tunnel transport does not support custom TLS dial hooks")
+	}
+	dialContext := transport.DialContext
+	if dialContext == nil {
+		dialer := &net.Dialer{Timeout: 30 * time.Second, KeepAlive: 30 * time.Second}
+		dialContext = dialer.DialContext
+	}
+	transport.DialContext = func(ctx context.Context, network, address string) (net.Conn, error) {
+		conn, err := dialContext(ctx, network, address)
+		if err != nil {
+			return nil, err
+		}
+		observation, observationErr := tunnel.ObservePhysicalTunnelSocket(conn)
+		// The qualification observer is a bounded, store-only callback. Invoke it
+		// after socket inspection has released SyscallConn.Control and before TLS.
+		if observer != nil {
+			observer(observation)
+		}
+		if observationErr != nil {
+			_ = conn.Close()
+			return nil, fmt.Errorf("inspect diagnostic management tunnel socket: %w", observationErr)
+		}
+		return conn, nil
+	}
+	return client, nil
+}
+
