diff --git a/internal/tunnel/physical_socket_diagnostic.go b/internal/tunnel/physical_socket_diagnostic.go
new file mode 100644
index 0000000..42d17dc
--- /dev/null
+++ b/internal/tunnel/physical_socket_diagnostic.go
@@ -0,0 +1,148 @@
+package tunnel
+
+import (
+	"crypto/tls"
+	"errors"
+	"fmt"
+	"net"
+)
+
+const (
+	// diagnosticApplyTunnelNotSentLowat is the sole difference between the
+	// temporary control and candidate diagnostic builds. It is deliberately
+	// private and is not a production configuration surface.
+	diagnosticApplyTunnelNotSentLowat = false
+
+	diagnosticTunnelNotSentLowat = uint32(32 * 1024)
+)
+
+// ErrPhysicalTunnelSocketDiagnosticInconclusive reports that a temporary
+// tunnel-socket experiment cannot prove that it observed the intended socket
+// state. The diagnostic builds reject that connection instead of silently
+// mixing experimental arms. This strict policy is not a proposed production
+// fallback for unsupported kernels.
+var ErrPhysicalTunnelSocketDiagnosticInconclusive = errors.New("physical tunnel socket diagnostic is inconclusive")
+
+// PhysicalTunnelSocketObservation is fixed startup evidence for one physical
+// tunnel connection. Buffer values are observations only: the diagnostic never
+// sets SO_SNDBUF or SO_RCVBUF, and ordinary kernel autotuning may change them.
+type PhysicalTunnelSocketObservation struct {
+	LocalAddress  string
+	RemoteAddress string
+
+	PlatformSupported     bool
+	ApplyRequested        bool
+	RequestedNotSentLowat uint32
+
+	NamespaceNotSentLowat      uint32
+	NamespaceNotSentLowatError string
+
+	NotSentLowatBefore      uint32
+	NotSentLowatBeforeError string
+	NotSentLowatAfter       uint32
+	NotSentLowatAfterError  string
+
+	SendBufferBefore      int
+	SendBufferBeforeError string
+	SendBufferAfter       int
+	SendBufferAfterError  string
+
+	ReceiveBufferBefore      int
+	ReceiveBufferBeforeError string
+	ReceiveBufferAfter       int
+	ReceiveBufferAfterError  string
+
+	SetterAttempted  bool
+	SetterError      string
+	UnwrapError      string
+	SyscallConnError string
+	ControlError     string
+
+	Conclusive         bool
+	InconclusiveReason string
+}
+
+// ObservePhysicalTunnelSocket captures the physical socket's startup options
+// and, in the temporary candidate build only, sets TCP_NOTSENT_LOWAT to 32 KiB.
+// It accepts only the two connection shapes used by the tunnel endpoints: a
+// raw TCP connection or a TLS connection directly over raw TCP.
+func ObservePhysicalTunnelSocket(conn net.Conn) (PhysicalTunnelSocketObservation, error) {
+	observation := PhysicalTunnelSocketObservation{
+		ApplyRequested:        diagnosticApplyTunnelNotSentLowat,
+		RequestedNotSentLowat: diagnosticTunnelNotSentLowat,
+	}
+	if conn != nil {
+		if address := conn.LocalAddr(); address != nil {
+			observation.LocalAddress = address.String()
+		}
+		if address := conn.RemoteAddr(); address != nil {
+			observation.RemoteAddress = address.String()
+		}
+	}
+
+	tcp, err := physicalTunnelTCPConn(conn)
+	if err != nil {
+		observation.UnwrapError = err.Error()
+		return finishPhysicalTunnelSocketObservation(observation)
+	}
+	observePhysicalTunnelSocketPlatform(tcp, &observation)
+	return finishPhysicalTunnelSocketObservation(observation)
+}
+
+func physicalTunnelTCPConn(conn net.Conn) (*net.TCPConn, error) {
+	switch typed := conn.(type) {
+	case *net.TCPConn:
+		return typed, nil
+	case *tls.Conn:
+		tcp, ok := typed.NetConn().(*net.TCPConn)
+		if !ok {
+			return nil, fmt.Errorf("TLS network connection is %T, want *net.TCPConn", typed.NetConn())
+		}
+		return tcp, nil
+	default:
+		return nil, fmt.Errorf("network connection is %T, want *net.TCPConn or *tls.Conn", conn)
+	}
+}
+
+func finishPhysicalTunnelSocketObservation(observation PhysicalTunnelSocketObservation) (PhysicalTunnelSocketObservation, error) {
+	reason := physicalTunnelSocketInconclusiveReason(observation)
+	if reason == "" {
+		observation.Conclusive = true
+		return observation, nil
+	}
+	observation.InconclusiveReason = reason
+	return observation, fmt.Errorf("%w: %s", ErrPhysicalTunnelSocketDiagnosticInconclusive, reason)
+}
+
+func physicalTunnelSocketInconclusiveReason(observation PhysicalTunnelSocketObservation) string {
+	switch {
+	case observation.UnwrapError != "":
+		return "unsupported tunnel connection shape"
+	case !observation.PlatformSupported:
+		return "platform does not expose the required socket options"
+	case observation.NamespaceNotSentLowatError != "":
+		return "cannot read the namespace TCP_NOTSENT_LOWAT default"
+	case observation.SyscallConnError != "":
+		return "cannot access the TCP socket descriptor"
+	case observation.ControlError != "":
+		return "cannot inspect the TCP socket descriptor"
+	case observation.NotSentLowatBeforeError != "" || observation.NotSentLowatAfterError != "":
+		return "cannot read TCP_NOTSENT_LOWAT"
+	case observation.SendBufferBeforeError != "" || observation.SendBufferAfterError != "":
+		return "cannot read SO_SNDBUF"
+	case observation.ReceiveBufferBeforeError != "" || observation.ReceiveBufferAfterError != "":
+		return "cannot read SO_RCVBUF"
+	case observation.ApplyRequested && !observation.SetterAttempted:
+		return "TCP_NOTSENT_LOWAT was not attempted"
+	case observation.ApplyRequested && observation.SetterError != "":
+		return "cannot set TCP_NOTSENT_LOWAT"
+	case observation.ApplyRequested && observation.NotSentLowatAfter != observation.RequestedNotSentLowat:
+		return "TCP_NOTSENT_LOWAT does not match the candidate value"
+	case !observation.ApplyRequested && observation.SetterAttempted:
+		return "control arm attempted to set TCP_NOTSENT_LOWAT"
+	case !observation.ApplyRequested && observation.NotSentLowatAfter != observation.NotSentLowatBefore:
+		return "TCP_NOTSENT_LOWAT changed in the control arm"
+	default:
+		return ""
+	}
+}
diff --git a/internal/tunnel/physical_socket_diagnostic_linux.go b/internal/tunnel/physical_socket_diagnostic_linux.go
new file mode 100644
index 0000000..6f6c6c0
--- /dev/null
+++ b/internal/tunnel/physical_socket_diagnostic_linux.go
@@ -0,0 +1,100 @@
+//go:build linux
+
+package tunnel
+
+import (
+	"net"
+	"os"
+	"strconv"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+const tcpNotSentLowatNamespacePath = "/proc/sys/net/ipv4/tcp_notsent_lowat"
+
+type physicalTunnelSocketOptionAccess interface {
+	readNotSentLowat() (uint32, error)
+	readSendBuffer() (int, error)
+	readReceiveBuffer() (int, error)
+	setNotSentLowat(uint32) error
+}
+
+type physicalTunnelSocketFD int
+
+func (fd physicalTunnelSocketFD) readNotSentLowat() (uint32, error) {
+	value, err := unix.GetsockoptInt(int(fd), unix.IPPROTO_TCP, unix.TCP_NOTSENT_LOWAT)
+	return uint32(value), err
+}
+
+func (fd physicalTunnelSocketFD) readSendBuffer() (int, error) {
+	return unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_SNDBUF)
+}
+
+func (fd physicalTunnelSocketFD) readReceiveBuffer() (int, error) {
+	return unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_RCVBUF)
+}
+
+func (fd physicalTunnelSocketFD) setNotSentLowat(value uint32) error {
+	return unix.SetsockoptInt(int(fd), unix.IPPROTO_TCP, unix.TCP_NOTSENT_LOWAT, int(value))
+}
+
+func observePhysicalTunnelSocketPlatform(tcp *net.TCPConn, observation *PhysicalTunnelSocketObservation) {
+	observation.PlatformSupported = true
+	value, err := readPhysicalTunnelNotSentLowatNamespace(tcpNotSentLowatNamespacePath)
+	observation.NamespaceNotSentLowat = value
+	observation.NamespaceNotSentLowatError = diagnosticErrorString(err)
+
+	raw, err := tcp.SyscallConn()
+	if err != nil {
+		observation.SyscallConnError = err.Error()
+		return
+	}
+	if err := raw.Control(func(fd uintptr) {
+		observePhysicalTunnelSocketOptions(physicalTunnelSocketFD(fd), observation)
+	}); err != nil {
+		observation.ControlError = err.Error()
+	}
+}
+
+func observePhysicalTunnelSocketOptions(options physicalTunnelSocketOptionAccess, observation *PhysicalTunnelSocketObservation) {
+	observation.NotSentLowatBefore, observation.NotSentLowatBeforeError = readPhysicalTunnelUint32Option(options.readNotSentLowat)
+	observation.SendBufferBefore, observation.SendBufferBeforeError = readPhysicalTunnelIntOption(options.readSendBuffer)
+	observation.ReceiveBufferBefore, observation.ReceiveBufferBeforeError = readPhysicalTunnelIntOption(options.readReceiveBuffer)
+	if observation.ApplyRequested {
+		observation.SetterAttempted = true
+		observation.SetterError = diagnosticErrorString(options.setNotSentLowat(observation.RequestedNotSentLowat))
+	}
+	observation.NotSentLowatAfter, observation.NotSentLowatAfterError = readPhysicalTunnelUint32Option(options.readNotSentLowat)
+	observation.SendBufferAfter, observation.SendBufferAfterError = readPhysicalTunnelIntOption(options.readSendBuffer)
+	observation.ReceiveBufferAfter, observation.ReceiveBufferAfterError = readPhysicalTunnelIntOption(options.readReceiveBuffer)
+}
+
+func readPhysicalTunnelNotSentLowatNamespace(path string) (uint32, error) {
+	value, err := os.ReadFile(path)
+	if err != nil {
+		return 0, err
+	}
+	parsed, err := strconv.ParseUint(strings.TrimSpace(string(value)), 10, 32)
+	if err != nil {
+		return 0, err
+	}
+	return uint32(parsed), nil
+}
+
+func readPhysicalTunnelUint32Option(read func() (uint32, error)) (uint32, string) {
+	value, err := read()
+	return value, diagnosticErrorString(err)
+}
+
+func readPhysicalTunnelIntOption(read func() (int, error)) (int, string) {
+	value, err := read()
+	return value, diagnosticErrorString(err)
+}
+
+func diagnosticErrorString(err error) string {
+	if err == nil {
+		return ""
+	}
+	return err.Error()
+}
diff --git a/internal/tunnel/physical_socket_diagnostic_linux_test.go b/internal/tunnel/physical_socket_diagnostic_linux_test.go
new file mode 100644
index 0000000..a5cdfb3
--- /dev/null
+++ b/internal/tunnel/physical_socket_diagnostic_linux_test.go
@@ -0,0 +1,246 @@
+//go:build linux
+
+package tunnel
+
+import (
+	"crypto/tls"
+	"errors"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestObservePhysicalTunnelSocketRealTCP(t *testing.T) {
+	client, server := newPhysicalTunnelDiagnosticTCPPair(t)
+	defer client.Close()
+	defer server.Close()
+
+	observation, err := ObservePhysicalTunnelSocket(client)
+	if err != nil {
+		t.Fatalf("ObservePhysicalTunnelSocket() error = %v; observation = %+v", err, observation)
+	}
+	if !observation.Conclusive || !observation.PlatformSupported {
+		t.Fatalf("observation = %+v, want conclusive Linux evidence", observation)
+	}
+	if observation.LocalAddress == "" || observation.RemoteAddress == "" {
+		t.Fatalf("observation addresses = %q -> %q", observation.LocalAddress, observation.RemoteAddress)
+	}
+	if observation.ApplyRequested {
+		if !observation.SetterAttempted || observation.NotSentLowatAfter != diagnosticTunnelNotSentLowat {
+			t.Fatalf("candidate observation = %+v, want exact LOWAT %d", observation, diagnosticTunnelNotSentLowat)
+		}
+	} else if observation.SetterAttempted || observation.NotSentLowatAfter != observation.NotSentLowatBefore {
+		t.Fatalf("control observation = %+v, want unchanged LOWAT", observation)
+	}
+	if observation.SendBufferBefore <= 0 || observation.SendBufferAfter <= 0 || observation.ReceiveBufferBefore <= 0 || observation.ReceiveBufferAfter <= 0 {
+		t.Fatalf("buffer observations = %+v, want positive values", observation)
+	}
+}
+
+func TestObservePhysicalTunnelSocketAcceptsTLSDirectlyOverTCP(t *testing.T) {
+	client, server := newPhysicalTunnelDiagnosticTCPPair(t)
+	defer server.Close()
+	secured := tls.Client(client, &tls.Config{InsecureSkipVerify: true}) //nolint:gosec -- no handshake; tests exact unwrap shape
+	defer secured.Close()
+
+	observation, err := ObservePhysicalTunnelSocket(secured)
+	if err != nil {
+		t.Fatalf("ObservePhysicalTunnelSocket(*tls.Conn) error = %v; observation = %+v", err, observation)
+	}
+	if !observation.Conclusive {
+		t.Fatalf("observation = %+v, want conclusive", observation)
+	}
+}
+
