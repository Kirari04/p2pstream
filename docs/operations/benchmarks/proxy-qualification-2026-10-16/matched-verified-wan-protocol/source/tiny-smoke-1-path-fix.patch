 done
@@ -61,6 +63,8 @@
 openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
   -subj /CN=public.test -addext subjectAltName=DNS:public.test -days 1 \
   -keyout "$key" -out "$cert" >/dev/null 2>&1
+cert=$(realpath "$cert")
