#!/usr/bin/env python3
"""Freeze, build, and run the finite matched Caddy/HAProxy comparison."""
import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import statistics
import subprocess
import tarfile
import tempfile
import time


def sha(path):
    digest = hashlib.sha256()
    with Path(path).open("rb") as source:
        for block in iter(lambda: source.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def output(command, **kwargs):
    return subprocess.check_output(command, text=True, **kwargs).strip()


def utc():
    return datetime.now(timezone.utc).isoformat()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source-ref", required=True)
    parser.add_argument("--caddy-binary", required=True)
    parser.add_argument("--go-binary", required=True, help="exact installed Go 1.26.6 executable")
    parser.add_argument("--prepare-only", action="store_true", help="archive and validate sources without a Go build or workload")
    parser.add_argument("--build-only", action="store_true", help="freeze and build, without a workload")
    args = parser.parse_args()
    repo = Path("/home/user/.codex/worktrees/astra-proxy-performance/p2pstream")
    reference = args.source_ref
    if not re.fullmatch(r"[0-9a-f]{40}", reference):
        parser.error("--source-ref must be a full immutable commit")
    if output(["git", "rev-parse", reference + "^{commit}"], cwd=repo) != reference:
        parser.error("source ref did not resolve exactly")
    if len(os.sched_getaffinity(0)) < 8:
        parser.error("the matched workload needs at least eight available logical CPUs")
    caddy_input = Path(args.caddy_binary).resolve(strict=True)
    go = Path(args.go_binary).resolve(strict=True)
    release_path = repo / "docs/operations/benchmarks/proxy-qualification-2026-10-16/caddy-reference/release-provenance.json"
    release = json.loads(release_path.read_text())
    if sha(caddy_input) != release["extracted_binary_sha256"]:
        parser.error("Caddy binary differs from the previously verified official release")
    parent = repo / "tmp/proxy-qualification"
    parent.mkdir(parents=True, exist_ok=True)
    root = Path(tempfile.mkdtemp(prefix="final-reference-" + reference[:8] + ".", dir=parent))
    root.chmod(0o700)
    Path("/tmp/p2pstream-final-reference-root-path").write_text(str(root) + "\n")
    shutil.copyfile(__file__, root / "wrapper.py.txt")
    shutil.copyfile(release_path, root / "caddy-release-provenance.json")
    source = root / "source"
    source.mkdir()
    archive = root / "source.tar"
    with archive.open("wb") as stream:
        subprocess.run(["git", "archive", reference], cwd=repo, stdout=stream, check=True)
    with tarfile.open(archive) as stream:
        stream.extractall(source, filter="data")
    runner = source / "scripts/qualify-proxy-caddy.sh"
    harness = source / "internal/server/proxy_qualification_test.go"
    for path in (runner, harness):
        committed = subprocess.check_output(["git", "show", reference + ":" + str(path.relative_to(source))], cwd=repo)
        if committed != path.read_bytes():
            raise RuntimeError("archive source differs from immutable commit")
    if b"--matched-h2-single-connection" not in runner.read_bytes():
        raise RuntimeError("source does not contain the reviewed matched H2 fixture")
    gotmp = root / "gotmp"
    gotmp.mkdir()
    env = dict(os.environ)
    for key in ("TMPDIR", "TEMP", "TMP", "GOTMPDIR"):
        env[key] = str(gotmp)
    env.update(GOFLAGS="", GOWORK="off", GOTOOLCHAIN="local")
    env["PATH"] = str(go.parent) + os.pathsep + env["PATH"]
    manifest = {
        "source_ref": reference,
        "source_tree": output(["git", "rev-parse", reference + "^{tree}"], cwd=repo),
        "source_archive_sha256": sha(archive), "source_overlays": [],
        "runner_sha256": sha(runner), "harness_sha256": sha(harness),
        "wrapper_sha256": sha(root / "wrapper.py.txt"),
        "caddy_release_provenance_sha256": sha(root / "caddy-release-provenance.json"),
        "temporary_environment": {key: env[key] for key in ("TMPDIR", "TEMP", "TMP", "GOTMPDIR", "GOFLAGS", "GOWORK", "GOTOOLCHAIN")},
        "predeclared": {"runs": 3, "duration_seconds": 10, "warmup_seconds": 2,
            "idle_per_host": 128, "concurrency": [16, 128], "protocols": ["h1", "h2"],
            "total_rows": 36, "matched_h2_single_connection": True,
            "haproxy_throughput_ratio_minimum": 0.80,
            "saturated_p95_p99_ratio_diagnostic_limit": 1.25,
            "latency_scope": "closed-loop saturated tails only; separate below-capacity offered-load latency qualification remains pending",
            "scope": "direct tiny GET reference; topology-matched H2, not HAProxy maximum throughput or broad parity"},
        "created_utc": utc(), "workload_started": False,
    }
    manifest_path = root / "manifest.json"
    def save():
        manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")
    save()
    print("Frozen reference root:", root, flush=True)
    if args.prepare_only:
        return
    manifest["go_executable"] = {"path": str(go), "sha256": sha(go)}
    manifest["go_environment"] = json.loads(output([str(go), "env", "-json", "GOVERSION", "GOOS", "GOARCH", "GOAMD64", "CGO_ENABLED", "GOFLAGS", "GOEXPERIMENT", "GOTOOLCHAIN"], cwd=source, env=env))
    if manifest["go_environment"]["GOVERSION"] != "go1.26.6":
        save()
        raise RuntimeError("exact Go 1.26.6 required")
    binaries = root / "bin"
    binaries.mkdir()
    candidate = binaries / "server.test"
    command = [str(go), "test", "-c", "-o", str(candidate), "./internal/server"]
    manifest["build_command"] = command
    save()
    started = time.monotonic()
    with (root / "build.log").open("w") as log:
        result = subprocess.run(command, cwd=source, env=env, stdout=log, stderr=subprocess.STDOUT)
    manifest["build"] = {"exit_code": result.returncode, "elapsed_seconds": time.monotonic() - started, "log_sha256": sha(root / "build.log")}
    save()
    if result.returncode:
        raise RuntimeError("clean build failed; preserved build.log")
    caddy = binaries / "caddy"
    shutil.copy2(caddy_input, caddy)
    build_info = output([str(go), "version", "-m", str(candidate)], env=env)
    if re.search(r"\b-tags(?:=|\s)", build_info) or not build_info.splitlines()[0].endswith(": go1.26.6"):
        raise RuntimeError("ordinary tag-off binary required")
    manifest["binaries"] = {"candidate_and_driver": {"path": str(candidate), "sha256": sha(candidate),
        "build_id": output([str(go), "tool", "buildid", str(candidate)], env=env), "build_info": build_info},
        "caddy": {"sha256": sha(caddy), "build_info": output([str(go), "version", "-m", str(caddy)], env=env)}}
    if not manifest["binaries"]["candidate_and_driver"]["build_id"]:
        raise RuntimeError("missing candidate/driver Go build ID")
    save()
    if args.build_only:
        return
    invocation = ["bash", str(runner), "--caddy-binary", str(caddy), "--driver-binary", str(candidate),
        "--candidate-binary", str(candidate), "--candidate-label", "final-" + reference[:8],
        "--driver-source-ref", reference, "--candidate-source-ref", reference,
        "--harness-source", str(harness), "--runs", "3", "--duration-seconds", "10",
        "--warmup-seconds", "2", "--idle-per-host", "128", "--concurrency", "16,128",
        "--protocol", "both", "--matched-h2-single-connection"]
    manifest.update(workload_started=True, workload_started_utc=utc(), workload_command=invocation)
    save()
    started = time.monotonic()
    with (root / "run.log").open("w") as log:
        process = subprocess.Popen(invocation, cwd=source, env=env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        failure = None
        code = None
        owned_names = []
        old_sigterm = signal.getsignal(signal.SIGTERM)
        def terminate(signum, frame):
            raise SystemExit(128 + signum)
        signal.signal(signal.SIGTERM, terminate)
        try:
            code = process.wait(timeout=1200)
        except BaseException as exc:
            failure = exc
        finally:
            cleanup_error = None
            forced_group_cleanup = False
            def group_alive():
                try:
                    os.killpg(process.pid, 0)
                    return True
                except ProcessLookupError:
                    return False
            try:
                if group_alive():
                    forced_group_cleanup = True
                    try:
                        os.killpg(process.pid, signal.SIGINT)
                    except ProcessLookupError:
                        pass
                    deadline = time.monotonic() + 15
                    while group_alive() and time.monotonic() < deadline:
                        process.poll()
                        time.sleep(.05)
                    if group_alive():
                        try:
                            os.killpg(process.pid, signal.SIGKILL)
                        except ProcessLookupError:
                            pass
                    if process.poll() is None:
                        process.wait(timeout=5)
                owned_names = output(["docker", "ps", "-a", "--filter", "name=^p2pstream-caddy-ref-" + str(process.pid) + "-", "--format", "{{.Names}}"], env=env).splitlines()
                for name in owned_names:
                    if not name.startswith("p2pstream-caddy-ref-" + str(process.pid) + "-"):
                        raise RuntimeError("container cleanup ownership mismatch")
                    subprocess.run(["docker", "rm", "-f", name], check=True, stdout=log, stderr=subprocess.STDOUT)
            except BaseException as exc:
                cleanup_error = exc
            finally:
                signal.signal(signal.SIGTERM, old_sigterm)
                manifest["workload"] = {"exit_code": process.returncode, "wait_completed": code is not None,
                    "exception": repr(failure) if failure else None,
                    "cleanup_exception": repr(cleanup_error) if cleanup_error else None,
                    "elapsed_seconds": time.monotonic() - started, "finished_utc": utc(),
                    "forced_group_cleanup": forced_group_cleanup, "forced_container_cleanup": owned_names}
                log.flush()
                manifest["workload"]["log_sha256"] = sha(root / "run.log")
                save()
    if failure is not None:
        raise failure
    if cleanup_error is not None:
        raise cleanup_error
    if code or owned_names or forced_group_cleanup:
        raise RuntimeError("reference runner or owned container cleanup failed")
    runs = list((source / "tmp/caddy-reference").glob("run.*"))
    if len(runs) != 1:
        raise RuntimeError("expected exactly one owned reference evidence directory")
    run = runs[0]
    provenance = json.loads((run / "provenance.json").read_text())
    binary_sha = manifest["binaries"]["candidate_and_driver"]["sha256"]
    if not (provenance["driver_binary_sha256"] == binary_sha == provenance["candidate_binary_sha256"]
            and provenance["script_sha256"] == manifest["runner_sha256"]
            and provenance["harness_sha256"] == manifest["harness_sha256"]):
        raise RuntimeError("executed runner/binary/harness provenance mismatch")
    rows = [json.loads(line) for line in (run / "results.jsonl").read_text().splitlines()]
    if len(rows) != 36:
        raise RuntimeError("incomplete reference matrix")
    summaries = []
    for protocol in ("h1", "h2"):
        for concurrency in (16, 128):
            groups = {}
            for kind in ("candidate", "caddy", "haproxy"):
                group = [row for row in rows if row["protocol"] == protocol and row["concurrency"] == concurrency and row["proxy_kind"] == kind]
                if len(group) != 3 or {row["iteration"] for row in group} != {1, 2, 3}:
                    raise RuntimeError("missing repeated protocol/concurrency cell")
                groups[kind] = {field: statistics.median(row[field] for row in group) for field in ("useful_requests_per_second", "p95_ms", "p99_ms")}
            ratios = {kind: {field: groups["candidate"][field] / groups[kind][field] for field in groups[kind]} for kind in ("caddy", "haproxy")}
            gates = {"throughput": ratios["haproxy"]["useful_requests_per_second"] >= .80,
                "p95": ratios["haproxy"]["p95_ms"] <= 1.25, "p99": ratios["haproxy"]["p99_ms"] <= 1.25}
            summaries.append({"protocol": protocol, "concurrency": concurrency, "medians": groups, "ratios": ratios, "haproxy_throughput_gate": gates["throughput"], "saturated_tail_diagnostics": {key: value for key, value in gates.items() if key != "throughput"}})
    summary = {"row_count": len(rows), "cells": summaries, "all_reference_throughput_gates_pass": all(row["haproxy_throughput_gate"] for row in summaries),
        "below_capacity_offered_load_latency_qualified": False,
        "scope": manifest["predeclared"]["scope"]}
    (root / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
    manifest.update(reference_run_dir=str(run), reference_provenance_sha256=sha(run / "provenance.json"), results_sha256=sha(run / "results.jsonl"), summary_sha256=sha(root / "summary.json"))
    save()
    print(json.dumps(summary), flush=True)
    if not summary["all_reference_throughput_gates_pass"]:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
