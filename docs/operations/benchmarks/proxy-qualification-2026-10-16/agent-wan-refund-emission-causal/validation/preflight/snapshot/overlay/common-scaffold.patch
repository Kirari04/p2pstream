+	lastID := uint32(0)
+	for i := 0; i < headerCount-1; i++ {
+		hdr := header(batch[i*headerSize : (i+1)*headerSize])
+		if hdr.MsgType() != typeAllocationWindowUpdate || hdr.Flags() != 0 || hdr.StreamID() == 0 || hdr.Length() == 0 || hdr.Length()%AggregateWindowUnitSize != 0 {
+			return false
+		}
+		if i > 0 && hdr.StreamID() <= lastID {
+			return false
+		}
+		lastID = hdr.StreamID()
+	}
+	global := header(batch[(headerCount-1)*headerSize:])
+	return global.MsgType() == typeWindowUpdate && global.Flags() == 0 && global.StreamID() == 0 && global.Length() != 0 && global.Length()%AggregateWindowUnitSize == 0
 }
 
