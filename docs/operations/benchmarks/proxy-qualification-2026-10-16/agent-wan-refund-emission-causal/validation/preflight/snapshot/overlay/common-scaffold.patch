+package yamux
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func diagnosticRefundBatch(streamHeaders int) header {
+	batch := header(make([]byte, (streamHeaders+1)*headerSize))
+	for i := 0; i < streamHeaders; i++ {
+		hdr := header(batch[i*headerSize : (i+1)*headerSize])
+		hdr.encode(typeAllocationWindowUpdate, 0, uint32(2*i+1), AggregateWindowUnitSize)
+	}
+	global := header(batch[streamHeaders*headerSize:])
+	global.encode(typeWindowUpdate, 0, 0, uint32(streamHeaders+1)*AggregateWindowUnitSize)
+	return batch
+}
+
+func diagnosticRefundWriteCount(headerCount int) int {
+	if diagnosticSplitAggregateRefundWrites && headerCount > 1 {
+		return headerCount
+	}
+	return 1
+}
+
+func collectDiagnosticRefundWrites(t *testing.T, writes [][]byte, offset, headerCount int) ([]byte, int) {
+	t.Helper()
+	count := diagnosticRefundWriteCount(headerCount)
+	if offset+count > len(writes) {
+		t.Fatalf("writes[%d:] count=%d, only %d total", offset, count, len(writes))
+	}
+	var joined []byte
+	for _, write := range writes[offset : offset+count] {
+		joined = append(joined, write...)
+	}
+	return joined, offset + count
+}
+
+func TestDiagnosticAggregateRefundClassifierAndEmission(t *testing.T) {
+	for _, streamHeaders := range []int{0, 1, aggregateRefundBatchStreams} {
+		t.Run(fmt.Sprintf("headers_%d", streamHeaders+1), func(t *testing.T) {
+			batch := diagnosticRefundBatch(streamHeaders)
+			if !isAggregateRefundHeaderBatch(batch) {
+				t.Fatal("valid aggregate refund batch was not classified")
+			}
+			conn := newGatherRecordingConn()
+			var committed atomic.Bool
+			conn.committed = &committed
+			session := newGatherSendSession(conn, time.Second)
+			wantWrites := diagnosticRefundWriteCount(streamHeaders + 1)
+			drained := make(chan struct{})
+			go func() {
+				for i := 0; i < wantWrites; i++ {
+					<-conn.wrote
+				}
+				close(drained)
+			}()
+			go func() { _ = session.sendLoop() }()
+			if err := session.waitForAggregateControlBatchErrCommit(batch, make(chan error, 1), func() { committed.Store(true) }); err != nil {
+				t.Fatal(err)
+			}
+			stopGatherSendLoop(t, session)
+			select {
+			case <-drained:
+			case <-time.After(time.Second):
+				t.Fatal("did not observe every physical write")
+			}
+
+			conn.mu.Lock()
+			writes := append([][]byte(nil), conn.writes...)
+			conn.mu.Unlock()
+			if got, want := len(writes), wantWrites; got != want {
+				t.Fatalf("physical writes=%d want=%d", got, want)
+			}
+			if got := bytes.Join(writes, nil); !bytes.Equal(got, batch) {
+				t.Fatalf("wire bytes=%x want=%x", got, batch)
+			}
+			for i, write := range writes {
+				want := len(batch)
+				if diagnosticSplitAggregateRefundWrites && len(batch) > headerSize {
+					want = headerSize
+				}
+				if len(write) != want {
+					t.Fatalf("write %d bytes=%d want=%d", i, len(write), want)
+				}
+			}
+		})
+	}
+}
+
+func TestDiagnosticAggregateRefundSplitDoesNotAffectOtherFrames(t *testing.T) {
+	conn := newGatherRecordingConn()
+	session := newGatherSendSession(conn, time.Second)
+	go func() { _ = session.sendLoop() }()
+
+	unmarked := header(make([]byte, 2*headerSize))
+	header(unmarked[:headerSize]).encode(typePing, flagACK, 0, 1)
+	header(unmarked[headerSize:]).encode(typePing, flagACK, 0, 2)
+	if isAggregateRefundHeaderBatch(unmarked) {
+		t.Fatal("unrelated concatenated controls were classified as aggregate refunds")
+	}
+	if err := session.waitForSendErrCommitOn(session.controlCh, unmarked, nil, make(chan error, 1), nil); err != nil {
+		t.Fatal(err)
+	}
+	body := bytes.Repeat([]byte{0x5a}, 64)
+	data := header(make([]byte, headerSize))
+	data.encode(typeData, 0, 1, uint32(len(body)))
+	if err := session.waitForSend(data, body); err != nil {
+		t.Fatal(err)
+	}
+	stopGatherSendLoop(t, session)
+
+	conn.mu.Lock()
+	writes := append([][]byte(nil), conn.writes...)
+	conn.mu.Unlock()
+	if len(writes) != 2 || !bytes.Equal(writes[0], unmarked) || !bytes.Equal(writes[1], append(append([]byte(nil), data...), body...)) {
+		t.Fatalf("unmarked/DATA physical writes=%x", writes)
+	}
+}
+
+type diagnosticRefundFailureConn struct {
+	mu       sync.Mutex
+	failCall int
+	short    bool
+	err      error
+	calls    int
+	frames   [][]byte
+	commit   *atomic.Int32
+}
+
+func (*diagnosticRefundFailureConn) Read([]byte) (int, error) { return 0, io.EOF }
+func (*diagnosticRefundFailureConn) Close() error             { return nil }
+func (c *diagnosticRefundFailureConn) Write(p []byte) (int, error) {
+	if c.commit != nil && c.commit.Load() != 1 {
+		return 0, errors.New("write did not observe exactly one joint commit")
+	}
+	c.mu.Lock()
+	call := c.calls
+	c.calls++
+	c.frames = append(c.frames, append([]byte(nil), p...))
+	c.mu.Unlock()
+	if call != c.failCall {
+		return len(p), nil
+	}
+	if c.short {
+		return len(p) - 1, nil
+	}
+	return 0, c.err
+}
+
+func TestDiagnosticAggregateRefundSplitFailsWithoutRetry(t *testing.T) {
+	failCalls := []int{0}
+	if diagnosticSplitAggregateRefundWrites {
+		failCalls = []int{0, 1, 8, 16}
+	}
+	for _, short := range []bool{false, true} {
+		for _, failCall := range failCalls {
+			t.Run(fmt.Sprintf("short_%t_call_%d", short, failCall), func(t *testing.T) {
+				writeErr := errors.New("injected aggregate refund write error")
+				var commits atomic.Int32
+				conn := &diagnosticRefundFailureConn{failCall: failCall, short: short, err: writeErr, commit: &commits}
+				session := newGatherSendSession(conn, time.Second)
+				loopDone := make(chan error, 1)
+				go func() { loopDone <- session.sendLoop() }()
+				err := session.waitForAggregateControlBatchErrCommit(diagnosticRefundBatch(aggregateRefundBatchStreams), make(chan error, 1), func() { commits.Add(1) })
+				wantErr := writeErr
+				if short {
+					wantErr = io.ErrShortWrite
+				}
+				if !errors.Is(err, wantErr) {
+					t.Fatalf("wait error=%v want=%v", err, wantErr)
+				}
+				if loopErr := <-loopDone; !errors.Is(loopErr, wantErr) {
+					t.Fatalf("loop error=%v want=%v", loopErr, wantErr)
+				}
+				if got := commits.Load(); got != 1 {
+					t.Fatalf("commits=%d want=1", got)
+				}
+				conn.mu.Lock()
+				calls := conn.calls
+				conn.mu.Unlock()
+				if calls != failCall+1 {
+					t.Fatalf("physical writes=%d want=%d (no retry)", calls, failCall+1)
+				}
+			})
+		}
+	}
+}
+
+type diagnosticRefundGateConn struct {
+	started     chan struct{}
+	release     chan struct{}
+	releaseOnce sync.Once
+	mu          sync.Mutex
+	writes      [][]byte
+}
+
+func newDiagnosticRefundGateConn() *diagnosticRefundGateConn {
+	return &diagnosticRefundGateConn{started: make(chan struct{}), release: make(chan struct{})}
+}
+func (*diagnosticRefundGateConn) Read([]byte) (int, error) { return 0, io.EOF }
+func (*diagnosticRefundGateConn) Close() error             { return nil }
+func (c *diagnosticRefundGateConn) unblock() {
+	c.releaseOnce.Do(func() { close(c.release) })
+}
+func (c *diagnosticRefundGateConn) Write(p []byte) (int, error) {
+	c.mu.Lock()
+	first := len(c.writes) == 0
+	c.mu.Unlock()
+	if first {
+		close(c.started)
+		<-c.release
+	}
+	c.mu.Lock()
+	c.writes = append(c.writes, append([]byte(nil), p...))
+	c.mu.Unlock()
+	return len(p), nil
+}
+
+func TestDiagnosticAggregateRefundSelectedTimeoutRetainsBatch(t *testing.T) {
+	conn := newDiagnosticRefundGateConn()
+	session := newGatherSendSession(conn, 20*time.Millisecond)
+	go func() { _ = session.sendLoop() }()
+	t.Cleanup(func() {
+		conn.unblock()
+		select {
+		case <-session.shutdownCh:
+		default:
+			close(session.shutdownCh)
+		}
+		select {
+		case <-session.sendDoneCh:
+		case <-time.After(time.Second):
+			t.Error("send loop did not stop during cleanup")
+		}
+	})
+	batch := diagnosticRefundBatch(2)
+	want := append([]byte(nil), batch...)
+	var commits atomic.Int32
+	done := make(chan error, 1)
+	go func() {
+		done <- session.waitForAggregateControlBatchErrCommit(batch, make(chan error, 1), func() { commits.Add(1) })
+	}()
+	select {
+	case <-conn.started:
+	case <-time.After(time.Second):
+		t.Fatal("selected refund did not enter physical write")
+	}
+	select {
+	case err := <-done:
+		if !errors.Is(err, ErrConnectionWriteTimeout) {
+			t.Fatalf("wait error=%v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("selected refund did not time out")
+	}
+	conn.unblock()
+	deadline := time.After(time.Second)
+	for {
+		conn.mu.Lock()
+		got := bytes.Join(conn.writes, nil)
+		conn.mu.Unlock()
+		if len(got) == len(want) {
+			if !bytes.Equal(got, want) {
+				t.Fatalf("wire bytes=%x want=%x", got, want)
+			}
+			break
+		}
+		select {
+		case <-deadline:
+			t.Fatalf("wire bytes=%d want=%d", len(got), len(want))
+		case <-time.After(time.Millisecond):
+		}
+	}
+	if got := commits.Load(); got != 1 {
+		t.Fatalf("commits=%d want=1", got)
+	}
+}
+
+func TestDiagnosticAggregateRefundQueuedTimeoutCloseDoesNotCommit(t *testing.T) {
+	session := newGatherSendSession(newGatherRecordingConn(), 20*time.Millisecond)
+	var commits atomic.Int32
+	if err := session.waitForAggregateControlBatchErrCommit(diagnosticRefundBatch(2), make(chan error, 1), func() { commits.Add(1) }); !errors.Is(err, ErrConnectionWriteTimeout) {
+		t.Fatalf("wait error=%v", err)
+	}
+	close(session.shutdownCh)
+	go func() { _ = session.sendLoop() }()
+	select {
+	case <-session.sendDoneCh:
+	case <-time.After(time.Second):
+		t.Fatal("send loop did not observe close")
+	}
+	if got := commits.Load(); got != 0 {
+		t.Fatalf("queued closed commit=%d want=0", got)
+	}
+}
