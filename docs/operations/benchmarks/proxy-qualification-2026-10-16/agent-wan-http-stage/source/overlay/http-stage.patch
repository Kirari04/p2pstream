+type HTTPStageEndpoint struct {
+	mu       sync.Mutex
+	role     string
+	source   string
+	pool     *TransportCeilingLedger
+	working  *TransportCeilingLedger
+	initial  []TransportCeilingSocket
+	current  []TransportCeilingSocket
+	results  []HTTPStagePhaseResult
