diff --git a/third_party/yamux/refund_queue_ack_diagnostic_test.go b/third_party/yamux/refund_queue_ack_diagnostic_test.go
new file mode 100644
index 0000000..6401619
--- /dev/null
+++ b/third_party/yamux/refund_queue_ack_diagnostic_test.go
@@ -0,0 +1,385 @@
+package yamux
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func diagnosticQueueRefundBatch(streamHeaders int) header {
+	batch := header(make([]byte, (streamHeaders+1)*headerSize))
+	for i := 0; i < streamHeaders; i++ {
+		hdr := header(batch[i*headerSize : (i+1)*headerSize])
+		hdr.encode(typeAllocationWindowUpdate, 0, uint32(2*i+1), AggregateWindowUnitSize)
+	}
+	global := header(batch[streamHeaders*headerSize:])
+	global.encode(typeWindowUpdate, 0, 0, uint32(streamHeaders+1)*AggregateWindowUnitSize)
+	return batch
+}
+
+func diagnosticQueueRefundWriteCount(headerCount int) int {
+	if diagnosticSeparateAggregateRefundItems && headerCount > 1 {
+		return headerCount
+	}
+	return 1
+}
+
+func collectDiagnosticQueueRefundWrites(t *testing.T, writes [][]byte, offset, headerCount int) ([]byte, int) {
+	t.Helper()
+	count := diagnosticQueueRefundWriteCount(headerCount)
+	if offset+count > len(writes) {
+		t.Fatalf("writes[%d:] count=%d, only %d total", offset, count, len(writes))
+	}
+	var joined []byte
+	for _, write := range writes[offset : offset+count] {
+		joined = append(joined, write...)
+	}
+	return joined, offset + count
+}
+
+func TestDiagnosticAggregateRefundQueueOrderedWireAndSingleCommit(t *testing.T) {
+	for _, streamHeaders := range []int{0, 1, aggregateRefundBatchStreams} {
+		t.Run(fmt.Sprintf("headers_%d", streamHeaders+1), func(t *testing.T) {
+			batch := diagnosticQueueRefundBatch(streamHeaders)
+			if !isAggregateRefundHeaderBatch(batch) {
+				t.Fatal("valid aggregate refund batch was not classified")
+			}
+			conn := newGatherRecordingConn()
+			var commits atomic.Int32
+			var committed atomic.Bool
+			conn.committed = &committed
+			session := newGatherSendSession(conn, time.Second)
+			wantWrites := diagnosticQueueRefundWriteCount(streamHeaders + 1)
+			drained := make(chan struct{})
+			go func() {
+				for i := 0; i < wantWrites; i++ {
+					<-conn.wrote
+				}
+				close(drained)
+			}()
+			go func() { _ = session.sendLoop() }()
+			if err := session.waitForAggregateControlBatchErrCommit(batch, make(chan error, 1), func() {
+				commits.Add(1)
+				committed.Store(true)
+			}); err != nil {
+				t.Fatal(err)
+			}
+			stopGatherSendLoop(t, session)
+			select {
+			case <-drained:
+			case <-time.After(time.Second):
+				t.Fatal("did not observe every physical write")
+			}
+			if got := commits.Load(); got != 1 {
+				t.Fatalf("commits=%d want=1", got)
+			}
+			conn.mu.Lock()
+			writes := append([][]byte(nil), conn.writes...)
+			conn.mu.Unlock()
+			if got, want := len(writes), wantWrites; got != want {
+				t.Fatalf("physical writes=%d want=%d", got, want)
+			}
+			if got := bytes.Join(writes, nil); !bytes.Equal(got, batch) {
+				t.Fatalf("wire bytes=%x want=%x", got, batch)
+			}
+		})
+	}
+}
+
+func TestDiagnosticAggregateRefundQueueRejectsMalformedBatch(t *testing.T) {
+	session := newGatherSendSession(newGatherRecordingConn(), time.Second)
+	invalid := []header{
+		nil,
+		header(make([]byte, 2*headerSize-1)),
+		header(make([]byte, (aggregateRefundBatchStreams+2)*headerSize)),
+	}
+	unrelated := header(make([]byte, 2*headerSize))
+	header(unrelated[:headerSize]).encode(typePing, flagACK, 0, 1)
+	header(unrelated[headerSize:]).encode(typeWindowUpdate, 0, 0, AggregateWindowUnitSize)
+	invalid = append(invalid, unrelated)
+	for i, batch := range invalid {
+		if err := session.waitForAggregateControlBatchErrCommit(batch, make(chan error, 1), nil); err == nil {
+			t.Fatalf("invalid batch %d accepted", i)
+		}
+	}
+	if len(session.controlCh) != 0 {
+		t.Fatalf("invalid batch queued %d items", len(session.controlCh))
+	}
+}
+
+type diagnosticQueueFailureConn struct {
+	mu       sync.Mutex
+	failCall int
+	short    bool
+	err      error
+	calls    int
+	commits  *atomic.Int32
+}
+
+func (*diagnosticQueueFailureConn) Read([]byte) (int, error) { return 0, io.EOF }
+func (*diagnosticQueueFailureConn) Close() error             { return nil }
+func (c *diagnosticQueueFailureConn) Write(p []byte) (int, error) {
+	if c.commits.Load() != 1 {
+		return 0, errors.New("write did not observe exactly one joint commit")
+	}
+	c.mu.Lock()
+	call := c.calls
+	c.calls++
+	c.mu.Unlock()
+	if call != c.failCall {
+		return len(p), nil
+	}
+	if c.short {
+		return len(p) - 1, nil
+	}
+	return 0, c.err
+}
+
+func TestDiagnosticAggregateRefundQueueFailureHasNoRetry(t *testing.T) {
+	failCalls := []int{0}
+	if diagnosticSeparateAggregateRefundItems {
+		failCalls = []int{0, 1, 8, 16}
+	}
+	for _, short := range []bool{false, true} {
+		for _, failCall := range failCalls {
+			t.Run(fmt.Sprintf("short_%t_call_%d", short, failCall), func(t *testing.T) {
+				writeErr := errors.New("injected aggregate refund item failure")
+				var commits atomic.Int32
+				conn := &diagnosticQueueFailureConn{failCall: failCall, short: short, err: writeErr, commits: &commits}
+				session := newGatherSendSession(conn, time.Second)
+				loopDone := make(chan error, 1)
+				go func() { loopDone <- session.sendLoop() }()
+				err := session.waitForAggregateControlBatchErrCommit(diagnosticQueueRefundBatch(aggregateRefundBatchStreams), make(chan error, 1), func() { commits.Add(1) })
+				wantErr := writeErr
+				if short {
+					wantErr = io.ErrShortWrite
+				}
+				if !errors.Is(err, wantErr) {
+					t.Fatalf("wait error=%v want=%v", err, wantErr)
+				}
+				if loopErr := <-loopDone; !errors.Is(loopErr, wantErr) {
+					t.Fatalf("loop error=%v want=%v", loopErr, wantErr)
+				}
+				if got := commits.Load(); got != 1 {
+					t.Fatalf("commits=%d want=1", got)
+				}
+				conn.mu.Lock()
+				calls := conn.calls
+				conn.mu.Unlock()
+				if calls != failCall+1 {
+					t.Fatalf("physical writes=%d want=%d (no retry)", calls, failCall+1)
+				}
+			})
+		}
+	}
+}
+
+func newDiagnosticQueueOnlySession(timeout time.Duration, capacity int) *Session {
+	config := DefaultConfig()
+	config.ConnectionWriteTimeout = timeout
+	return &Session{config: config, controlCh: make(chan *sendReady, capacity), shutdownCh: make(chan struct{})}
+}
+
+func TestDiagnosticAggregateRefundQueueTimeoutBeforeFirstItem(t *testing.T) {
+	session := newDiagnosticQueueOnlySession(20*time.Millisecond, 1)
+	session.controlCh <- &sendReady{}
+	var commits atomic.Int32
+	err := session.waitForAggregateControlBatchErrCommit(diagnosticQueueRefundBatch(2), make(chan error, 1), func() { commits.Add(1) })
+	if !errors.Is(err, ErrConnectionWriteTimeout) || commits.Load() != 0 || len(session.controlCh) != 1 {
+		t.Fatalf("error=%v commits=%d queued=%d", err, commits.Load(), len(session.controlCh))
+	}
+}
+
+func TestDiagnosticAggregateRefundQueueTerminationPrecheck(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		prepare func(*Session, chan time.Time)
+		want    error
+	}{
+		{
+			name: "expired_deadline",
+			prepare: func(_ *Session, timeout chan time.Time) {
+				timeout <- time.Now()
+			},
+			want: ErrConnectionWriteTimeout,
+		},
+		{
+			name: "closed_session",
+			prepare: func(session *Session, _ chan time.Time) {
+				close(session.shutdownCh)
+			},
+			want: ErrSessionShutdown,
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			session := newDiagnosticQueueOnlySession(time.Second, 1)
+			// Keep the priority queue ready as well: termination must win before
+			// the caller can enqueue another committed refund item.
+			session.controlCh <- &sendReady{}
+			timeout := make(chan time.Time, 1)
+			test.prepare(session, timeout)
+			if err := session.aggregateControlBatchTermination(timeout); !errors.Is(err, test.want) {
+				t.Fatalf("termination=%v want=%v", err, test.want)
+			}
+		})
+	}
+}
+
+func TestDiagnosticAggregateRefundQueueClosedWithReadyQueueDoesNotCommit(t *testing.T) {
+	session := newDiagnosticQueueOnlySession(time.Second, 4)
+	close(session.shutdownCh)
+	var commits atomic.Int32
+	err := session.waitForAggregateControlBatchErrCommit(diagnosticQueueRefundBatch(2), make(chan error, 1), func() { commits.Add(1) })
+	if !errors.Is(err, ErrSessionShutdown) || commits.Load() != 0 || len(session.controlCh) != 0 {
+		t.Fatalf("error=%v commits=%d queued=%d", err, commits.Load(), len(session.controlCh))
+	}
+}
+
+func TestDiagnosticAggregateRefundQueueClosedAlongsideAckDoesNotAdvance(t *testing.T) {
+	if !diagnosticSeparateAggregateRefundItems {
+		t.Skip("control arm has one batch item")
+	}
+	session := newDiagnosticQueueOnlySession(time.Second, 4)
+	var commits atomic.Int32
+	done := make(chan error, 1)
+	go func() {
+		done <- session.waitForAggregateControlBatchErrCommit(diagnosticQueueRefundBatch(2), make(chan error, 1), func() { commits.Add(1) })
+	}()
+	first := <-session.controlCh
+	first.Commit()
+	// Both cases are ready before the publisher can advance. Regardless of
+	// which arm its acknowledgement select chooses, the post-ack termination
+	// precheck prevents a second queue item.
+	first.Err <- nil
+	close(session.shutdownCh)
+	if err := <-done; !errors.Is(err, ErrSessionShutdown) {
+		t.Fatalf("error=%v", err)
+	}
+	if got := len(session.controlCh); got != 0 {
+		t.Fatalf("queued items after shutdown=%d want=0", got)
+	}
+	if got := commits.Load(); got != 1 {
+		t.Fatalf("commits=%d want=1", got)
+	}
+}
+
+func TestDiagnosticAggregateRefundQueueTimeoutAfterFirstSelected(t *testing.T) {
+	session := newDiagnosticQueueOnlySession(20*time.Millisecond, 1)
+	var commits atomic.Int32
+	done := make(chan error, 1)
+	go func() {
+		done <- session.waitForAggregateControlBatchErrCommit(diagnosticQueueRefundBatch(2), make(chan error, 1), func() { commits.Add(1) })
+	}()
+	ready := <-session.controlCh
+	if ready.Commit != nil {
+		ready.Commit()
+	}
+	if err := <-done; !errors.Is(err, ErrConnectionWriteTimeout) {
+		t.Fatalf("error=%v", err)
+	}
+	if got := commits.Load(); got != 1 {
+		t.Fatalf("commits=%d want=1", got)
+	}
+}
+
+func TestDiagnosticAggregateRefundQueueLaterItemTimeoutAndClose(t *testing.T) {
+	if !diagnosticSeparateAggregateRefundItems {
+		t.Skip("control arm has one batch item")
+	}
+	for _, closeSession := range []bool{false, true} {
+		t.Run(fmt.Sprintf("close_%t", closeSession), func(t *testing.T) {
+			session := newDiagnosticQueueOnlySession(40*time.Millisecond, 1)
+			var commits atomic.Int32
+			done := make(chan error, 1)
+			go func() {
+				done <- session.waitForAggregateControlBatchErrCommit(diagnosticQueueRefundBatch(2), make(chan error, 1), func() { commits.Add(1) })
+			}()
+			first := <-session.controlCh
+			if first.Commit == nil {
+				t.Fatal("first item omitted joint commit")
+			}
+			first.Commit()
+			first.Err <- nil
+			deadline := time.Now().Add(time.Second)
+			for len(session.controlCh) == 0 && time.Now().Before(deadline) {
+				time.Sleep(time.Millisecond)
+			}
+			if len(session.controlCh) != 1 {
+				t.Fatal("later item was not queued")
+			}
+			if closeSession {
+				close(session.shutdownCh)
+			}
+			err := <-done
+			if closeSession {
+				if !errors.Is(err, ErrSessionShutdown) {
+					t.Fatalf("error=%v", err)
+				}
+			} else if !errors.Is(err, ErrConnectionWriteTimeout) {
+				t.Fatalf("error=%v", err)
+			}
+			later := <-session.controlCh
+			if later.Commit != nil || commits.Load() != 1 {
+				t.Fatalf("later commit=%v commits=%d", later.Commit != nil, commits.Load())
+			}
+		})
+	}
+}
+
+func TestDiagnosticAggregateRefundQueueUsesOneBatchDeadline(t *testing.T) {
+	if !diagnosticSeparateAggregateRefundItems {
+		t.Skip("control arm has one batch item")
+	}
+	const timeout = 400 * time.Millisecond
+	session := newDiagnosticQueueOnlySession(timeout, 1)
+	done := make(chan error, 1)
+	start := time.Now()
+	go func() {
+		done <- session.waitForAggregateControlBatchErrCommit(diagnosticQueueRefundBatch(2), make(chan error, 1), func() {})
+	}()
+	first := <-session.controlCh
+	if first.Commit != nil {
+		first.Commit()
+	}
+	time.Sleep(250 * time.Millisecond)
+	first.Err <- nil
+	<-session.controlCh // Select the second item but never acknowledge it.
+	if err := <-done; !errors.Is(err, ErrConnectionWriteTimeout) {
+		t.Fatalf("error=%v", err)
+	}
+	if elapsed := time.Since(start); elapsed >= 550*time.Millisecond {
+		t.Fatalf("batch deadline multiplied across items: %v", elapsed)
+	}
+}
+
+func TestDiagnosticAggregateRefundQueueWaitDoesNotBlockReaderControl(t *testing.T) {
+	if !diagnosticSeparateAggregateRefundItems {
+		t.Skip("control arm has one batch item")
+	}
+	session := newDiagnosticQueueOnlySession(time.Second, 4)
+	done := make(chan error, 1)
+	go func() {
+		done <- session.waitForAggregateControlBatchErrCommit(diagnosticQueueRefundBatch(2), make(chan error, 1), func() {})
+	}()
+	first := <-session.controlCh // Publisher is now waiting for its ack.
+	readerControl := header(make([]byte, headerSize))
+	readerControl.encode(typePing, flagACK, 0, 7)
+	if err := session.sendAggregateControlNoWait(readerControl); err != nil {
+		t.Fatalf("reader control enqueue: %v", err)
+	}
+	if len(session.controlCh) != 1 {
+		t.Fatalf("reader control queue depth=%d want=1", len(session.controlCh))
+	}
+	close(session.shutdownCh)
+	if err := <-done; !errors.Is(err, ErrSessionShutdown) {
+		t.Fatalf("publisher error=%v", err)
+	}
+	if first.Commit == nil {
+		t.Fatal("selected first item omitted joint commit")
+	}
+}
diff --git a/third_party/yamux/session.go b/third_party/yamux/session.go
index b3f1b0c..9e13b1b 100644
--- a/third_party/yamux/session.go
+++ b/third_party/yamux/session.go
@@ -26,6 +26,10 @@ var (
 	errAggregateControlBacklog = fmt.Errorf("aggregate control backlog exceeded")
 )
 
+// diagnosticSeparateAggregateRefundItems is changed only in the causal
+// diagnostic arm. Both arms retain this scaffold and the same sendReady layout.
+var diagnosticSeparateAggregateRefundItems = false
+
 // Session is used to wrap a reliable ordered connection and to
 // multiplex it into multiple streams.
 type Session struct {
@@ -474,11 +478,103 @@ func (s *Session) waitForSendErrCommit(hdr header, body []byte, errCh chan error
 	return s.waitForSendErrCommitOn(queue, hdr, body, errCh, commit)
 }
 
-// waitForAggregateControlBatchErrCommit writes a bounded sequence of ordinary
-// allocation refunds followed by their summed session refund as one priority
-// queue item and one physical write.
+// waitForAggregateControlBatchErrCommit publishes a bounded sequence of
+// ordinary allocation refunds followed by their summed session refund. Both
+// diagnostic arms share one deadline and one joint pre-wire commit. The causal
+// arm waits for an acknowledgement after every 12-byte priority item; the
+// control arm keeps the current single-item batch.
 func (s *Session) waitForAggregateControlBatchErrCommit(batch header, errCh chan error, commit func()) error {
-	return s.waitForSendErrCommitOn(s.controlCh, batch, nil, errCh, commit)
+	t := timerPool.Get()
+	timer := t.(*time.Timer)
+	timer.Reset(s.config.ConnectionWriteTimeout)
+	defer func() {
+		timer.Stop()
+		select {
+		case <-timer.C:
+		default:
+		}
+		timerPool.Put(t)
+	}()
+	if !isAggregateRefundHeaderBatch(batch) {
+		return fmt.Errorf("yamux: invalid aggregate refund header batch")
+	}
+
+	stride := len(batch)
+	if diagnosticSeparateAggregateRefundItems && len(batch) > headerSize {
+		stride = headerSize
+	}
+	for offset := 0; offset < len(batch); offset += stride {
+		if err := s.aggregateControlBatchTermination(timer.C); err != nil {
+			return err
+		}
+		end := offset + stride
+		if end > len(batch) {
+			end = len(batch)
+		}
+		ready := &sendReady{Hdr: batch[offset:end], Err: errCh}
+		if offset == 0 {
+			ready.Commit = commit
+		}
+		select {
+		case s.controlCh <- ready:
+		case <-s.shutdownCh:
+			return ErrSessionShutdown
+		case <-timer.C:
+			return ErrConnectionWriteTimeout
+		}
+		select {
+		case err := <-errCh:
+			if err != nil {
+				return err
+			}
+		case <-s.shutdownCh:
+			return ErrSessionShutdown
+		case <-timer.C:
+			return ErrConnectionWriteTimeout
+		}
+		// Do not let a simultaneously ready acknowledgement win repeatedly over
+		// a completed batch deadline or shutdown. One enqueue can unavoidably
+		// cross a termination that occurs after its precheck, matching the
+		// existing single-item send semantics; no subsequent item may do so.
+		if err := s.aggregateControlBatchTermination(timer.C); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (s *Session) aggregateControlBatchTermination(timeout <-chan time.Time) error {
+	select {
+	case <-s.shutdownCh:
+		return ErrSessionShutdown
+	default:
+	}
+	select {
+	case <-timeout:
+		return ErrConnectionWriteTimeout
+	default:
+		return nil
+	}
+}
+
+func isAggregateRefundHeaderBatch(batch header) bool {
+	if len(batch) < headerSize || len(batch)%headerSize != 0 || len(batch) > (aggregateRefundBatchStreams+1)*headerSize {
+		return false
+	}
+	headerCount := len(batch) / headerSize
+	lastID := uint32(0)
+	for i := 0; i < headerCount-1; i++ {
+		hdr := header(batch[i*headerSize : (i+1)*headerSize])
+		if hdr.MsgType() != typeAllocationWindowUpdate || hdr.Flags() != 0 || hdr.StreamID() == 0 || hdr.Length() == 0 || hdr.Length()%AggregateWindowUnitSize != 0 {
+			return false
+		}
+		if i > 0 && hdr.StreamID() <= lastID {
+			return false
+		}
+		lastID = hdr.StreamID()
+	}
+	global := header(batch[(headerCount-1)*headerSize:])
+	return global.MsgType() == typeWindowUpdate && global.Flags() == 0 && global.StreamID() == 0 && global.Length() != 0 && global.Length()%AggregateWindowUnitSize == 0
 }
 
 func (s *Session) waitForSendErrCommitOn(queue chan *sendReady, hdr header, body []byte, errCh chan error, commit func()) error {
